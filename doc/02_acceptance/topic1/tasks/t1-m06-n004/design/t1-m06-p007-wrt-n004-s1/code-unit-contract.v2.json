        }
      ],
      "inputs": [
        {
          "name": "ctx",
          "type": "context.Context",
          "unit_or_format": "Go cancellation/deadline context",
          "range": "non-nil and request scoped",
          "identity_semantics": "承载同一次受理意图的deadline与trace，不提供tenant真源",
          "ownership": "borrowed; function does not retain",
          "secret_classification": "INTERNAL"
        },
        {
          "name": "rec",
          "type": "*config.AssetRecord",
          "unit_or_format": "tenant-scoped canonical asset candidate",
          "range": "TenantID and normalized MAC required; revision recomputed in transaction",
          "identity_semantics": "tenant_id+mac_address定义资产identity；asset_id仅作兼容/冲突检查",
          "ownership": "input is copied before mutation; caller-owned object must not observe partial transaction state",
          "secret_classification": "SENSITIVE"
        },
        {
          "name": "command",
          "type": "config.AssetUpsertCommand",
          "unit_or_format": "versioned logical submission intent",
          "range": "idempotency key, actor and trace non-empty; expected revision non-negative",
          "identity_semantics": "tenant+idempotency_key+canonical request hash identifies one intent",
          "ownership": "value copy",
          "secret_classification": "SENSITIVE"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": "*config.AssetUpsertResult",
          "unit_or_format": "typed authoritative transaction receipt",
          "range": "asset_id, created, revision, event_id, outbox_id and trace_id bound to one commit",
          "identity_semantics": "same tenant/key/hash/actor returns the stored result with IdempotentReplay=true",
          "ownership": "newly allocated result owned by caller",
          "secret_classification": "INTERNAL"
        },
        {
          "name": "err",
          "type": "error",
          "unit_or_format": "stable sentinel or wrapped internal cause",
          "range": "nil, revision conflict, idempotency conflict, or typed internal failure",
          "identity_semantics": "commit unknown is not equivalent to authoritative failure",
          "ownership": "immutable error chain",
          "secret_classification": "INTERNAL"
        }
      ],
      "preconditions": [
        "service层已校验authenticated actor、tenant、action、reason、trace、idempotency key及MAC",
        "rec.TenantID只能来自认证上下文与已比较的请求路径，不能信任冲突body值",
        "schema迁移已提供assets、asset_events、audit_logs、asset_event_outbox、asset_upsert_requests和约束索引",
        "本函数不接收可由调用方替换的Topic或event type"
      ],
      "postconditions": [
        "成功时五类权威/审计/投递/回执副作用在同一PostgreSQL commit中可见",
        "commit前任何失败均不留下五类副作用的子集",
      "same key+same canonical payload+same actor返回原result且不新增实体/history/audit/outbox/ledger；replay成功与新提交成功是不同结果分支",
        "same key+different payload或actor返回ErrAssetIdempotencyConflict",
        "stale expected revision返回ErrAssetRevisionConflict且不覆盖新版本",
        "outbox event type固定traffic.asset.v2.AssetUpserted，状态仅为pending，由dispatcher在broker ACK后推进"
      ],
      "pattern_roles": [],
      "body_steps": [
        {
          "step_id": "B01",
          "op": "normalize",
          "guard": "always before transaction",
          "reads": ["command.ActionID", "command.Reason", "rec"],
          "writes": ["actionID", "reason", "requestAsset copy"],
          "invokes": [],
          "invariant_before": ["rec non-nil and service-level validation are caller preconditions; current repository implementation would panic on nil and this PR does not move the validation boundary"],
          "invariant_after": ["defaults are explicit and requestAsset excludes server-owned revision/seen timestamps", "repository makes a shallow working copy before changing revision or timestamps"],
          "error_ids": [],
          "cancel_point": "BEFORE",
          "oracle_ids": ["O-INPUT-COPY", "O-DEFAULTS"]
        },
        {
          "step_id": "B02",
          "op": "normalize",
          "guard": "B01 complete",
          "reads": ["tenant", "action", "expected revision", "actor", "reason", "history type", "observed_at", "requestAsset"],
          "writes": ["canonical identity bytes", "requestHash"],
          "invokes": ["json.Marshal", "sha256.Sum256", "hex.EncodeToString"],
          "invariant_before": ["server-owned revision and first/last seen are excluded from intent hash"],
          "invariant_after": ["same logical input under v1 encoding yields identical SHA-256"],
          "error_ids": ["ERR-IDENTITY-MARSHAL"],
          "cancel_point": "BEFORE",
          "oracle_ids": ["O-HASH-DETERMINISTIC", "O-HASH-COMPATIBILITY"]
        },
        {
          "step_id": "B03",
          "op": "write",
          "guard": "identity hash constructed",
          "reads": ["ctx", "PostgreSQL connection"],
          "writes": ["ReadCommitted transaction"],
          "invokes": ["sql.DB.BeginTx", "sql.Tx.Rollback deferred"],
          "invariant_before": ["no durable effect has occurred"],
          "invariant_after": ["all subsequent durable writes share one transaction handle"],
          "error_ids": ["ERR-BEGIN-TX"],
          "cancel_point": "DURING_IO",
          "oracle_ids": ["O-BEGIN-FAIL-NO-EFFECT"]
        },
        {
          "step_id": "B04",
          "op": "lock",
          "guard": "transaction active",
          "reads": ["tenant_id", "idempotency_key"],
          "writes": ["transaction-scoped idempotency advisory lock"],
          "invokes": ["pg_advisory_xact_lock(hashtextextended(identity,0))"],
          "invariant_before": ["concurrent deliveries may race only before this lock"],
          "invariant_after": ["one tenant+key ledger decision is serialized"],
          "error_ids": ["ERR-IDEMPOTENCY-LOCK"],
          "cancel_point": "DURING_IO",
          "oracle_ids": ["O-IDEMPOTENCY-SERIALIZATION"]
        },
        {
          "step_id": "B05",
          "op": "read",
          "guard": "idempotency lock held",
          "reads": ["asset_upsert_requests tenant_id+idempotency_key FOR UPDATE"],
          "writes": ["prior result or miss"],
          "invokes": ["sql.Tx.QueryRowContext", "sql.Row.Scan"],
          "invariant_before": ["no second decision for the same tenant+key can pass B04"],
          "invariant_after": ["exact replay is separated from payload/actor conflict and first execution"],
          "error_ids": ["ERR-IDEMPOTENCY-CONFLICT", "ERR-LEDGER-READ", "ERR-REPLAY-COMMIT-UNKNOWN"],
          "cancel_point": "COMMIT_UNKNOWN",
          "oracle_ids": ["O-REPLAY", "O-IDEMPOTENCY-CONFLICT", "O-REPLAY-NO-DUPLICATE"]
        },
        {
          "step_id": "B06",
          "op": "lock",
          "guard": "ledger miss",
          "reads": ["tenant_id", "canonical MAC"],
          "writes": ["transaction-scoped asset identity advisory lock"],
          "invokes": ["pg_advisory_xact_lock(hashtextextended(identity,0))"],
          "invariant_before": ["first logical execution has no ledger row"],
          "invariant_after": ["create/update decision for tenant+MAC is serialized"],
          "error_ids": ["ERR-ASSET-LOCK"],
          "cancel_point": "DURING_IO",
          "oracle_ids": ["O-ASSET-IDENTITY-SERIALIZATION"]
        },
        {
          "step_id": "B07",
          "op": "read",
          "guard": "asset identity lock held",
          "reads": ["assets by tenant_id+mac_address FOR UPDATE"],
          "writes": ["existing asset snapshot or create miss"],
          "invokes": ["LOC-T1-M06-CALLEE-findAssetByMACTx"],
          "invariant_before": ["tenant+MAC lock remains held"],
          "invariant_after": ["state transition is based on a locked current authority row"],
          "error_ids": ["ERR-ASSET-READ"],
          "cancel_point": "DURING_IO",
          "oracle_ids": ["O-TENANT-READ", "O-CURRENT-REVISION"]
        },
        {
          "step_id": "B08",
          "op": "decide",
          "guard": "current snapshot known",
          "reads": ["existing", "rec", "command.ExpectedRevision", "command.ResolveCurrentRevision", "command.ActionID", "command.ObservedAt"],
          "writes": ["create/update branch", "effectiveExpectedRevision", "next asset", "event identity"],
          "invokes": ["LOC-T1-M06-CALLEE-ensureAssetDefaults", "uuid.NewSHA1", "uuid.NewString"],
          "invariant_before": ["only manual action may change governance fields", "observation is non-authoritative for governance"],
          "invariant_after": ["stale revision and asset identity conflict are rejected", "older observation cannot reduce LastSeen"],
          "error_ids": ["ERR-REVISION-CONFLICT", "ERR-IDEMPOTENCY-CONFLICT"],
          "cancel_point": "NONE",
          "oracle_ids": ["O-CREATE-DECISION", "O-UPDATE-DECISION", "O-SOURCE-PRECEDENCE", "O-OLD-OBSERVATION"]
        },
        {
          "step_id": "B09",
          "op": "write",
          "guard": "transition decision accepted",
          "reads": ["next asset", "effectiveExpectedRevision"],
          "writes": ["assets row INSERT or revision CAS UPDATE"],
          "invokes": ["encoding/json.Marshal", "sql.Tx.QueryRowContext", "sql.Row.Scan"],
          "invariant_before": ["history, audit, outbox and ledger are not yet written"],
          "invariant_after": ["next revision is materialized in current transaction only"],
          "error_ids": ["ERR-REVISION-CONFLICT", "ERR-ASSET-WRITE"],
          "cancel_point": "DURING_IO",
          "oracle_ids": ["O-CAS", "O-ASSET-WRITE-ROLLBACK"]
        },
        {
          "step_id": "B10",
          "op": "normalize",
          "guard": "authority row write succeeded",
          "reads": ["previous snapshot", "next asset"],
          "writes": ["oldJSON", "newJSON"],
          "invokes": ["json.Marshal"],
          "invariant_before": ["before-state对existing的json.Marshal错误被丢弃；after-state必须显式处理并在失败时回滚authority row"],
          "invariant_after": ["oldJSON和newJSON均显式检查错误；任一编码失败由当前P007在B10回滚B09，不依赖后续叶"],
          "error_ids": ["ERR-HISTORY-MARSHAL"],
          "cancel_point": "NONE",
          "oracle_ids": ["O-HISTORY-BYTES", "O-ASSET-WRITE-ROLLBACK"]
        },
        {
          "step_id": "B11",
          "op": "write",
          "guard": "history payload serialized",
          "reads": ["event_id", "asset_id", "tenant_id", "event_type", "revision", "oldJSON", "newJSON"],
          "writes": ["asset_events row"],
          "invokes": ["LOC-T1-M06-CALLEE-jsonBytesOrNil", "sql.Tx.ExecContext"],
          "invariant_before": ["history and authority row share transaction"],
          "invariant_after": ["immutable transition fact exists if and only if transaction commits"],
          "error_ids": ["ERR-HISTORY-WRITE"],
          "cancel_point": "DURING_IO",
          "oracle_ids": ["O-HISTORY-ROLLBACK", "O-HISTORY-EXACTLY-ONCE"]
        },
        {
          "step_id": "B12",
          "op": "write",
          "guard": "history write succeeded",
          "reads": ["actor", "action_id", "reason", "request_id", "trace_id", "event_id", "result revision"],
          "writes": ["audit_logs accepted row"],
          "invokes": ["json.Marshal", "sql.Tx.ExecContext"],
          "invariant_before": ["audit detail must not expose raw secrets", "before-state丢弃auditDetail json.Marshal错误"],
          "invariant_after": ["after-state检查audit detail编码错误并在失败时回滚；成功insert与同一事务绑定"],
          "error_ids": ["ERR-AUDIT-MARSHAL", "ERR-AUDIT-WRITE"],
          "cancel_point": "DURING_IO",
          "oracle_ids": ["O-AUDIT-ROLLBACK", "O-AUDIT-EXACTLY-ONCE"]
        },
        {
          "step_id": "B13",
