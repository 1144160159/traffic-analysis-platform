  "design_system": {
    "tokens_source": "web/ui/src/styles/tokens.css",
    "required_tokens": [
      "--ui-bg-page",
      "--ui-bg-panel",
      "--ui-border-subtle",
      "--ui-text-primary",
      "--ui-text-secondary",
      "--ui-info",
      "--ui-success",
      "--ui-warning",
      "--ui-danger",
