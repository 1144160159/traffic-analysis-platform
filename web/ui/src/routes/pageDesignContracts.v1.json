      "--ui-space-4",
      "--ui-radius-control",
      "--shell-topbar",
      "--shell-sidebar",
      "--shell-bottombar"
    ],
    "component_library": "Ant Design 5 plus repository-native components"
  },
  "candidate_binding": {
    "required": true,
    "manifest_path": "doc/02_acceptance/runs/20260805-ui-page-design-contract-v5/candidate-manifest.json",
    "required_hashes": [
      "contract_sha256",
      "route_manifest_sha256",
      "page_api_plans_sha256",
      "tokens_sha256",
      "capture_plan_sha256",
      "dist_sha256",
      "image_id",
      "image_manifest_digest"
    ]
  },
  "shared_rules": {
    "must_preserve": [
      "AppShell navigation hierarchy and protected-route behavior",
      "registered route, query, detail and Tab compatibility",
      "permission entry points and required scope semantics",
      "data plus meta plus error response semantics",
      "accepted, running and terminal asynchronous states remain distinct",
      "Windows Chrome 1920x1080 baseline before additional responsive viewports"
    ],
    "prohibited": [
      "fixed or randomly generated business facts in production",
      "frontend-derived authoritative entities, topology or risk scores",
      "HTTP 2xx or screenshot-only success claims",
      "client JSON downloads labeled as server evidence or audit exports",
      "mock activation in a production bundle",
      "whole-page bitmap overlays",
      "silent removal of routes, Tabs, controls, scopes, APIs or audit events",
      "unexplained disabled controls or missing sections"
    ],
    "required_states": [
      "loading",
      "zero",
      "empty",
      "partial",
      "stale",
      "forbidden",
      "error",
      "accepted",
      "running",
      "succeeded",
      "failed",
      "cancelled",
      "compensated"
    ],
    "reviewer": "QA-UI-INDEPENDENT"
  },
