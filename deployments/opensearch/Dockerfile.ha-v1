FROM docker.io/opensearchproject/opensearch@sha256:466a49f379bb8889af29d615475e69b7b990898c6987d28470cd7105df9046ff

# Snapshot credentials are never baked into this image. They must be injected
# into the OpenSearch keystore from an approved external Secret at rollout.
RUN /usr/share/opensearch/bin/opensearch-plugin install --batch repository-s3
