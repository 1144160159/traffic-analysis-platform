ARG BASE_IMAGE=traffic/mlops-trainer:mlops-r331-20260719
FROM ${BASE_IMAGE}

ARG SOURCE_REVISION=unknown
ARG BUILD_ID=local
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      org.opencontainers.image.version=${BUILD_ID} \
      org.opencontainers.image.title="MLOps Trainer"

RUN python -m pip install --no-cache-dir \
      numpy==1.26.3 \
      scikit-learn==1.4.0 \
      joblib==1.3.2 \
      onnx==1.22.0 \
      onnxmltools==1.16.0 \
      onnxconverter-common==1.16.0 \
      onnxruntime==1.23.2 \
      skl2onnx==1.20.0 \
      cryptography==46.0.7

COPY scripts/extract_data.py /app/scripts/extract_data.py
COPY scripts/dataset_governance.py /app/scripts/dataset_governance.py
COPY scripts/graph_governance.py /app/scripts/graph_governance.py
COPY scripts/train_model.py /app/scripts/train_model.py
COPY scripts/gnn_training.py /app/scripts/gnn_training.py
COPY scripts/evaluate_model.py /app/scripts/evaluate_model.py
COPY scripts/governed_evaluation.py /app/scripts/governed_evaluation.py
COPY scripts/explain_model.py /app/scripts/explain_model.py
COPY scripts/governed_explanation.py /app/scripts/governed_explanation.py
COPY scripts/model_artifact_governance.py /app/scripts/model_artifact_governance.py
COPY scripts/export_onnx.py /app/scripts/export_onnx.py
COPY scripts/register_model.py /app/scripts/register_model.py
COPY scripts/m08_governed_canary.py /app/scripts/m08_governed_canary.py
