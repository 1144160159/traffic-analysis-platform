FROM golang:1.25.12-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /workspace
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /alert-service ./cmd/alert-service

FROM alpine:3.19
RUN apk --no-cache add ca-certificates tzdata
COPY --from=builder /alert-service /usr/local/bin/

RUN adduser -D -u 1000 appuser
USER appuser

EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/alert-service"]
