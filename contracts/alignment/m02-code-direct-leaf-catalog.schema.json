{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-code-direct-leaf-catalog.schema.json",
  "title": "M02 code-direct leaf and mixed-DAG design catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "source_document",
    "source_document_sha256", "id_epoch", "leaf_count", "type_counts",
    "parent_counts", "leaves", "parent_dependency_summary", "cross_leaf_edges",
    "external_activities", "validation", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_CODE_DIRECT_LEAF_CATALOG"},
    "artifact_status": {"const": "DESIGN_LEAF_ID_FROZEN_NOT_GLOBAL_REGISTRY"},
    "source_document": {"const": "doc/07_alignment/课题一PR里程碑代码级详细设计.md"},
    "source_document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id_epoch": {"const": "T1-M02-P101-P307"},
    "leaf_count": {"const": 207},
    "type_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0},
      "required": ["CTR", "EXP", "PRJ", "WRT", "REF", "OPS", "TST-PRE", "TST-POST", "IDX", "PROM"]
    },
    "parent_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "leaves": {
      "type": "array",
      "minItems": 207,
      "maxItems": 207,
      "items": {"$ref": "#/$defs/leaf"}
    },
    "parent_dependency_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "pattern": "^T1-M(?:01|02)-N[0-9]{3}$"},
        "uniqueItems": true
      }
    },
    "cross_leaf_edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "external_activities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/external_activity"}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure", "mixed_dag", "unique_leaf_ids", "unique_atomic_pr_ids",
        "terminal_task_idx_exact_set", "type_count_exact_set", "unresolved_dependency_text_count"
      ],
      "properties": {
        "structure": {"const": "PASS"},
        "mixed_dag": {"const": "PASS"},
        "unique_leaf_ids": {"const": true},
        "unique_atomic_pr_ids": {"const": true},
        "terminal_task_idx_exact_set": {"const": true},
        "type_count_exact_set": {"const": true},
        "unresolved_dependency_text_count": {"type": "integer", "minimum": 0}
      }
    },
    "proof_ceiling": {
      "const": "M02_LEAF_ID_AND_DESIGN_DAG_ONLY_NOT_TARGET_BINDING_FUNCTION_REVIEW_EXECUTION_OR_ACCEPTANCE"
    }
  },
  "$defs": {
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaf_id", "atomic_pr_id", "parent_task_id", "leaf_number", "pr_type",
        "phase", "write_locators", "target_state", "prerequisites_raw",
        "single_outcome", "oracle_and_rollback", "depends_on_leaf_ids",
        "depends_on_external_activities", "terminal_task_idx", "formal_execution_status",
        "allowed_claim", "forbidden_claims"
      ],
      "properties": {
        "leaf_id": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2}$"},
        "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P[1-3][0-9]{2}-[A-Z-]+-n[0-9]{3}-l[0-9]{2}$"},
        "parent_task_id": {"type": "string", "pattern": "^T1-M02-N[0-9]{3}$"},
        "leaf_number": {"type": "integer", "minimum": 1},
        "pr_type": {"enum": ["CTR", "EXP", "PRJ", "WRT", "REF", "OPS", "TST-PRE", "TST-POST", "IDX", "PROM"]},
        "phase": {"type": "string", "pattern": "^m02-n[0-9]{3}-l[0-9]{2}$"},
        "write_locators": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "target_state": {"enum": ["EXISTING", "PLANNED", "PLANNED_OUTPUT"]},
        "prerequisites_raw": {"type": "string", "minLength": 1},
        "single_outcome": {"type": "string", "minLength": 3},
        "oracle_and_rollback": {"type": "string", "minLength": 3},
        "depends_on_leaf_ids": {"type": "array", "items": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2}$"}, "uniqueItems": true},
        "depends_on_external_activities": {"type": "array", "items": {"type": "string", "pattern": "^EXT-T1-M02-N[0-9]{3}-[A-Z-]+$"}, "uniqueItems": true},
        "terminal_task_idx": {"type": "boolean"},
        "formal_execution_status": {"const": "BLOCKED_UNTIL_GLOBAL_REGISTRY_TARGET_BINDING_FUNCTION_REVIEW_AND_SIGNED_OVERLAY"},
        "allowed_claim": {"const": "M02 design leaf identity and dependency intent are frozen"},
        "forbidden_claims": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "string", "minLength": 3},
          "uniqueItems": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason"],
      "properties": {
        "from": {"type": "string", "pattern": "^(?:M02-N[0-9]{3}-L[0-9]{2}|EXT-T1-M02-N[0-9]{3}-[A-Z-]+)$"},
        "to": {"type": "string", "pattern": "^(?:M02-N[0-9]{3}-L[0-9]{2}|EXT-T1-M02-N[0-9]{3}-[A-Z-]+)$"},
        "reason": {"type": "string", "minLength": 8}
      }
    },
    "external_activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id", "parent_task_id", "activity_type", "status",
        "mutable_by_repository_authors", "depends_on_leaf_ids", "successor_leaf_ids",
        "proof_ceiling"
      ],
      "properties": {
        "activity_id": {"type": "string", "pattern": "^EXT-T1-M02-N[0-9]{3}-[A-Z-]+$"},
        "parent_task_id": {"type": "string", "pattern": "^T1-M02-N[0-9]{3}$"},
        "activity_type": {"enum": ["SCOPED_CANARY", "PROFILE_APPROVAL", "PROTECTED_MERGE"]},
        "status": {"const": "BLOCKED_CONTRACT_NOT_YET_IN_GLOBAL_REGISTRY"},
        "mutable_by_repository_authors": {"const": false},
        "depends_on_leaf_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2}$"}, "uniqueItems": true},
        "successor_leaf_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2}$"}, "uniqueItems": true},
        "proof_ceiling": {"const": "DESIGN_ACTIVITY_NODE_ONLY_NOT_EXTERNAL_EXECUTION_OR_RECEIPT"}
      }
    }
  }
}
