{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic.local/contracts/alignment/exact-go-test-result.schema.json",
  "title": "Candidate-bound exact Go test result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "artifact_kind", "subject_pr_id", "run_id", "status", "candidate_manifest",
    "profile_id", "environment_id", "source_blob_sha256", "expected_tests",
    "go_test_exit_code", "errors", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "EXACT_GO_TEST_RESULT"},
    "subject_pr_id": {"type": "string", "pattern": "^T1-M[0-9]{2}-P[0-9]{3}-TST-(?:PRE|POST)-"},
    "run_id": {"type": "string", "minLength": 3},
    "status": {"const": "PASS"},
    "candidate_manifest": {"$ref": "#/$defs/hash_ref"},
    "profile_id": {"type": "string", "minLength": 3},
    "environment_id": {"type": "string", "minLength": 3},
    "source_blob_sha256": {"type": "object"},
    "expected_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "go_test_exit_code": {"const": 0},
    "errors": {"type": "array", "maxItems": 0},
    "proof_ceiling": {"const": "EXACT_GO_TEST_ONLY_NOT_RUNTIME_OR_PRODUCTION_ACCEPTANCE"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
