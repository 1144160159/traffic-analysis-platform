{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/canonical-pr-target-binding.schema.json",
  "title": "Reviewable code-target binding for one atomic PR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "binding_status", "source_task_registry_sha256",
    "atomic_pr_id", "parent_work_id", "pr_type", "candidate_commit",
    "owner", "reviewers", "approvers", "single_outcome", "write_targets",
    "read_context_paths", "verification_checks", "rollback", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "binding_status": {"enum": ["DRAFT", "REVIEWABLE", "APPROVED"]},
    "source_task_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "atomic_pr_id": {"type": "string", "minLength": 1},
    "parent_work_id": {"type": "string", "minLength": 1},
    "pr_type": {"enum": ["CTR", "EXP", "PRJ", "WRT", "UI", "OPS", "REF", "TST-PRE", "TST-POST", "IDX", "PROM"]},
    "candidate_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "owner": {"type": ["string", "null"]},
    "reviewers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "approvers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "single_outcome": {"$ref": "#/$defs/outcome"},
    "write_targets": {"type": "array", "items": {"$ref": "#/$defs/target"}, "uniqueItems": true},
    "read_context_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "verification_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}, "uniqueItems": true},
    "rollback": {"$ref": "#/$defs/rollback"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "$defs": {
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["result_id", "subject", "state_change", "acceptance_oracle"],
      "properties": {
        "result_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "state_change": {"type": "string", "minLength": 1},
        "acceptance_oracle": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": [
        "path", "target_state", "candidate_surface_relation", "surface_kind", "locator_kind", "symbol_or_pointer",
        "expected_signature", "compatibility_entrypoint", "activation_guard", "selection_reason"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "target_state": {"enum": ["EXISTING", "PLANNED"]},
        "candidate_surface_relation": {"enum": ["EXISTING_MEMBER", "PROPOSED_EXTENSION"]},
        "surface_kind": {"enum": ["SOURCE", "CONTRACT", "MIGRATION", "DEPLOYMENT", "TEST", "TEST_TOOL", "EVIDENCE"]},
        "locator_kind": {"enum": ["go_symbol", "rust_symbol", "java_symbol", "ts_symbol", "python_symbol", "proto_fqn", "sql_object", "json_pointer", "yaml_path", "file"]},
        "symbol_or_pointer": {"type": ["string", "null"]},
        "expected_signature": {"type": ["string", "null"]},
        "compatibility_entrypoint": {"type": ["string", "null"]},
        "activation_guard": {"type": ["string", "null"]},
        "selection_reason": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "command", "oracle", "evidence_output"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "oracle": {"type": "string", "minLength": 1},
        "evidence_output": {"type": "string", "minLength": 1}
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["runbook_id", "trigger", "steps", "oracle", "durable_data_policy"],
      "properties": {
        "runbook_id": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "oracle": {"type": "string", "minLength": 1},
        "durable_data_policy": {"type": "string", "minLength": 1}
      }
    }
  }
}
