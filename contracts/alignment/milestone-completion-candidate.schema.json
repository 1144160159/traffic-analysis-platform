{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/milestone-completion-candidate.schema.json",
  "title": "Topic One pre-IDX milestone completion candidate",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "milestone_id", "promotion_profile", "candidate_manifest_sha256", "environment_id", "accountable_requirements", "accountable_canonical_ids", "required_atomic_prs", "required_external_activity_ids", "expected_evidence_run_ids", "expected_evidence_set_sha256", "requirement_results", "gate_results", "rollback_run_id", "rollback_plan_ref", "observation", "external_results", "explicit_exclusions", "not_applicable_entries", "allowed_claims", "forbidden_claims", "blockers", "result", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "milestone_id": {"type": "string", "pattern": "^T1-M(?:0[0-9]|1[0-3])$"},
    "promotion_profile": {"type": "string", "minLength": 1},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_id": {"type": "string", "minLength": 1},
    "accountable_requirements": {"type": "array", "items": {"type": "string", "pattern": "^REQ-T1-[A-Z0-9-]+$"}, "uniqueItems": true},
    "accountable_canonical_ids": {"type": "array", "items": {"type": "string", "pattern": "^(?:F|T)-[A-Z]+-[0-9]{3}$"}, "uniqueItems": true},
    "required_atomic_prs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_external_activity_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "expected_evidence_run_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "expected_evidence_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirement_results": {"type": "array", "items": {"$ref": "#/$defs/result_ref"}, "uniqueItems": true},
    "gate_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate_result"}, "uniqueItems": true},
    "rollback_run_id": {"type": "string", "minLength": 1},
    "rollback_plan_ref": {"$ref": "#/$defs/run_plan_ref"},
    "observation": {"$ref": "#/$defs/observation"},
    "external_results": {"type": "array", "items": {"$ref": "#/$defs/result_ref"}, "uniqueItems": true},
    "explicit_exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "not_applicable_entries": {"type": "array", "items": {"$ref": "#/$defs/not_applicable"}, "uniqueItems": true},
    "allowed_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "result": {"enum": ["READY_FOR_IDX", "BLOCKED"]},
    "created_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "result_ref": {"type": "object", "additionalProperties": false, "required": ["id", "manifest_sha256", "result"], "properties": {"id": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "result": {"enum": ["PASS", "SATISFIED", "FAIL", "FAILED", "BLOCKED", "STALE"]}}},
    "gate_result": {"type": "object", "additionalProperties": false, "required": ["gate_id", "run_id", "manifest_sha256", "result"], "properties": {"gate_id": {"type": "string", "pattern": "^G[0-8]$"}, "run_id": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "result": {"enum": ["PASS", "FAIL", "BLOCKED"]}}},
    "run_plan_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_pr_id", "execution_package_sha256", "plan_id", "plan_sha256", "bom_transition_sha256"],
      "properties": {
        "subject_pr_id": {"type": "string", "minLength": 1},
        "execution_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_id": {"type": "string", "minLength": 1},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bom_transition_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["window", "status", "run_id", "plan_ref"],
      "properties": {
        "window": {"type": "string", "minLength": 1},
        "status": {"enum": ["NOT_REQUIRED", "PASS", "BLOCKED"]},
        "run_id": {"type": ["string", "null"]},
        "plan_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/run_plan_ref"}]}
      }
    },
    "not_applicable": {"type": "object", "additionalProperties": false, "required": ["id", "authority", "reason", "receipt_path", "receipt_sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "authority": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "receipt_path": {"type": "string", "minLength": 1}, "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "READY_FOR_IDX"}}},
      "then": {
        "properties": {
          "blockers": {"type": "array", "maxItems": 0},
          "requirement_results": {"items": {"properties": {"result": {"enum": ["PASS", "SATISFIED"]}}}},
          "gate_results": {"items": {"properties": {"result": {"const": "PASS"}}}},
          "external_results": {"items": {"properties": {"result": {"const": "PASS"}}}},
          "observation": {"properties": {"status": {"enum": ["NOT_REQUIRED", "PASS"]}}}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "BLOCKED"}}},
      "then": {"properties": {"blockers": {"type": "array", "minItems": 1}}}
    }
  ]
}
