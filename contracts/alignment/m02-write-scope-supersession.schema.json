{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-write-scope-supersession.schema.json",
  "title": "M02 append-only effective write-scope supersession ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "revision_id",
    "source_catalog", "source_allocation", "ownership_boundary",
    "supersessions", "activation_policy", "validation", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_EFFECTIVE_WRITE_SCOPE_SUPERSESSION_LEDGER"},
    "artifact_status": {"const": "DESIGNED_NOT_REGISTERED"},
    "revision_id": {"const": "M02-WRITE-SCOPE-SUPERSESSION-V1"},
    "source_catalog": {"$ref": "#/$defs/hash_ref"},
    "source_allocation": {"$ref": "#/$defs/hash_ref"},
    "ownership_boundary": {"$ref": "#/$defs/hash_ref"},
    "supersessions": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/supersession"}
    },
    "activation_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "required_evidence", "activation_effect", "failure_rule"],
      "properties": {
        "decision": {"const": "BLOCKED_NOT_REGISTERED"},
        "required_evidence": {
          "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
          "items": {
            "enum": [
              "ONE_CLEAN_CANDIDATE_MANIFEST",
              "P408_REPLAY_DELAY_EXACT_RUST_AST_RECEIPT",
              "P165_POLL_MANIFEST_EXACT_RUST_AST_RECEIPT",
              "P408_UNIFIED_FUNCTION_REVIEW_RECEIPT",
              "P165_UNIFIED_FUNCTION_REVIEW_RECEIPT",
              "FOUR_CANDIDATE_CATALOGS_APPLY_THE_SAME_SUPERSESSION_HASH"
            ]
          }
        },
        "activation_effect": {"const": "FUTURE_CANDIDATE_PACKAGES_USE_EFFECTIVE_WRITE_AND_READ_ONLY_CONTEXT_SETS_WHILE_FROZEN_HISTORY_REMAINS_BYTE_IDENTICAL"},
        "failure_rule": {"const": "ANY_MISSING_OR_HASH_MISMATCH_KEEPS_P408_UNCLAIMABLE_AND_ACTIVE_REGISTRIES_UNCHANGED"}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_exact", "frozen_predecessor_exact", "scope_strictly_narrows",
        "no_new_locator_introduced", "context_owner_exact", "integration_edge_exact",
        "historical_artifacts_not_mutated", "premature_activation_rejected", "mutation_guards"
      ],
      "properties": {
        "source_exact": {"const": "PASS"},
        "frozen_predecessor_exact": {"const": "PASS"},
        "scope_strictly_narrows": {"const": true},
        "no_new_locator_introduced": {"const": true},
        "context_owner_exact": {"const": "PASS"},
        "integration_edge_exact": {"const": "PASS"},
        "historical_artifacts_not_mutated": {"const": true},
        "premature_activation_rejected": {"const": true},
        "mutation_guards": {
          "type": "object", "additionalProperties": false,
          "required": ["scope_widening", "context_omission", "owner_swap", "edge_reversal", "false_activation", "source_hash_drift"],
          "properties": {
            "scope_widening": {"const": "PASS"},
            "context_omission": {"const": "PASS"},
            "owner_swap": {"const": "PASS"},
            "edge_reversal": {"const": "PASS"},
            "false_activation": {"const": "PASS"},
            "source_hash_drift": {"const": "PASS"}
          }
        }
      }
    },
    "proof_ceiling": {"const": "WRITE_SCOPE_SUPERSESSION_DESIGN_ONLY_NOT_REGISTERED_LOCATOR_RESOLVED_FUNCTION_REVIEWED_IMPLEMENTED_OR_AUTHORIZED"}
  },
  "$defs": {
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "edge_kind"],
      "properties": {
        "from": {"const": "M02-N004-L48"},
        "to": {"const": "M02-N004-L21"},
        "edge_kind": {"const": "APPENDED_TO_EXISTING"}
      }
    },
    "supersession": {
      "type": "object", "additionalProperties": false,
      "required": [
        "supersession_id", "predecessor_leaf_id", "predecessor_atomic_pr_id",
        "frozen_write_locators", "frozen_write_locator_exact_set_sha256",
        "effective_write_locators", "read_only_context_locators",
        "context_function_owner_leaf_id", "context_function_owner_atomic_pr_id",
        "integration_edge", "change_rule", "activation_status"
      ],
      "properties": {
        "supersession_id": {"const": "M02-P408-POLL-MANIFEST-WRITE-SCOPE-V1"},
        "predecessor_leaf_id": {"const": "M02-N004-L48"},
        "predecessor_atomic_pr_id": {"const": "T1-M02-P408-WRT-n004-l48"},
        "frozen_write_locators": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "frozen_write_locator_exact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "effective_write_locators": {
          "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
          "items": {"const": "rust/probe-agent/probe-agent/src/capture/pcap_offline.rs#replay_delay"}
        },
        "read_only_context_locators": {
          "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
          "items": {"const": "rust/probe-agent/probe-agent/src/capture/pcap_offline.rs#ManifestPcapReplayer::poll_manifest"}
        },
        "context_function_owner_leaf_id": {"const": "M02-N004-L21"},
        "context_function_owner_atomic_pr_id": {"const": "T1-M02-P165-WRT-n004-l21"},
        "integration_edge": {"$ref": "#/$defs/edge"},
        "change_rule": {"const": "REMOVE_COMPANION_FROM_EFFECTIVE_WRITE_SCOPE_WITHOUT_MUTATING_FROZEN_P408_RECORD"},
        "activation_status": {"const": "BLOCKED_NOT_REGISTERED"}
      }
    }
  }
}
