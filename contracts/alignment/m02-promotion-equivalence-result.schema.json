{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-promotion-equivalence-result.schema.json",
  "title": "M02 premerge or postmerge equivalence result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "mode", "status", "candidate_manifest_sha256",
    "candidate_commit", "candidate_tree_sha256", "profile_id", "environment_id",
    "evidence_index_sha256", "allowed_paths", "promotion_intent_sha256",
    "premerge_result_sha256", "merge_receipt_sha256", "merge_commit",
    "merge_tree_sha256", "allowed_path_diff_sha256", "provenance_attestations",
    "merge_attestation", "checks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "M02_PROMOTION_EQUIVALENCE_RESULT"},
    "mode": {"enum": ["PREMERGE", "POSTMERGE"]},
    "status": {"const": "PASS"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "minLength": 3},
    "environment_id": {"type": "string", "minLength": 3},
    "evidence_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allowed_paths": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "contracts/releases/topic1/t1-m02-release-pointer.json"}},
    "promotion_intent_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "premerge_result_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "merge_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "merge_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "merge_tree_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "allowed_path_diff_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "provenance_attestations": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["receipt_id", "request_path", "attestation_id", "signer_id"],
        "properties": {
          "receipt_id": {"type": "string", "minLength": 1},
          "request_path": {"type": "string", "minLength": 1},
          "attestation_id": {"type": "string", "minLength": 1},
          "signer_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "merge_attestation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["attestation_id", "signer_id"],
      "properties": {
        "attestation_id": {"type": "string", "minLength": 1},
        "signer_id": {"type": "string", "minLength": 1}
      }
    },
    "checks": {"type": "array", "minItems": 6, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "PREMERGE"}}},
      "then": {"properties": {
        "promotion_intent_sha256": {"type": "null"}, "premerge_result_sha256": {"type": "null"},
        "merge_receipt_sha256": {"type": "null"}, "merge_commit": {"type": "null"},
        "merge_tree_sha256": {"type": "null"}, "allowed_path_diff_sha256": {"type": "null"},
        "merge_attestation": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"mode": {"const": "POSTMERGE"}}},
      "then": {"properties": {
        "promotion_intent_sha256": {"type": "string"}, "premerge_result_sha256": {"type": "string"},
        "merge_receipt_sha256": {"type": "string"}, "merge_commit": {"type": "string"},
        "merge_tree_sha256": {"type": "string"}, "allowed_path_diff_sha256": {"type": "string"},
        "merge_attestation": {"type": "object"}
      }}
    }
  ]
}
