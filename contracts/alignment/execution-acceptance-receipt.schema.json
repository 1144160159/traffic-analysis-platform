{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/execution-acceptance-receipt.schema.json",
  "title": "Scoped execution acceptance signed receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "instance_id", "task_registry_sha256", "milestone_registry_sha256",
    "scope_sha256", "execution_authorization_body_sha256", "atomic_pr_ids", "decision", "accepted_by", "accepted_at",
    "signed_payload_artifact", "signed_payload_sha256", "signature_artifacts", "verification"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "instance_id": {"type": "string", "minLength": 1},
    "task_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "milestone_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_authorization_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "atomic_pr_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "decision": {"const": "ACCEPTED_FOR_SCOPED_EXECUTION"},
    "accepted_by": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
    "accepted_at": {"type": "string", "minLength": 1},
    "signed_payload_artifact": {"type": "string", "minLength": 1},
    "signed_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_artifacts": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "algorithm", "key_or_certificate_id"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "algorithm": {"type": "string", "minLength": 1},
          "key_or_certificate_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "verifier", "verifier_version", "verified_at", "revocation_checked"],
      "properties": {
        "status": {"const": "PASS"},
        "verifier": {"type": "string", "minLength": 1},
        "verifier_version": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "minLength": 1},
        "revocation_checked": {"const": true}
      }
    }
  }
}
