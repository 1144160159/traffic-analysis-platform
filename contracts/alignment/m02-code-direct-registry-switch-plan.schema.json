{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-code-direct-registry-switch-plan.schema.json",
  "title": "M02 code-direct global registry switch readiness ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "revision_id",
    "source_catalog", "source_semantic_projection_sha256", "locator_coverage", "function_review_coverage", "gate_input_preflight", "external_input_work_orders", "implementation_candidate_closure", "write_scope_supersession",
    "current_global_catalogs", "current_global_atomic_pr_count",
    "current_legacy_m02_atomic_pr_count", "replacement_m02_atomic_pr_count",
    "candidate_global_atomic_pr_count", "current_atomic_id_exact_set_sha256",
    "replacement_atomic_id_exact_set_sha256", "candidate_atomic_id_exact_set_sha256",
    "task_replacements", "legacy_tombstones", "external_activity_registrations",
    "preconditions", "switch_protocol", "validation", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_CODE_DIRECT_GLOBAL_REGISTRY_SWITCH_READINESS_LEDGER"},
    "artifact_status": {"const": "BLOCKED_PRE_SWITCH_READINESS"},
    "revision_id": {"const": "M02-REG-03-PRECHECK-V1"},
    "source_catalog": {"$ref": "#/$defs/hash_ref"},
    "source_semantic_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locator_coverage": {"$ref": "#/$defs/hash_ref"},
    "function_review_coverage": {"$ref": "#/$defs/hash_ref"},
    "gate_input_preflight": {"$ref": "#/$defs/hash_ref"},
    "external_input_work_orders": {"$ref": "#/$defs/hash_ref"},
    "implementation_candidate_closure": {"$ref": "#/$defs/hash_ref"},
    "write_scope_supersession": {"$ref": "#/$defs/hash_ref"},
    "current_global_catalogs": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/catalog_ref"}
    },
    "current_global_atomic_pr_count": {"const": 1289},
    "current_legacy_m02_atomic_pr_count": {"const": 34},
    "replacement_m02_atomic_pr_count": {"const": 425},
    "candidate_global_atomic_pr_count": {"const": 1680},
    "current_atomic_id_exact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replacement_atomic_id_exact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_atomic_id_exact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_replacements": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {"$ref": "#/$defs/task_replacement"}
    },
    "legacy_tombstones": {
      "type": "array", "minItems": 34, "maxItems": 34,
      "items": {"$ref": "#/$defs/tombstone"}
    },
    "external_activity_registrations": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/external_activity"}
    },
    "preconditions": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {"$ref": "#/$defs/precondition"}
    },
    "switch_protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "atomic_steps", "failure_rule", "rollback_rule", "post_switch_execution_state"],
      "properties": {
        "decision": {"const": "BLOCKED_PRECONDITIONS"},
        "atomic_steps": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {"type": "string", "minLength": 1}
        },
        "failure_rule": {"type": "string", "minLength": 1},
        "rollback_rule": {"type": "string", "minLength": 1},
        "post_switch_execution_state": {"const": "DRAFT_DESIGN_AND_TEMPLATE_EXECUTION_NO_GO"}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "source_catalog_semantic_exact", "four_catalog_current_exact_set",
        "legacy_m02_exact_set", "replacement_exact_set", "legacy_replacement_disjoint",
        "candidate_count_derivation", "terminal_exact_set", "completion_member_exact_set",
        "external_activity_exact_set", "tombstone_exact_set", "gate_input_preflight_exact", "external_input_work_orders_exact", "implementation_candidate_closure_exact", "premature_switch_rejected",
        "mutation_guards"
      ],
      "properties": {
        "schema": {"const": "PASS"},
        "source_catalog_semantic_exact": {"const": "PASS"},
        "four_catalog_current_exact_set": {"const": "PASS"},
        "legacy_m02_exact_set": {"const": "PASS"},
        "replacement_exact_set": {"const": "PASS"},
        "legacy_replacement_disjoint": {"const": true},
        "candidate_count_derivation": {"const": "PASS"},
        "terminal_exact_set": {"const": "PASS"},
        "completion_member_exact_set": {"const": "PASS"},
        "external_activity_exact_set": {"const": "PASS"},
        "tombstone_exact_set": {"const": "PASS"},
        "gate_input_preflight_exact": {"const": "PASS"},
        "external_input_work_orders_exact": {"const": "PASS"},
        "implementation_candidate_closure_exact": {"const": "PASS"},
        "premature_switch_rejected": {"const": true},
        "mutation_guards": {
          "type": "object", "additionalProperties": false,
          "required": [
            "catalog_exact_set_drift", "legacy_omission", "replacement_omission",
            "candidate_hash_drift", "terminal_mismatch", "completion_member_mismatch",
            "tombstone_omission", "premature_pass", "preflight_hash_drift", "work_order_hash_drift", "implementation_closure_hash_drift"
          ],
          "properties": {
            "catalog_exact_set_drift": {"const": "PASS"},
            "legacy_omission": {"const": "PASS"},
            "replacement_omission": {"const": "PASS"},
            "candidate_hash_drift": {"const": "PASS"},
            "terminal_mismatch": {"const": "PASS"},
            "completion_member_mismatch": {"const": "PASS"},
            "tombstone_omission": {"const": "PASS"},
            "premature_pass": {"const": "PASS"},
            "preflight_hash_drift": {"const": "PASS"},
            "work_order_hash_drift": {"const": "PASS"}
            ,"implementation_closure_hash_drift": {"const": "PASS"}
          }
        }
      }
    },
    "proof_ceiling": {
      "const": "SWITCH_READINESS_AND_TOMBSTONE_PLAN_ONLY_NOT_GLOBAL_REGISTRY_SWITCH_TARGET_BINDING_FUNCTION_REVIEW_IMPLEMENTATION_TEST_EXECUTION_AUTHORIZATION_OR_ACCEPTANCE"
    }
  },
  "$defs": {
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "catalog_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "atomic_pr_count", "active_m02_atomic_pr_count", "atomic_id_exact_set_sha256", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "atomic_pr_count": {"const": 1289},
        "active_m02_atomic_pr_count": {"const": 34},
        "atomic_id_exact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "CURRENT_ACTIVE_LEGACY_M02"}
      }
    },
    "task_replacement": {
      "type": "object", "additionalProperties": false,
      "required": [
        "parent_task_id", "legacy_atomic_pr_ids", "replacement_leaf_ids",
        "replacement_atomic_pr_ids", "terminal_leaf_id", "terminal_atomic_pr_id",
        "completion_member_atomic_pr_ids", "external_activity_ids", "transition_status"
      ],
      "properties": {
        "parent_task_id": {"type": "string", "pattern": "^T1-M02-N[0-9]{3}$"},
        "legacy_atomic_pr_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
        "replacement_leaf_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "replacement_atomic_pr_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "terminal_leaf_id": {"type": "string", "minLength": 1},
        "terminal_atomic_pr_id": {"type": "string", "minLength": 1},
        "completion_member_atomic_pr_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "external_activity_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "transition_status": {"const": "PLANNED_BLOCKED_NOT_ACTIVE"}
      }
    },
    "tombstone": {
      "type": "object", "additionalProperties": false,
      "required": [
        "legacy_atomic_pr_id", "parent_task_id", "current_status", "status_after_atomic_switch",
        "replacement_atomic_pr_ids", "claim_rule", "retention_rule"
      ],
      "properties": {
        "legacy_atomic_pr_id": {"type": "string", "minLength": 1},
        "parent_task_id": {"type": "string", "pattern": "^T1-M02-N[0-9]{3}$"},
        "current_status": {"const": "ACTIVE_LEGACY_BINDING_UNTIL_ATOMIC_SWITCH"},
        "status_after_atomic_switch": {"const": "SUPERSEDED_NOT_AUTHORIZED"},
        "replacement_atomic_pr_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "claim_rule": {"const": "OLD_ID_MUST_BE_UNCLAIMABLE_AFTER_SWITCH"},
        "retention_rule": {"const": "RETAIN_TOMBSTONE_UNTIL_REPLACEMENT_TERMINAL_TASK_IDX_IS_REACHABLE"}
      }
    },
    "external_activity": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_id", "parent_task_id", "activity_type", "depends_on_atomic_pr_ids", "successor_atomic_pr_ids", "registration_status"],
      "properties": {
        "activity_id": {"type": "string", "minLength": 1},
        "parent_task_id": {"type": "string", "pattern": "^T1-M02-N[0-9]{3}$"},
        "activity_type": {"enum": ["SCOPED_CANARY", "PROFILE_APPROVAL", "PROTECTED_MERGE"]},
        "depends_on_atomic_pr_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "successor_atomic_pr_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "registration_status": {"const": "BLOCKED_EXTERNAL_RECEIPT_CONTRACT_NOT_ACTIVE"}
      }
    },
    "precondition": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "description", "status", "evidence", "blocking_reason"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^REG03-C[0-9]{2}$"},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "BLOCKED"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "blocking_reason": {"type": ["string", "null"]}
      }
    }
  }
}
