{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-code-direct-leaf-allocation.v4.schema.json",
  "title": "M02 append-only delivery-package owner allocation ledger v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "revision_id",
    "base_catalog", "source_contract_refs", "prior_leaf_field_freeze",
    "semantic_projection_sha256", "allocation_epoch", "append_leaf_count",
    "trains", "delivery_artifact_contract", "claims"
  ],
  "properties": {
    "schema_version": {"const": "4.0.0"},
    "artifact_kind": {"const": "M02_CODE_DIRECT_DELIVERY_PACKAGE_OWNER_ALLOCATION_LEDGER"},
    "artifact_status": {"const": "VERSIONED_PREVIEW_NOT_GLOBAL_REGISTRY"},
    "revision_id": {"const": "M02-CODE-DIRECT-V4"},
    "base_catalog": {"$ref": "#/$defs/hash_ref"},
    "source_contract_refs": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"$ref": "#/$defs/hash_ref"}
    },
    "prior_leaf_field_freeze": {
      "type": "object", "additionalProperties": false,
      "required": ["leaf_id_epoch", "field_names", "ordered_leaf_projection_sha256", "status"],
      "properties": {
        "leaf_id_epoch": {"const": "T1-M02-P101-P521"},
        "field_names": {
          "type": "array", "minItems": 17, "maxItems": 17, "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "ordered_leaf_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "PASS_EXACT_FIELD_PRESERVATION"}
      }
    },
    "semantic_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allocation_epoch": {"const": "T1-M02-P522-P525"},
    "append_leaf_count": {"const": 4},
    "trains": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"$ref": "#/$defs/train"}
    },
    "delivery_artifact_contract": {"$ref": "#/$defs/delivery_contract"},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "forbidden", "proof_ceiling"],
      "properties": {
        "allowed": {"const": "P522-P525 delivery-package ownership and dependency intent are allocated for v4 preview validation"},
        "forbidden": {
          "type": "array", "minItems": 7, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "proof_ceiling": {"const": "ALLOCATION_ONLY_NOT_GLOBAL_REGISTRATION_PRODUCT_ARTIFACT_CREATION_FUNCTION_REVIEW_IMPLEMENTATION_TEST_EXECUTION_AUTHORIZATION_OR_ACCEPTANCE"}
      }
    }
  },
  "$defs": {
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": [
        "leaf_id", "atomic_pr_id", "pr_type", "primary_locator",
        "companion_locators", "target_state", "prerequisite_leaf_ids",
        "single_outcome", "oracle_and_rollback"
      ],
      "properties": {
        "leaf_id": {"type": "string", "pattern": "^M02-N013-L1[0-3]$"},
        "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P52[2-5]-(?:CTR|WRT|REF|TST-PRE)-n013-l1[0-3]$"},
        "pr_type": {"enum": ["CTR", "WRT", "REF", "TST-PRE"]},
        "primary_locator": {"type": "string", "minLength": 3},
        "companion_locators": {
          "type": "array", "maxItems": 4, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "target_state": {"enum": ["PLANNED", "PLANNED_OUTPUT"]},
        "prerequisite_leaf_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2,3}$"}
        },
        "single_outcome": {"type": "string", "minLength": 8},
        "oracle_and_rollback": {"type": "string", "minLength": 8}
      }
    },
    "train": {
      "type": "object", "additionalProperties": false,
      "required": [
        "train_id", "parent_task_id", "gap_id", "owner_kind", "contract_id",
        "single_result", "steps", "feed_source_leaf_id", "feeds_existing_leaf_ids",
        "terminal_leaf_id"
      ],
      "properties": {
        "train_id": {"const": "M02-V4-TRAIN-71"},
        "parent_task_id": {"const": "T1-M02-N013"},
        "gap_id": {"const": "GAP-M02-IMPLEMENTATION-DELIVERY-ARTIFACT-OWNER"},
        "owner_kind": {"const": "DELIVERY_PACKAGE_OWNER"},
        "contract_id": {"const": "IC-M02-DELIVERY-ARTIFACT-EXACT-FIVE"},
        "single_result": {"type": "string", "minLength": 12},
        "steps": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"$ref": "#/$defs/step"}
        },
        "feed_source_leaf_id": {"const": "M02-N013-L12"},
        "feeds_existing_leaf_ids": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["M02-N013-L06", "M02-N016-L02"]}
        },
        "terminal_leaf_id": {"const": "M02-N013-L09"}
      }
    },
    "delivery_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_owner_leaf_id", "package_owner_leaf_id", "validator_owner_leaf_id", "test_owner_leaf_id", "required_artifacts", "atomicity"],
      "properties": {
        "schema_owner_leaf_id": {"const": "M02-N013-L10"},
        "package_owner_leaf_id": {"const": "M02-N013-L11"},
        "validator_owner_leaf_id": {"const": "M02-N013-L12"},
        "test_owner_leaf_id": {"const": "M02-N013-L13"},
        "required_artifacts": {
          "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["artifact_role", "path"],
            "properties": {
              "artifact_role": {"enum": ["install-manifest", "preflight-plan", "upgrade-plan", "rollback-plan", "restore-plan"]},
              "path": {"type": "string", "pattern": "^deployments/releases/topic1/m02-(?:install-manifest|preflight-plan|upgrade-plan|rollback-plan|restore-plan)\\.v1\\.json$"}
            }
          }
        },
        "atomicity": {"const": "ONE_WRT_LEAF_OWNS_ALL_FIVE_EXACT_PATHS"}
      }
    }
  }
}
