{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/task-execution-overlay.schema.json",
  "title": "Scoped task execution readiness overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "instance_id", "task_registry_sha256", "milestone_registry_sha256", "status",
    "scope", "milestone_bindings", "task_bindings", "closure_slice_bindings", "atomic_pr_bindings",
    "external_activity_bindings", "acceptance"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "instance_id": {"type": ["string", "null"]},
    "task_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "milestone_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["TEMPLATE_EXECUTION_NO_GO", "ACCEPTED_FOR_SCOPED_EXECUTION"]},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["milestone_ids", "task_ids", "closure_slice_ids", "atomic_pr_ids"],
      "properties": {
        "milestone_ids": {"type": "array", "items": {"type": "string", "pattern": "^T1-M[0-9]{2}$"}, "uniqueItems": true},
        "task_ids": {"type": "array", "items": {"type": "string", "pattern": "^T1-M[0-9]{2}-N[0-9]{3}$"}, "uniqueItems": true},
        "closure_slice_ids": {"type": "array", "items": {"type": "string", "pattern": "^T1-M13-R[0-9]{2}$"}, "uniqueItems": true},
        "atomic_pr_ids": {"type": "array", "items": {"type": "string", "pattern": "^T1-M[0-9]{2}(?:-R[0-9]{2})?-P[0-9]{3}-[A-Z-]+-[a-z0-9-]+$"}, "uniqueItems": true}
      }
    },
    "milestone_bindings": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/milestone_binding"}},
    "task_bindings": {"type": "array", "minItems": 212, "maxItems": 212, "items": {"$ref": "#/$defs/binding"}},
    "closure_slice_bindings": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "#/$defs/binding"}},
    "atomic_pr_bindings": {"type": "array", "minItems": 212, "items": {"$ref": "#/$defs/atomic_pr_binding"}},
    "external_activity_bindings": {"type": "array", "items": {"$ref": "#/$defs/external_activity_binding"}},
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["dor_status", "candidate_status", "checklist_status", "accepted_by", "accepted_at", "decision_receipt_path", "decision_receipt_sha256"],
      "properties": {
        "dor_status": {"enum": ["BLOCKED", "PASS"]},
        "candidate_status": {"enum": ["BLOCKED", "PASS"]},
        "checklist_status": {"enum": ["BLOCKED", "PASS"]},
        "accepted_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "accepted_at": {"type": ["string", "null"]},
        "decision_receipt_path": {"type": ["string", "null"]},
        "decision_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "selected_target": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "symbol", "approved_by"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "symbol": {"type": ["string", "null"], "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1}
      }
    },
    "milestone_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["milestone_id", "readiness_status", "owner", "reviewers", "approvers", "candidate_manifest_sha256", "profile_id", "blockers"],
      "properties": {
        "milestone_id": {"type": "string", "pattern": "^T1-M(?:0[0-9]|1[0-3])$"},
        "readiness_status": {"enum": ["DRAFT", "READY", "BLOCKED", "PASS", "FAIL"]},
        "owner": {"type": ["string", "null"]},
        "reviewers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "approvers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "candidate_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "profile_id": {
          "type": ["string", "null"],
          "description": "Actual scoped execution profile; fixed by PR/external identity edges and the selected milestone registry profile."
        },
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "work_id", "readiness_status", "owner", "reviewers", "approvers", "selected_targets",
        "candidate_manifest_sha256", "test_plan_id", "evidence_plan_id", "rollback_plan_id", "blockers"
      ],
      "properties": {
        "work_id": {"type": "string", "minLength": 1},
        "readiness_status": {"enum": ["DRAFT", "READY", "BLOCKED"]},
        "owner": {"type": ["string", "null"]},
        "reviewers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "approvers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "selected_targets": {"type": "array", "items": {"$ref": "#/$defs/selected_target"}, "uniqueItems": true},
        "candidate_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "test_plan_id": {"type": ["string", "null"]},
        "evidence_plan_id": {"type": ["string", "null"]},
        "rollback_plan_id": {"type": ["string", "null"]},
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "evidence_run_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "subject_pr_id", "subject_work_id", "subject_milestone_id", "execution_package_sha256", "plan_kind", "plan_id", "plan_sha256", "bom_transition_sha256", "candidate_manifest_sha256", "profile_id", "environment_id", "time_window", "run_purpose", "gate_id", "result", "artifacts", "manifest_path", "manifest_sha256", "production_applied", "exclusions"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "run_id": {"type": "string", "minLength": 1},
        "subject_pr_id": {"type": "string", "pattern": "^T1-M[0-9]{2}(?:-R[0-9]{2})?-P[0-9]{3}-[A-Z-]+-[a-z0-9-]+$"},
        "subject_work_id": {"type": "string", "pattern": "^T1-M[0-9]{2}-(?:N[0-9]{3}|R[0-9]{2})$"},
        "subject_milestone_id": {"type": "string", "pattern": "^T1-M[0-9]{2}$"},
        "execution_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_kind": {"enum": ["TEST", "EVIDENCE", "ROLLBACK", "OBSERVATION"]},
        "plan_id": {"type": "string", "minLength": 1},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bom_transition_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_id": {"type": "string", "minLength": 1},
        "environment_id": {"type": "string", "minLength": 1},
        "time_window": {"type": "string", "minLength": 1},
        "run_purpose": {"enum": ["VERIFICATION", "ROLLBACK_REHEARSAL", "OBSERVATION", "RECONCILIATION", "EXTERNAL_ATTESTATION"]},
        "gate_id": {"type": "string", "pattern": "^G[0-8]$"},
        "result": {"enum": ["PASS", "FAIL", "BLOCKED"]},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_artifact_ref"}, "uniqueItems": true},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "production_applied": {"type": "boolean"},
        "exclusions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "evidence_artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "artifact_id", "path", "sha256", "schema_ref"],
      "properties": {
        "direction": {"enum": ["INPUT", "OUTPUT"]},
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_ref": {"type": ["string", "null"]}
      }
    },
    "atomic_pr_binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pr_id", "readiness_status", "owner", "reviewers", "approvers", "selected_targets",
        "allowed_paths", "candidate_manifest_path", "candidate_manifest_sha256", "profile_id", "execution_package_ref", "bom_transition_ref",
        "requirement_satisfaction_refs", "milestone_completion_candidate_ref", "milestone_promotion_closure_ref",
        "task_completion_candidate_ref", "task_current_index_ref",
        "current_idx_manifest_path", "current_idx_manifest_sha256",
        "promotion_intent_manifest_path", "promotion_intent_manifest_sha256",
        "postmerge_result_manifest_path", "postmerge_result_manifest_sha256",
        "evidence_run_bindings", "test_plan_id", "evidence_plan_id", "rollback_plan_id", "blockers"
      ],
      "properties": {
        "pr_id": {"type": "string", "pattern": "^T1-M[0-9]{2}(?:-R[0-9]{2})?-P[0-9]{3}-[A-Z-]+-[a-z0-9-]+$"},
        "readiness_status": {"enum": ["DRAFT", "READY", "BLOCKED", "PASS", "FAIL"]},
        "owner": {"type": ["string", "null"]},
        "reviewers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "approvers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "selected_targets": {"type": "array", "items": {"$ref": "#/$defs/selected_target"}, "uniqueItems": true},
        "allowed_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "candidate_manifest_path": {"type": ["string", "null"]},
        "candidate_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "profile_id": {"type": ["string", "null"]},
        "execution_package_ref": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["path", "sha256", "schema_version"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "schema_version": {"const": "1.0.0"}
          }
        },
        "bom_transition_ref": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["path", "sha256", "schema_version"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "schema_version": {"const": "1.0.0"}
          }
        },
        "requirement_satisfaction_refs": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement_satisfaction_ref"}
        },
        "milestone_completion_candidate_ref": {"$ref": "#/$defs/nullable_artifact_ref"},
        "milestone_promotion_closure_ref": {"$ref": "#/$defs/nullable_artifact_ref"},
        "task_completion_candidate_ref": {"$ref": "#/$defs/nullable_artifact_ref"},
        "task_current_index_ref": {"$ref": "#/$defs/nullable_artifact_ref"},
        "current_idx_manifest_path": {"type": ["string", "null"]},
        "current_idx_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "promotion_intent_manifest_path": {"type": ["string", "null"]},
        "promotion_intent_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "postmerge_result_manifest_path": {"type": ["string", "null"]},
        "postmerge_result_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "evidence_run_bindings": {"type": "array", "items": {"$ref": "#/$defs/evidence_run_binding"}, "uniqueItems": true},
        "test_plan_id": {"type": ["string", "null"]},
        "evidence_plan_id": {"type": ["string", "null"]},
        "rollback_plan_id": {"type": ["string", "null"]},
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": "1.0.0"}
      }
    },
    "nullable_artifact_ref": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]
    },
    "requirement_satisfaction_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "path", "sha256", "schema_version"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^REQ-T1-[A-Z0-9-]+$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": "1.0.0"}
      }
    },
    "external_activity_binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "activity_id", "status", "run_id", "instance_id", "candidate_manifest_sha256", "profile_id",
        "required_inputs", "receipt_artifact", "receipt_sha256", "blockers"
      ],
      "properties": {
        "activity_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PENDING", "READY", "RUNNING", "PASS", "FAIL", "BLOCKED"]},
        "run_id": {"type": ["string", "null"]},
        "instance_id": {"type": ["string", "null"]},
        "candidate_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "profile_id": {"type": ["string", "null"]},
        "required_inputs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["artifact_id", "sha256"],
            "properties": {
              "artifact_id": {"type": "string", "minLength": 1},
              "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "receipt_artifact": {"type": "string", "minLength": 1},
        "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
