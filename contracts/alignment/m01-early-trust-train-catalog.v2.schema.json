{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m01-early-trust-train-catalog.v2.schema.json",
  "title": "M01 function-complete early trust candidate catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "revision_id",
    "base_catalog", "allocation_ledger", "source_m01_leaf_count",
    "v2_superseded_leaf_count", "v2_appended_leaf_count", "candidate_m01_leaf_count",
    "candidate_global_atomic_pr_count", "retained_atomic_pr_ids", "supersession_tombstones",
    "candidate_leaves", "candidate_edges", "external_activities", "completion_revision",
    "global_switch_gate", "validation", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "M01_EARLY_TRUST_FUNCTION_COMPLETE_CANDIDATE_CATALOG"},
    "artifact_status": {"const": "VERSIONED_PREVIEW_NOT_GLOBAL_REGISTRY"},
    "revision_id": {"const": "M01-EARLY-TRUST-V2"},
    "base_catalog": {"$ref": "#/$defs/hash_ref"},
    "allocation_ledger": {"$ref": "#/$defs/hash_ref"},
    "source_m01_leaf_count": {"const": 57},
    "v2_superseded_leaf_count": {"const": 3},
    "v2_appended_leaf_count": {"const": 30},
    "candidate_m01_leaf_count": {"const": 84},
    "candidate_global_atomic_pr_count": {"const": 1317},
    "retained_atomic_pr_ids": {
      "type": "array", "minItems": 54, "maxItems": 54, "uniqueItems": true,
      "items": {"type": "string"}
    },
    "supersession_tombstones": {
      "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
      "items": {"type": "object"}
    },
    "candidate_leaves": {
      "type": "array", "minItems": 84, "maxItems": 84,
      "items": {"$ref": "#/$defs/leaf"}
    },
    "candidate_edges": {
      "type": "array", "minItems": 66, "uniqueItems": true,
      "items": {"$ref": "#/$defs/edge"}
    },
    "external_activities": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"type": "object"}
    },
    "completion_revision": {"type": "object"},
    "global_switch_gate": {"$ref": "#/$defs/switch_gate"},
    "validation": {"$ref": "#/$defs/validation"},
    "proof_ceiling": {"const": "VERSIONED_STATIC_V2_PREVIEW_ONLY_NOT_GLOBAL_REGISTRATION_FUNCTION_REVIEW_IMPLEMENTATION_IMAGE_BUILD_SIGNATURE_DEPLOYMENT_TEST_EXECUTION_TRUST_PASS_AUTHORIZATION_OR_ACCEPTANCE"}
  },
  "$defs": {
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "leaf": {
      "type": "object", "additionalProperties": false,
      "required": [
        "atomic_pr_id", "parent_work_id", "pr_type", "phase", "source_kind",
        "write_locators", "target_state", "dependency_ids", "required_gates",
        "single_outcome", "terminal_task_idx", "formal_execution_status"
      ],
      "properties": {
        "atomic_pr_id": {"type": "string", "pattern": "^T1-M01-P[0-9]{3}-[A-Z-]+-.+$"},
        "parent_work_id": {"type": "string", "pattern": "^T1-M01-N[0-9]{3}$"},
        "pr_type": {"enum": ["CTR", "EXP", "PRJ", "WRT", "REF", "OPS", "TST-PRE", "TST-POST", "IDX", "PROM"]},
        "phase": {"type": "string", "minLength": 3},
        "source_kind": {"enum": ["RETAINED_V1_ID_AND_WRITE_SCOPE", "APPENDED_PREVIEW_V2"]},
        "write_locators": {
          "type": "array", "minItems": 1, "maxItems": 17, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "target_state": {"enum": ["PLANNED", "PLANNED_OUTPUT"]},
        "dependency_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_gates": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "single_outcome": {"type": "string", "minLength": 8},
        "terminal_task_idx": {"type": "boolean"},
        "formal_execution_status": {"const": "BLOCKED_UNTIL_GLOBAL_REGISTRY_TARGET_BINDING_FUNCTION_REVIEW_EXTERNAL_IMAGE_RECEIPT_AND_SIGNED_OVERLAY"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "edge_kind"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "edge_kind": {"enum": ["RETAINED_V1", "REVISED_DEPENDENCY", "APPENDED_PREREQUISITE", "EXTERNAL_ACTIVITY"]}
      }
    },
    "switch_gate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "decision", "active_global_atomic_pr_count", "active_m01_atomic_pr_count",
        "candidate_m01_atomic_pr_count", "candidate_global_atomic_pr_count",
        "required_catalogs", "switch_rule"
      ],
      "properties": {
        "decision": {"const": "BLOCKED_PREVIEW_ONLY"},
        "active_global_atomic_pr_count": {"const": 1289},
        "active_m01_atomic_pr_count": {"const": 56},
        "candidate_m01_atomic_pr_count": {"const": 84},
        "candidate_global_atomic_pr_count": {"const": 1317},
        "required_catalogs": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "switch_rule": {"const": "TASK_CLAIM_PR_DESIGN_AND_OVERLAY_MUST_SWITCH_ATOMICALLY_TO_ONE_REVIEWED_V2_CANDIDATE_AFTER_EXTERNAL_IMAGE_RECEIPT_BINDING"}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "v1_catalog_hash", "v1_candidate_exact", "append_id_exact",
        "supersession_exact", "write_locator_unique", "function_owner_exact", "type_owner_exact",
        "single_gate_evidence_exact", "external_image_activity_explicit",
        "completion_member_exact", "candidate_dag", "global_switch_blocked",
        "mutation_guards"
      ],
      "properties": {
        "schema": {"const": "PASS"},
        "v1_catalog_hash": {"const": "PASS"},
        "v1_candidate_exact": {"const": "PASS"},
        "append_id_exact": {"const": "PASS_P067_P096"},
        "supersession_exact": {"const": "PASS"},
        "write_locator_unique": {"const": true},
        "function_owner_exact": {"const": "PASS_25_FUNCTION_OWNERS"},
        "type_owner_exact": {"const": "PASS_3_TYPE_OWNERS"},
        "single_gate_evidence_exact": {"const": "PASS_G0_G1_G2_G3_G6"},
        "external_image_activity_explicit": {"const": true},
        "completion_member_exact": {"const": "PASS"},
        "candidate_dag": {"const": "PASS"},
        "global_switch_blocked": {"const": true},
        "mutation_guards": {
          "type": "object", "additionalProperties": false,
          "required": [
            "v1_drift", "append_id_reuse", "missing_server_owner", "missing_runtime_owner", "missing_type_contract", "repo_root_helper_omission",
            "multi_gate_evidence", "external_activity_omission", "locator_reuse",
            "supersession_omission", "terminal_dependency_drift", "completion_omission",
            "dag_cycle", "semantic_pin_drift", "global_catalog_exact_set"
          ],
          "properties": {
            "v1_drift": {"const": "PASS"},
            "append_id_reuse": {"const": "PASS"},
            "missing_server_owner": {"const": "PASS"},
            "missing_runtime_owner": {"const": "PASS"},
            "missing_type_contract": {"const": "PASS"},
            "repo_root_helper_omission": {"const": "PASS"},
            "multi_gate_evidence": {"const": "PASS"},
            "external_activity_omission": {"const": "PASS"},
            "locator_reuse": {"const": "PASS"},
            "supersession_omission": {"const": "PASS"},
            "terminal_dependency_drift": {"const": "PASS"},
            "completion_omission": {"const": "PASS"},
            "dag_cycle": {"const": "PASS"},
            "semantic_pin_drift": {"const": "PASS"},
            "global_catalog_exact_set": {"const": "PASS"}
          }
        }
      }
    }
  }
}
