{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m10-deployable-candidate-closure.schema.json",
  "title": "T1-M10-N001 deployable candidate closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "task_id", "atomic_pr_id", "status",
    "candidate_id", "closure_basis_sha256", "environment_kind", "source_tree",
    "upstream", "dimensions", "closure", "blocking_codes", "allowed_claims",
    "forbidden_claims", "production_applied"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "M10_DEPLOYABLE_CANDIDATE_CLOSURE"},
    "task_id": {"const": "T1-M10-N001"},
    "atomic_pr_id": {"const": "T1-M10-P001-CTR-n001-s1"},
    "status": {"enum": ["BLOCKED_INCOMPLETE", "FROZEN"]},
    "candidate_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "closure_basis_sha256": {"$ref": "#/$defs/sha256"},
    "environment_kind": {"const": "KUBERNETES"},
    "source_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "file_count", "algorithm", "git"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "algorithm": {"const": "sha256(path NUL sha256 NUL size LF)"},
        "git": {"$ref": "#/$defs/git"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m01_release_pointer", "m09_release_pointer", "m09_integrated_bom"],
      "properties": {
        "m01_release_pointer": {"$ref": "#/$defs/probe"},
        "m09_release_pointer": {"$ref": "#/$defs/upstreamProbe"},
        "m09_integrated_bom": {"$ref": "#/$defs/probe"}
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/dimension"}
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_dimension_count", "bound_dimension_count", "all_dimensions_bound", "fail_closed"],
      "properties": {
        "required_dimension_count": {"const": 8},
        "bound_dimension_count": {"type": "integer", "minimum": 0, "maximum": 8},
        "all_dimensions_bound": {"type": "boolean"},
        "fail_closed": {"type": "boolean"}
      }
    },
    "blocking_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "production_applied": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "branch", "dirty_count", "status_sha256"],
      "properties": {
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "branch": {"type": "string"},
        "dirty_count": {"type": "integer", "minimum": 0},
        "status_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "upstreamProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "status": {"type": ["string", "null"]},
        "candidate_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "refs", "detail", "blocking_codes"],
      "properties": {
        "name": {"enum": ["source_tree", "image_digests", "config", "schema", "topics", "models", "thresholds", "runbooks"]},
        "status": {"enum": ["BOUND", "PRESENT_UNBOUND", "MISSING", "INVALID"]},
        "refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
        "detail": {"type": "object"},
        "blocking_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "FROZEN"}}},
      "then": {
        "properties": {
          "candidate_id": {"$ref": "#/$defs/sha256"},
          "blocking_codes": {"maxItems": 0},
          "closure": {
            "properties": {
              "bound_dimension_count": {"const": 8},
              "all_dimensions_bound": {"const": true},
              "fail_closed": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "BLOCKED_INCOMPLETE"}}},
      "then": {
        "properties": {
          "candidate_id": {"type": "null"},
          "blocking_codes": {"minItems": 1},
          "closure": {"properties": {"fail_closed": {"const": true}}}
        }
      }
    }
  ]
}
