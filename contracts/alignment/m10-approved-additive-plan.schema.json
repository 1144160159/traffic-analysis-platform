{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m10-approved-additive-plan.schema.json",
  "title": "T1-M10-N005 approved additive change plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "task_id", "atomic_pr_id", "status",
    "environment_kind", "candidate_id", "plan_basis_sha256", "candidate",
    "preflight", "receipts", "artifacts", "replay_policy",
    "half_failure_policy", "compatibility_policy", "blocking_codes",
    "apply_allowed", "default_runtime_state", "shared_infrastructure_touched",
    "production_applied", "allowed_claims", "forbidden_claims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "M10_APPROVED_ADDITIVE_CHANGE_PLAN"},
    "task_id": {"const": "T1-M10-N005"},
    "atomic_pr_id": {"const": "T1-M10-P011-OPS-n005-s1"},
    "status": {"enum": ["BLOCKED_UNAPPROVED", "AUTHORIZED"]},
    "environment_kind": {"const": "KUBERNETES"},
    "candidate_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "plan_basis_sha256": {"$ref": "#/$defs/sha256"},
    "candidate": {"$ref": "#/$defs/upstream"},
    "preflight": {
      "allOf": [
        {"$ref": "#/$defs/probe"},
        {
          "type": "object",
          "required": ["run_id", "acceptance_status", "g6"],
          "properties": {
            "run_id": {"type": ["string", "null"]},
            "acceptance_status": {"type": ["string", "null"]},
            "g6": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["g1", "release_approval"],
      "properties": {
        "g1": {"$ref": "#/$defs/probe"},
        "release_approval": {"$ref": "#/$defs/probe"}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "replay_policy": {
      "const": {
        "mode": "IDEMPOTENT_EXACT_HASH",
        "on_already_applied": "VERIFY_HASH_AND_EFFECT_THEN_SKIP",
        "on_hash_mismatch": "STOP_NO_MUTATION"
      }
    },
    "half_failure_policy": {
      "const": {
        "mode": "STOP_VERIFY_RESUME_FIRST_UNVERIFIED",
        "checkpoint_after_each_artifact": true,
        "automatic_destructive_rollback": false
      }
    },
    "compatibility_policy": {
      "const": {
        "legacy_read": "PRESERVE",
        "legacy_write": "PRESERVE",
        "new_writers": "DEFAULT_OFF_UNTIL_POST_APPLY_VERIFICATION",
        "rollback": "DISABLE_NEW_WRITERS_PRESERVE_FACTS_NO_DROP"
      }
    },
    "blocking_codes": {
      "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "apply_allowed": {"type": "boolean"},
    "default_runtime_state": {"const": "off"},
    "shared_infrastructure_touched": {"const": false},
    "production_applied": {"const": false},
    "allowed_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "probe": {
      "type": "object",
      "required": ["path", "exists", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "upstream": {
      "allOf": [
        {"$ref": "#/$defs/probe"},
        {
          "type": "object",
          "required": ["status", "candidate_id"],
          "properties": {
            "status": {"type": ["string", "null"]},
            "candidate_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apply_order", "kind", "path", "exists", "sha256",
        "responsible_milestone", "safety_class", "destructive_findings",
        "approval_status"
      ],
      "properties": {
        "apply_order": {"type": "integer", "minimum": 1, "maximum": 6},
        "kind": {"enum": ["postgres_migration", "clickhouse_migration", "kafka_catalog", "kafka_topic_plan", "kafka_acl_plan"]},
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "responsible_milestone": {"type": "string", "pattern": "^T1-M09(?:-N[0-9]{3})?$"},
        "safety_class": {"enum": ["ADDITIVE_STATIC", "NON_ADDITIVE_BLOCKED", "MISSING"]},
        "destructive_findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "approval_status": {"const": "PENDING_CURRENT_CANDIDATE_RECEIPTS"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "AUTHORIZED"}}},
      "then": {
        "properties": {
          "candidate_id": {"$ref": "#/$defs/sha256"},
          "blocking_codes": {"maxItems": 0},
          "apply_allowed": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "BLOCKED_UNAPPROVED"}}},
      "then": {
        "properties": {
          "blocking_codes": {"minItems": 1},
          "apply_allowed": {"const": false}
        }
      }
    }
  ]
}
