{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/task-current-evidence-index.schema.json",
  "title": "Immutable current evidence index for one parent task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "milestone_id", "terminal_task_idx_pr_id",
    "candidate_manifest_sha256", "profile_id", "environment_id", "status",
    "completion_candidate", "task_idx_acceptance_receipt", "dependency_task_indexes",
    "leaf_result_sha256s", "external_receipt_sha256s", "evidence_manifest_sha256s",
    "rollback_manifest_sha256s", "output_artifact_sha256s", "created_at", "supersedes_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^T1-M[0-9]{2}-N[0-9]{3}$"},
    "milestone_id": {"type": "string", "pattern": "^T1-M[0-9]{2}$"},
    "terminal_task_idx_pr_id": {"type": "string", "minLength": 1},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "minLength": 1},
    "environment_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "completion_candidate": {"$ref": "#/$defs/hashed_ref"},
    "task_idx_acceptance_receipt": {"$ref": "#/$defs/hashed_ref"},
    "dependency_task_indexes": {"type": "array", "items": {"$ref": "#/$defs/hashed_ref"}, "uniqueItems": true},
    "leaf_result_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "external_receipt_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "evidence_manifest_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "rollback_manifest_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "output_artifact_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "created_at": {"type": "string", "minLength": 1},
    "supersedes_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "hashed_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
