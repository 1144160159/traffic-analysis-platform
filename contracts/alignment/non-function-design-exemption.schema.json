{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/non-function-design-exemption.schema.json",
  "title": "Signed non-function design exemption receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "exemption_id", "atomic_pr_id",
    "candidate", "surface_kind", "exemption_reason_code", "target_locators",
    "target_locator_exact_set_sha256", "specialized_contract_ref",
    "verification_plan_ref", "rollback_plan_ref", "review_disposition",
    "unresolved_p0", "signed_payload_sha256", "attestations", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "NON_FUNCTION_DESIGN_EXEMPTION_RECEIPT"},
    "exemption_id": {"type": "string", "pattern": "^NFDE-[A-Za-z0-9._-]+$"},
    "atomic_pr_id": {"type": "string", "pattern": "^T1-M[0-9]{2}(?:-R[0-9]{2})?-P[0-9]{3}-[A-Z-]+-[a-z0-9-]+$"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "surface_kind": {
      "enum": [
        "PROTO_CONTRACT", "STRUCTURED_CONFIG", "SQL_MIGRATION",
        "DEPLOYMENT_SCRIPT", "EVIDENCE_OR_INDEX_OUTPUT", "OTHER_DECLARATIVE_ARTIFACT"
      ]
    },
    "exemption_reason_code": {
      "enum": [
        "DECLARATIVE_CONTRACT_REQUIRES_SPECIALIZED_REVIEW",
        "MIGRATION_REQUIRES_DATA_REVIEW",
        "DEPLOYMENT_SURFACE_REQUIRES_OPERATIONS_REVIEW",
        "EVIDENCE_OUTPUT_HAS_NO_EXECUTABLE_CODE_UNIT"
      ]
    },
    "target_locators": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "target_locator_exact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "specialized_contract_ref": {"$ref": "#/$defs/typed_ref"},
    "verification_plan_ref": {"$ref": "#/$defs/typed_ref"},
    "rollback_plan_ref": {"$ref": "#/$defs/typed_ref"},
    "review_disposition": {"const": "APPROVED"},
    "unresolved_p0": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "signed_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attestations": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"$ref": "#/$defs/attestation"}
    },
    "proof_ceiling": {"const": "NON_FUNCTION_DESIGN_EXEMPTION_ONLY_NOT_EXECUTION_IMPLEMENTATION_TEST_OR_ACCEPTANCE"}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "manifest_path", "manifest_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "typed_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "path", "sha256", "candidate_manifest_sha256"],
      "properties": {
        "artifact_kind": {"type": "string", "minLength": 3},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "reviewer_identity", "payload_sha256", "policy_id", "signature_artifact_ref"],
      "properties": {
        "role": {"enum": ["DOMAIN_OWNER", "QA_SRE_PERFORMANCE_EXPERT", "MAINTAINABILITY_RED_TEAM", "ADJUDICATOR"]},
        "reviewer_identity": {"type": "string", "minLength": 3},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_id": {"type": "string", "minLength": 3},
        "signature_artifact_ref": {"$ref": "#/$defs/hash_ref"}
      }
    },
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
