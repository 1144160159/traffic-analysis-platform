{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-probe-control-ack-function-design.schema.json",
  "title": "M02 probe control and ACK candidate-bound function design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "candidate", "preview_catalog_ref", "append_only_resolution",
    "leaf_bindings", "append_only_leaf_bindings", "current_static_findings", "authority_state_machine", "ack_acceptance_contract",
    "function_contracts", "append_only_gap_resolutions", "sequencing", "negative_tests",
    "rollback", "claims", "blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_PROBE_CONTROL_ACK_FUNCTION_DESIGN"},
    "artifact_status": {"const": "CANDIDATE_BOUND_STATIC_DESIGN_GAPS_ALLOCATED_IN_V2_PREVIEW_EXECUTION_BLOCKED"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "preview_catalog_ref": {"$ref": "#/$defs/hash_ref"},
    "append_only_resolution": {"$ref": "#/$defs/append_only_resolution"},
    "leaf_bindings": {"type": "array", "minItems": 23, "maxItems": 23, "items": {"$ref": "#/$defs/leaf_binding"}, "uniqueItems": true},
    "append_only_leaf_bindings": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/append_only_leaf_binding"}, "uniqueItems": true},
    "current_static_findings": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/finding"}, "uniqueItems": true},
    "authority_state_machine": {"$ref": "#/$defs/state_machine"},
    "ack_acceptance_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_scope", "applied_scope", "legacy_field", "deletion_barrier", "forbidden_interpretation"],
      "properties": {
        "accepted_scope": {"const": "GATEWAY_KAFKA_ACKED_AND_REVISION_MATCHED_DELIVERY_CACHE_RELEASED"},
        "applied_scope": {"const": "AGENT_TERMINAL_RESULT_RECORDED_BY_POSTGRESQL_AUTHORITY"},
        "legacy_field": {"const": "accepted_ack_operation_ids is a compatibility projection of accepted receipts and never means applied true"},
        "deletion_barrier": {"const": "Agent deletes a local ACK only for its exact operation ID and command revision after the Gateway returns an accepted receipt"},
        "forbidden_interpretation": {"const": "Kafka ACK Redis deletion or accepted ID alone is not PostgreSQL acceptance application success lifecycle projection or site acceptance"}
      }
    },
    "function_contracts": {"type": "array", "minItems": 23, "maxItems": 23, "items": {"$ref": "#/$defs/function_contract"}, "uniqueItems": true},
    "append_only_gap_resolutions": {"type": "array", "minItems": 31, "maxItems": 31, "items": {"$ref": "#/$defs/gap_resolution"}, "uniqueItems": true},
    "sequencing": {"type": "array", "minItems": 23, "maxItems": 23, "items": {"$ref": "#/$defs/sequence_step"}, "uniqueItems": true},
    "negative_tests": {"type": "array", "minItems": 34, "maxItems": 34, "items": {"$ref": "#/$defs/test_case"}, "uniqueItems": true},
    "rollback": {"$ref": "#/$defs/rollback"},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "forbidden", "proof_ceiling"],
      "properties": {
        "allowed": {"const": "candidate-bound static desired-operation delivery ACK authority lifecycle projection and rollout ordering design exists for M02 N012"},
        "forbidden": {"type": "array", "minItems": 10, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "proof_ceiling": {"const": "STATIC_DESIGN_ONLY_GAPS_ALLOCATED_V2_PREVIEW_NOT_IMPLEMENTED_FUNCTION_REVIEWED_BROKER_TESTED_ROLLED_OUT_OR_AUTHORIZED"}
      }
    },
    "blockers": {"type": "array", "minItems": 10, "items": {"type": "string", "minLength": 8}, "uniqueItems": true}
  },
  "$defs": {
    "candidate": {"type": "object", "additionalProperties": false, "required": ["commit", "source_blob_sha256"], "properties": {
      "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "source_blob_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }},
    "hash_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
      "path": {"type": "string", "minLength": 3}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }},
    "append_only_resolution": {"type": "object", "additionalProperties": false, "required": ["path", "revision_id", "allocation_epoch", "status"], "properties": {
      "path": {"const": "contracts/alignment/m02-code-direct-leaf-allocation.v2.json"},
      "revision_id": {"const": "M02-CODE-DIRECT-V2"},
      "allocation_epoch": {"const": "T1-M02-P308-P506"},
      "status": {"const": "ALLOCATED_V2_PREVIEW_NOT_IMPLEMENTED"}
    }},
    "leaf_binding": {"type": "object", "additionalProperties": false, "required": ["leaf_id", "atomic_pr_id", "role", "locator"], "properties": {
      "leaf_id": {"type": "string", "pattern": "^M02-N012-L(?:0[1-9]|1[0-9]|2[0-3])$"},
      "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P(?:25[0-9]|26[0-9]|27[0-2])-(?:CTR|WRT|PRJ|REF|TST-PRE|IDX)-n012-l(?:0[1-9]|1[0-9]|2[0-3])$"},
      "role": {"type": "string", "minLength": 3}, "locator": {"type": "string", "minLength": 3}
    }},
    "append_only_leaf_binding": {"type": "object", "additionalProperties": false, "required": ["leaf_id", "atomic_pr_id", "role", "locator"], "properties": {
      "leaf_id": {"type": "string", "pattern": "^M02-N012-L(?:66|69|78|90|99|102|105|108|111|114|117)$"},
      "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P(?:450|456|465|477|486|489|492|495|498|501|504)-WRT-n012-l(?:66|69|78|90|99|102|105|108|111|114|117)$"},
      "role": {"type": "string", "minLength": 3}, "locator": {"type": "string", "minLength": 3}
    }},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "severity", "path", "symbol", "evidence", "consequence", "evidence_kind"], "properties": {
      "finding_id": {"type": "string", "pattern": "^M02-PROBE-CTRL-(?:P0|P1)-[0-9]{2}$"},
      "severity": {"enum": ["P0", "P1"]}, "path": {"type": "string", "minLength": 3}, "symbol": {"type": "string", "minLength": 3},
      "evidence": {"type": "string", "minLength": 8}, "consequence": {"type": "string", "minLength": 8},
      "evidence_kind": {"const": "CURRENT_WORKTREE_STATIC_EVIDENCE_NOT_RUNTIME_REPRODUCTION"}
    }},
    "state_machine": {"type": "object", "additionalProperties": false, "required": ["states", "transitions", "invariants"], "properties": {
      "states": {"type": "array", "minItems": 16, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
      "transitions": {"type": "array", "minItems": 16, "items": {"$ref": "#/$defs/transition"}, "uniqueItems": true},
      "invariants": {"type": "array", "minItems": 12, "items": {"type": "string", "minLength": 8}, "uniqueItems": true}
    }},
    "transition": {"type": "object", "additionalProperties": false, "required": ["from", "event", "to", "barrier"], "properties": {
      "from": {"type": "string", "minLength": 3}, "event": {"type": "string", "minLength": 3}, "to": {"type": "string", "minLength": 3}, "barrier": {"type": "string", "minLength": 3}
    }},
    "function_contract": {"type": "object", "additionalProperties": false, "required": [
      "contract_id", "leaf_id", "language", "path", "qualified_symbol", "change_kind", "signature_before", "signature_after",
      "responsibility", "inputs", "outputs", "body_steps", "error_branches", "atomicity", "idempotency", "callers", "callees", "tests", "rollback"
    ], "properties": {
      "contract_id": {"type": "string", "pattern": "^FC-M02-PROBE-CTRL-[A-Za-z0-9-]+$"},
      "leaf_id": {"type": "string", "pattern": "^M02-N012-L(?:0[5-9]|1[014568]|20|66|69|78|90|99|102|105|108|111|114|117)$"},
      "language": {"enum": ["go", "rust"]}, "path": {"type": "string", "minLength": 3}, "qualified_symbol": {"type": "string", "minLength": 3},
      "change_kind": {"enum": ["modify", "new_companion"]}, "signature_before": {"type": ["string", "null"], "minLength": 3}, "signature_after": {"type": "string", "minLength": 8},
      "responsibility": {"type": "string", "minLength": 8}, "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
      "body_steps": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^B[0-9]{2} .+"}, "uniqueItems": true},
      "error_branches": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
      "atomicity": {"type": "string", "minLength": 8}, "idempotency": {"type": "string", "minLength": 8},
      "callers": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
      "callees": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
      "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TC-M02-PROBE-CTRL-[0-9]{2}$"}, "uniqueItems": true},
      "rollback": {"type": "string", "minLength": 8}
    }},
    "gap_resolution": {"type": "object", "additionalProperties": false, "required": ["gap_id", "required_locators", "single_result", "reason", "resolution", "status"], "properties": {
      "gap_id": {"type": "string", "pattern": "^M02-PROBE-CTRL-GAP-(?:0[1-9]|[12][0-9]|3[01])$"},
      "required_locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
      "single_result": {"type": "string", "minLength": 8}, "reason": {"type": "string", "minLength": 8}, "resolution": {"type": "string", "minLength": 8},
      "status": {"const": "ALLOCATED_V2_PREVIEW_NOT_IMPLEMENTED"}
    }},
    "sequence_step": {"type": "object", "additionalProperties": false, "required": ["order", "leaf_id", "precondition", "result", "activation"], "properties": {
      "order": {"type": "integer", "minimum": 1}, "leaf_id": {"type": "string", "pattern": "^M02-N012-L(?:0[1-9]|1[0-9]|2[0-3])$"},
      "precondition": {"type": "string", "minLength": 3}, "result": {"type": "string", "minLength": 3}, "activation": {"type": "string", "minLength": 3}
    }},
    "test_case": {"type": "object", "additionalProperties": false, "required": ["case_id", "kind", "injection", "oracle", "execution_status"], "properties": {
      "case_id": {"type": "string", "pattern": "^TC-M02-PROBE-CTRL-[0-9]{2}$"},
      "kind": {"enum": ["negative", "fault", "replay", "compatibility", "property", "broker", "security", "startup"]},
      "injection": {"type": "string", "minLength": 3}, "oracle": {"type": "string", "minLength": 8}, "execution_status": {"const": "NOT_RUN"}
    }},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["entrypoint", "steps", "durable_data_policy", "irreversible_boundary"], "properties": {
      "entrypoint": {"type": "string", "minLength": 3}, "steps": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
      "durable_data_policy": {"type": "string", "minLength": 8}, "irreversible_boundary": {"type": "string", "minLength": 8}
    }}
  }
}
