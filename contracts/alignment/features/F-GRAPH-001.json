{
  "feature_id": "F-GRAPH-001",
  "contract_version": 1,
  "status": "draft",
  "compatibility": {
    "preserved_routes": ["/graph"],
    "preserved_actions": [],
    "preserved_api_operations": [],
    "preserved_query_states": ["entity_type", "relation_type", "start_time", "end_time", "max_depth", "limit"],
    "strategy": "expand-migrate-contract"
  },
  "ui": {
    "query_id": "graph.neighborhood.query",
    "controls": [],
    "states": ["loading", "empty", "success", "partial", "stale", "forbidden", "failed"]
  },
  "api": {
    "operation_id": "exploreBoundedGraph",
    "method": "GET",
    "path": "/v1/graph/explore",
    "response_envelope": "data-meta-error",
    "async": false
  },
  "domain": {
    "kind": "query",
    "invariants": [
      "time, type, risk, start node, depth and result limits are pushed to storage",
      "every query has node, edge, depth, duration and serialized-size budgets",
      "over-budget results return explicit truncated or partial metadata"
    ]
  },
  "data": {
    "authoritative_store": "external",
    "read_models": ["nebulagraph", "postgresql", "clickhouse", "redis"],
    "migration": "add query indexes and structured GraphQuery without deleting existing graph paths",
    "source_watermarks": ["nebulagraph.projection.version", "postgresql.graph_outbox.id", "clickhouse.flow.watermark"]
  },
  "permissions": {
    "tenant_source": "authenticated_identity",
    "required_scopes": ["graph:read"],
    "negative_tests": ["cross-tenant start node is not observable", "graph-only role receives no restricted asset fields"]
  },
  "performance": {
    "baseline_required": true,
    "journeys": ["two-hop neighborhood", "three-hop path", "large-tenant truncated result"],
    "stop_conditions": ["query memory, scan, duration or serialization budget is exceeded"]
  },
  "acceptance": {
    "tests": ["G0 GraphQuery contract", "G1 budget and truncation", "G2 real Nebula query", "G3 edge/source reconcile", "G4 large-tenant profile", "G5 Windows Chrome bounded-query state"],
    "evidence": ["nGQL profile proves filter pushdown and UI/API show identical truncation metadata"]
  },
  "rollout": {
    "feature_flag": "graph_bounded_query_v1",
    "strategy": "shadow-read",
    "rollback_runbook": "doc/07_alignment/runbooks/F-GRAPH-001-rollback.md"
  }
}
