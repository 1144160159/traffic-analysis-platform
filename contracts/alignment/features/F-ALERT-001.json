{
  "feature_id": "F-ALERT-001",
  "contract_version": 1,
  "status": "verifying",
  "compatibility": {
    "preserved_routes": ["/alerts", "/alerts/:alertId"],
    "preserved_actions": ["alert-report-export", "alert-report-cancel", "alert-report-compensate"],
    "preserved_api_operations": ["GET /v1/alerts/{id}/reports/{job_id}", "GET /v1/alerts/{id}/reports/{job_id}/download", "POST /v1/alerts/{id}/reports/export", "POST /v1/alerts/{id}/reports/{job_id}/cancel", "POST /v1/alerts/{id}/reports/{job_id}/compensations"],
    "strategy": "additive"
  },
  "ui": {
    "query_id": "alert.report.job",
    "controls": [{"control_id": "alert-detail-report-export", "action_id": "alert-report-export"}, {"control_id": "alert-detail-report-cancel", "action_id": "alert-report-cancel"}, {"control_id": "alert-detail-report-compensate", "action_id": "alert-report-compensate"}],
    "states": ["loading", "accepted", "running", "cancel_requested", "success", "partial", "failed", "cancelled", "compensating", "compensated", "compensation_failed"]
  },
  "api": {
    "operation_id": "createAlertReport",
    "method": "POST",
    "path": "/v1/alerts/{id}/reports/export",
    "response_envelope": "data-meta-error",
    "async": true,
    "idempotency_key": "Idempotency-Key",
    "revision_field": "snapshot_id"
  },
  "domain": {
    "kind": "command",
    "invariants": [
      "report requests never write an investigation note as a substitute",
      "one deterministic report model freezes alert, evidence, timeline, asset, response and audit sections",
      "missing sections are explicit and never filled with simulation content"
    ],
    "states": ["accepted", "running", "cancel_requested", "completed", "partial", "failed", "cancelled", "compensating", "compensated", "compensation_failed"],
    "compensation": "cooperatively stop a running job and remove only its deterministic temporary object before committing cancelled; cleanup failure remains non-success and is retried"
  },
  "data": {
    "authoritative_store": "postgresql",
    "read_models": ["postgresql", "clickhouse", "opensearch", "minio"],
    "migration": "deployments/postgres/migrations/202607301945_alert_report_jobs.sql",
    "event_types": ["traffic.alert.v2.AlertReportRequested", "traffic.alert.v2.AlertReportRunning", "traffic.alert.v2.AlertReportCancelRequested", "traffic.alert.v2.AlertReportCancelled", "traffic.alert.v2.AlertReportCompensationRequested", "traffic.alert.v2.AlertReportCompensated", "traffic.alert.v2.AlertReportCompleted"],
    "source_watermarks": ["postgresql.alert_report_jobs.revision", "postgresql.alerts.revision", "clickhouse.detection_events.watermark", "opensearch.alerts.projection_version"]
  },
  "permissions": {
    "tenant_source": "authenticated_identity",
    "required_scopes": ["alert:export"],
    "negative_tests": ["other tenant alert returns not found", "object download cannot be enumerated without alert:export", "stale revision and terminal cancellation return conflict"]
  },
  "performance": {
    "baseline_required": true,
    "journeys": ["small alert report", "partial evidence report", "duplicate request reuse", "accepted cancel", "running cooperative cancel and object cleanup", "residual object compensation retry"],
    "stop_conditions": ["object manifest mismatch or report queue resource budget breach"]
  },
  "acceptance": {
    "tests": ["G0 endpoint and client contract", "G1 deterministic report model and revisioned cancellation", "G2 real PostgreSQL and MinIO", "G3 report snapshot and cancellation reconcile", "G4 report queue profile", "G5 Windows Chrome create-status-download-cancel"],
    "evidence": ["HAR contains report endpoints and never investigation-notes; manifest sha256 matches downloaded object; cancelled jobs have history, outbox and audit with no residual object manifest"]
  },
  "rollout": {
    "feature_flag": "alert_report_jobs_v1",
    "strategy": "canary",
    "rollback_runbook": "doc/07_alignment/runbooks/F-ALERT-001-rollback.md"
  }
}
