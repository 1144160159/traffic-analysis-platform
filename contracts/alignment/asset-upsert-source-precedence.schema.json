{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/asset-upsert-source-precedence.schema.json",
  "title": "Asset upsert action-class field precedence contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "contract_id", "status", "owner_role",
    "candidate_manifest_sha256", "actions", "field_rules", "global_invariants",
    "rejected_cases", "approval_blockers", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "ASSET_UPSERT_SOURCE_PRECEDENCE"},
    "contract_id": {"const": "ASSET-UPsert-SOURCE-PRECEDENCE-V1"},
    "status": {"enum": ["PROPOSED_DOMAIN_REVIEW", "APPROVED"]},
    "owner_role": {"const": "multi-source-data-owner"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actions": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["asset-upsert", "asset-observation-upsert"]}
    },
    "field_rules": {"type": "array", "minItems": 22, "items": {"$ref": "#/$defs/field_rule"}, "uniqueItems": true},
    "global_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
    "rejected_cases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
    "approval_blockers": {"type": "array", "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
    "proof_ceiling": {"const": "PROPOSED_DOMAIN_CONTRACT_ONLY_NOT_IMPLEMENTATION_OR_EXECUTION_AUTHORIZATION"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "APPROVED"}}},
      "then": {"properties": {"approval_blockers": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "field_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "class", "create_manual", "update_manual", "create_observation", "update_observation", "stale_observation", "oracle_ids"],
      "properties": {
        "field": {"type": "string", "minLength": 2},
        "class": {"enum": ["IDENTITY", "GOVERNANCE", "OBSERVATION", "SERVER_MANAGED"]},
        "create_manual": {"type": "string", "minLength": 3},
        "update_manual": {"type": "string", "minLength": 3},
        "create_observation": {"type": "string", "minLength": 3},
        "update_observation": {"type": "string", "minLength": 3},
        "stale_observation": {"type": "string", "minLength": 3},
        "oracle_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}, "uniqueItems": true}
      }
    }
  }
}
