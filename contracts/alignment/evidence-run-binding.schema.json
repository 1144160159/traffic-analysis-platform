{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/evidence-run-binding.schema.json",
  "title": "Evidence run exact candidate binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "subject_pr_id", "subject_work_id", "subject_milestone_id",
    "execution_package_sha256", "plan_kind", "plan_id", "plan_sha256", "bom_transition_sha256",
    "candidate_manifest_sha256", "profile_id", "environment_id", "time_window", "run_purpose",
    "gate_id", "result", "artifacts", "manifest_path", "manifest_sha256", "production_applied", "exclusions"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "subject_pr_id": {"type": "string", "pattern": "^T1-M[0-9]{2}(?:-R[0-9]{2})?-P[0-9]{3}-[A-Z-]+-[a-z0-9-]+$"},
    "subject_work_id": {"type": "string", "pattern": "^T1-M[0-9]{2}-(?:N[0-9]{3}|R[0-9]{2})$"},
    "subject_milestone_id": {"type": "string", "pattern": "^T1-M[0-9]{2}$"},
    "execution_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_kind": {"enum": ["TEST", "EVIDENCE", "ROLLBACK", "OBSERVATION"]},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bom_transition_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "minLength": 1},
    "environment_id": {"type": "string", "minLength": 1},
    "time_window": {"type": "string", "minLength": 1},
    "run_purpose": {"enum": ["VERIFICATION", "ROLLBACK_REHEARSAL", "OBSERVATION", "RECONCILIATION", "EXTERNAL_ATTESTATION"]},
    "gate_id": {"type": "string", "pattern": "^G[0-8]$"},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}, "uniqueItems": true},
    "manifest_path": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "production_applied": {"type": "boolean"},
    "exclusions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "artifact_id", "path", "sha256", "schema_ref"],
      "properties": {
        "direction": {"enum": ["INPUT", "OUTPUT"]},
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_ref": {"type": ["string", "null"]}
      }
    }
  }
}
