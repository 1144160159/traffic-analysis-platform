{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m01-early-trust-train-catalog.schema.json",
  "title": "M01 early trusted-verifier candidate catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "revision_id",
    "allocation_ledger", "active_catalog_refs", "active_m01_projection_freeze",
    "source_m01_leaf_count", "superseded_leaf_count", "appended_leaf_count",
    "candidate_m01_leaf_count", "retained_atomic_pr_ids", "supersession_tombstones",
    "candidate_leaves", "candidate_m01_atomic_id_sha256", "candidate_edges",
    "dependency_revisions", "task_dependency_revisions", "completion_revisions",
    "global_switch_gate", "validation", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M01_EARLY_TRUST_TRAIN_CANDIDATE_CATALOG"},
    "artifact_status": {"const": "VERSIONED_PREVIEW_NOT_GLOBAL_REGISTRY"},
    "revision_id": {"const": "M01-EARLY-TRUST-V1"},
    "allocation_ledger": {"$ref": "#/$defs/hash_ref"},
    "active_catalog_refs": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash_ref"}
    },
    "active_m01_projection_freeze": {"type": "object"},
    "source_m01_leaf_count": {"const": 56},
    "superseded_leaf_count": {"const": 9},
    "appended_leaf_count": {"const": 10},
    "candidate_m01_leaf_count": {"const": 57},
    "retained_atomic_pr_ids": {
      "type": "array", "minItems": 47, "maxItems": 47, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^T1-M01-P[0-9]{3}-[A-Z-]+-.+$"}
    },
    "supersession_tombstones": {
      "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
      "items": {"type": "object"}
    },
    "candidate_leaves": {
      "type": "array", "minItems": 57, "maxItems": 57,
      "items": {"$ref": "#/$defs/leaf"}
    },
    "candidate_m01_atomic_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_edges": {
      "type": "array", "minItems": 50, "uniqueItems": true,
      "items": {"$ref": "#/$defs/edge"}
    },
    "dependency_revisions": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true},
    "task_dependency_revisions": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true},
    "completion_revisions": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true},
    "global_switch_gate": {"$ref": "#/$defs/switch_gate"},
    "validation": {"$ref": "#/$defs/validation"},
    "proof_ceiling": {"const": "VERSIONED_STATIC_PREVIEW_ONLY_NOT_GLOBAL_REGISTRATION_FUNCTION_REVIEW_IMPLEMENTATION_FIXTURE_CREATION_DEPLOYMENT_TEST_EXECUTION_TRUST_PASS_AUTHORIZATION_OR_ACCEPTANCE"}
  },
  "$defs": {
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "leaf": {
      "type": "object", "additionalProperties": false,
      "required": [
        "atomic_pr_id", "parent_work_id", "pr_type", "phase", "source_kind",
        "write_locators", "target_state", "dependency_ids", "required_gates",
        "single_outcome", "terminal_task_idx", "formal_execution_status"
      ],
      "properties": {
        "atomic_pr_id": {"type": "string", "pattern": "^T1-M01-P[0-9]{3}-[A-Z-]+-.+$"},
        "parent_work_id": {"type": "string", "pattern": "^T1-M01-N[0-9]{3}$"},
        "pr_type": {"enum": ["CTR", "EXP", "PRJ", "WRT", "REF", "OPS", "TST-PRE", "TST-POST", "IDX", "PROM"]},
        "phase": {"type": "string", "minLength": 3},
        "source_kind": {"enum": ["RETAINED_ACTIVE_ID_AND_WRITE_SCOPE", "APPENDED_PREVIEW_V1"]},
        "write_locators": {
          "type": "array", "minItems": 1, "maxItems": 17, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "target_state": {"enum": ["PLANNED", "PLANNED_OUTPUT"]},
        "dependency_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "single_outcome": {"type": "string", "minLength": 8},
        "terminal_task_idx": {"type": "boolean"},
        "formal_execution_status": {"const": "BLOCKED_UNTIL_GLOBAL_REGISTRY_TARGET_BINDING_FUNCTION_REVIEW_AND_SIGNED_OVERLAY"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "edge_kind"],
      "properties": {
        "from": {"type": "string", "pattern": "^T1-M[0-9]{2}-P[0-9]{3}-[A-Z-]+-.+$"},
        "to": {"type": "string", "pattern": "^T1-M01-P[0-9]{3}-[A-Z-]+-.+$"},
        "edge_kind": {"enum": ["RETAINED_ACTIVE", "REVISED_DEPENDENCY", "APPENDED_PREREQUISITE"]}
      }
    },
    "switch_gate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "decision", "active_global_atomic_pr_count", "active_m01_atomic_pr_count",
        "candidate_m01_atomic_pr_count", "candidate_global_atomic_pr_count",
        "candidate_global_atomic_id_sha256", "required_catalogs", "switch_rule"
      ],
      "properties": {
        "decision": {"const": "BLOCKED_PREVIEW_ONLY"},
        "active_global_atomic_pr_count": {"const": 1289},
        "active_m01_atomic_pr_count": {"const": 56},
        "candidate_m01_atomic_pr_count": {"const": 57},
        "candidate_global_atomic_pr_count": {"const": 1290},
        "candidate_global_atomic_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "required_catalogs": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "switch_rule": {"const": "TASK_CLAIM_PR_DESIGN_AND_OVERLAY_MUST_SWITCH_ATOMICALLY_TO_ONE_REVIEWED_CANDIDATE_HASH"}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "active_catalog_hashes", "active_four_catalog_exact_set",
        "active_m01_projection_exact", "old_id_preservation", "append_id_exact",
        "supersession_exact", "candidate_write_locator_unique", "dependency_revision_exact",
        "completion_revision_exact", "p006_back_edge_absent", "candidate_dag",
        "global_switch_blocked", "mutation_guards"
      ],
      "properties": {
        "schema": {"const": "PASS"},
        "active_catalog_hashes": {"const": "PASS"},
        "active_four_catalog_exact_set": {"const": "PASS"},
        "active_m01_projection_exact": {"const": "PASS"},
        "old_id_preservation": {"const": "PASS_TOMBSTONES_AND_NO_REUSE"},
        "append_id_exact": {"const": "PASS_P057_P066"},
        "supersession_exact": {"const": "PASS"},
        "candidate_write_locator_unique": {"const": true},
        "dependency_revision_exact": {"const": "PASS"},
        "completion_revision_exact": {"const": "PASS"},
        "p006_back_edge_absent": {"const": true},
        "candidate_dag": {"const": "PASS"},
        "global_switch_blocked": {"const": true},
        "mutation_guards": {
          "type": "object", "additionalProperties": false,
          "required": [
            "active_projection_drift", "append_id_reuse", "supersession_omission",
            "locator_reuse", "locator_transfer_drift", "p005_trust_dependency_omission",
            "p006_back_edge", "retired_dependency_reintroduced", "completion_omission",
            "task_dependency_drift", "dag_cycle", "semantic_pin_drift",
            "global_catalog_exact_set"
          ],
          "properties": {
            "active_projection_drift": {"const": "PASS"},
            "append_id_reuse": {"const": "PASS"},
            "supersession_omission": {"const": "PASS"},
            "locator_reuse": {"const": "PASS"},
            "locator_transfer_drift": {"const": "PASS"},
            "p005_trust_dependency_omission": {"const": "PASS"},
            "p006_back_edge": {"const": "PASS"},
            "retired_dependency_reintroduced": {"const": "PASS"},
            "completion_omission": {"const": "PASS"},
            "task_dependency_drift": {"const": "PASS"},
            "dag_cycle": {"const": "PASS"},
            "semantic_pin_drift": {"const": "PASS"},
            "global_catalog_exact_set": {"const": "PASS"}
          }
        }
      }
    }
  }
}
