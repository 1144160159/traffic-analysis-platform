{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-function-review-coverage.schema.json",
  "title": "M02 per-leaf function review input coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "source_catalog",
    "source_designs", "review_receipt_schema", "review_receipt_validator", "non_function_exemption_schema", "non_function_exemption_validator",
    "shared_locator_ownership", "write_scope_supersession", "contract_owner_rebindings", "leaf_count", "function_set_leaf_count",
    "non_function_set_leaf_count", "static_leaf_binding_count",
    "static_function_contract_leaf_count", "static_function_contract_row_count",
    "status_counts", "approved_evidence_counts", "leaf_reviews",
    "validation", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_FUNCTION_REVIEW_INPUT_COVERAGE"},
    "artifact_status": {"const": "BLOCKED_REVIEW_INPUTS_INCOMPLETE"},
    "source_catalog": {"$ref": "#/$defs/hash_ref"},
    "source_designs": {
      "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash_ref"}
    },
    "review_receipt_schema": {"$ref": "#/$defs/hash_ref"},
    "review_receipt_validator": {"$ref": "#/$defs/validator_ref"},
    "non_function_exemption_schema": {"$ref": "#/$defs/hash_ref"},
    "non_function_exemption_validator": {"$ref": "#/$defs/validator_ref"},
    "shared_locator_ownership": {"$ref": "#/$defs/hash_ref"},
    "write_scope_supersession": {"$ref": "#/$defs/hash_ref"},
    "contract_owner_rebindings": {"$ref": "#/$defs/hash_ref"},
    "leaf_count": {"const": 425},
    "function_set_leaf_count": {"const": 255},
    "non_function_set_leaf_count": {"const": 170},
    "static_leaf_binding_count": {"const": 88},
    "static_function_contract_leaf_count": {"const": 66},
    "static_function_contract_row_count": {"const": 66},
    "status_counts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "FUNCTION_STATIC_DRAFT_INPUT", "FUNCTION_CONTRACT_LOCATOR_SCOPE_MISMATCH",
        "FUNCTION_CONTRACT_WITHOUT_LEAF_BINDING", "FUNCTION_BINDING_WITHOUT_CONTRACT",
        "FUNCTION_REVIEW_INPUT_MISSING", "NON_FUNCTION_STATIC_DRAFT_INPUT",
        "NON_FUNCTION_EXEMPTION_INPUT_MISSING"
      ],
      "properties": {
        "FUNCTION_STATIC_DRAFT_INPUT": {"const": 66},
        "FUNCTION_CONTRACT_LOCATOR_SCOPE_MISMATCH": {"const": 0},
        "FUNCTION_CONTRACT_WITHOUT_LEAF_BINDING": {"const": 0},
        "FUNCTION_BINDING_WITHOUT_CONTRACT": {"const": 6},
        "FUNCTION_REVIEW_INPUT_MISSING": {"const": 183},
        "NON_FUNCTION_STATIC_DRAFT_INPUT": {"const": 16},
        "NON_FUNCTION_EXEMPTION_INPUT_MISSING": {"const": 154}
      }
    },
    "approved_evidence_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["unified_function_review_receipts", "signed_non_function_exemptions", "review_complete_leaves"],
      "properties": {
        "unified_function_review_receipts": {"const": 0},
        "signed_non_function_exemptions": {"const": 0},
        "review_complete_leaves": {"const": 0}
      }
    },
    "leaf_reviews": {
      "type": "array", "minItems": 425, "maxItems": 425, "uniqueItems": true,
      "items": {"$ref": "#/$defs/leaf_review"}
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_exact", "leaf_exact_set", "surface_partition_exact",
        "design_binding_exact_set", "function_contract_exact_set",
        "contract_locator_scope_checked", "no_unsigned_draft_claimed_reviewed",
        "shared_locator_blocker_propagated", "contract_owner_rebinding_exact", "mutation_guards"
      ],
      "properties": {
        "source_exact": {"const": "PASS"},
        "leaf_exact_set": {"const": "PASS"},
        "surface_partition_exact": {"const": "PASS"},
        "design_binding_exact_set": {"const": "PASS"},
        "function_contract_exact_set": {"const": "PASS"},
        "contract_locator_scope_checked": {"const": "PASS"},
        "no_unsigned_draft_claimed_reviewed": {"const": true},
        "shared_locator_blocker_propagated": {"const": true},
        "contract_owner_rebinding_exact": {"const": "PASS"},
        "mutation_guards": {
          "type": "object", "additionalProperties": false,
          "required": [
            "leaf_omission", "surface_kind_drift", "status_drift",
            "false_approved_count", "contract_ref_omission", "shared_blocker_omission"
          ],
          "properties": {
            "leaf_omission": {"const": "PASS"},
            "surface_kind_drift": {"const": "PASS"},
            "status_drift": {"const": "PASS"},
            "false_approved_count": {"const": "PASS"},
            "contract_ref_omission": {"const": "PASS"},
            "shared_blocker_omission": {"const": "PASS"}
          }
        }
      }
    },
    "proof_ceiling": {"const": "STATIC_REVIEW_INPUT_COVERAGE_ONLY_NOT_LOCATOR_RESOLVED_FUNCTION_REVIEWED_EXEMPTION_APPROVED_IMPLEMENTED_OR_AUTHORIZED"}
  },
  "$defs": {
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "static_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["source_design_path", "source_design_sha256", "role", "locator"],
      "properties": {
        "source_design_path": {"type": "string", "minLength": 1},
        "source_design_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string", "minLength": 3},
        "locator": {"type": "string", "minLength": 3}
      }
    },
    "validator_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "test_command", "status", "positive_case_count", "negative_case_count", "stdout_summary"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "test_command": {"type": "string", "minLength": 3},
        "status": {"const": "PASS"},
        "positive_case_count": {"const": 1},
        "negative_case_count": {"const": 7},
        "stdout_summary": {"type": "string", "pattern": "^PASS (function design review receipt|non-function design exemption):"}
      }
    },
    "static_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["source_design_path", "source_design_sha256", "contract_id", "path", "qualified_symbol", "signature_after", "source_declared_leaf_id", "ownership_resolution", "within_leaf_write_scope"],
      "properties": {
        "source_design_path": {"type": "string", "minLength": 1},
        "source_design_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contract_id": {"type": "string", "minLength": 3},
        "path": {"type": "string", "minLength": 1},
        "qualified_symbol": {"type": "string", "minLength": 1},
        "signature_after": {"type": "string", "minLength": 8},
        "source_declared_leaf_id": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2,3}$"},
        "ownership_resolution": {"enum": ["SOURCE_LEAF", "V3_APPEND_ONLY_OWNER_REBINDING"]},
        "within_leaf_write_scope": {"type": "boolean"}
      }
    },
    "leaf_review": {
      "type": "object", "additionalProperties": false,
      "required": [
        "leaf_id", "atomic_pr_id", "parent_task_id", "pr_type", "target_state",
        "write_locators", "review_surface", "expected_artifact_kind", "expected_artifact_path",
        "static_bindings", "static_function_contracts", "coverage_status", "blocking_reasons"
      ],
      "properties": {
        "leaf_id": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2,3}$"},
        "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P[0-9]{3}-[A-Z-]+-n[0-9]{3}-l[0-9]{2,3}$"},
        "parent_task_id": {"type": "string", "pattern": "^T1-M02-N[0-9]{3}$"},
        "pr_type": {"type": "string", "minLength": 3},
        "target_state": {"enum": ["EXISTING", "PLANNED", "PLANNED_OUTPUT"]},
        "write_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "review_surface": {"enum": ["FUNCTION_SET", "NON_FUNCTION_SET"]},
        "expected_artifact_kind": {"enum": ["FUNCTION_DESIGN_REVIEW_RECEIPT", "NON_FUNCTION_DESIGN_EXEMPTION_RECEIPT"]},
        "expected_artifact_path": {"type": "string", "minLength": 3},
        "static_bindings": {"type": "array", "items": {"$ref": "#/$defs/static_binding"}, "uniqueItems": true},
        "static_function_contracts": {"type": "array", "items": {"$ref": "#/$defs/static_contract"}, "uniqueItems": true},
        "coverage_status": {
          "enum": [
            "FUNCTION_STATIC_DRAFT_INPUT", "FUNCTION_CONTRACT_LOCATOR_SCOPE_MISMATCH",
            "FUNCTION_CONTRACT_WITHOUT_LEAF_BINDING", "FUNCTION_BINDING_WITHOUT_CONTRACT",
            "FUNCTION_REVIEW_INPUT_MISSING", "NON_FUNCTION_STATIC_DRAFT_INPUT",
            "NON_FUNCTION_EXEMPTION_INPUT_MISSING"
          ]
        },
        "blocking_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    }
  }
}
