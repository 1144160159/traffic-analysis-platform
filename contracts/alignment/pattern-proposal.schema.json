{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/pattern-proposal.schema.json",
  "title": "Immutable candidate-bound pattern application proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "proposal_id", "decision_id",
    "atomic_pr_id", "candidate", "catalog_ref", "design_scope", "applicability",
    "trigger_evidence", "problem_evidence", "change_axis", "stable_contract",
    "invariants", "options", "option_set_sha256", "negative_test_manifest_ref",
    "readiness"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "PATTERN_DECISION_PROPOSAL"},
    "artifact_status": {"enum": ["DRAFT", "FROZEN_CANDIDATE"]},
    "proposal_id": {"type": "string", "pattern": "^PROP-T1-M[0-9]{2}(?:-R[0-9]{2})?-P[0-9]{3}-[A-Z-]+-[a-z0-9-]+-r[0-9]+$"},
    "decision_id": {"type": "string", "pattern": "^PAT-T1-M[0-9]{2}(?:-R[0-9]{2})?-P[0-9]{3}-[A-Z-]+-[a-z0-9-]+$"},
    "atomic_pr_id": {"type": "string", "pattern": "^T1-M[0-9]{2}(?:-R[0-9]{2})?-P[0-9]{3}-[A-Z-]+-[a-z0-9-]+$"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "catalog_ref": {"$ref": "#/$defs/typed_hash_ref"},
    "design_scope": {"enum": ["FUNCTION_SET", "NON_FUNCTION_CODE_UNIT", "TARGET_BINDING_ONLY", "NOT_APPLICABLE"]},
    "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
    "trigger_evidence": {"type": "array", "items": {"enum": ["PUBLIC_ABSTRACTION", "RUNTIME_POLYMORPHISM", "GLOBAL_LIFECYCLE", "CONCURRENCY_BOUNDARY", "TRANSACTION_BOUNDARY", "CROSS_STORE_SIDE_EFFECT", "NONE"]}, "uniqueItems": true},
    "problem_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_locator"}, "uniqueItems": true},
    "change_axis": {"type": ["string", "null"], "minLength": 8},
    "stable_contract": {"type": ["string", "null"], "minLength": 8},
    "invariants": {"type": "array", "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
    "options": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/option"}, "uniqueItems": true},
    "option_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "negative_test_manifest_ref": {"$ref": "#/$defs/typed_hash_ref"},
    "readiness": {"$ref": "#/$defs/readiness"}
  },
  "allOf": [
    {
      "if": {"properties": {"artifact_status": {"const": "FROZEN_CANDIDATE"}}},
      "then": {"properties": {"readiness": {"type": "object", "properties": {"status": {"const": "FROZEN_CANDIDATE"}, "blockers": {"maxItems": 0}}}}}
    },
    {
      "if": {"properties": {"applicability": {"const": "NOT_APPLICABLE"}}},
      "then": {
        "properties": {
          "trigger_evidence": {"minItems": 1, "maxItems": 1, "items": {"const": "NONE"}},
          "change_axis": {"type": "null"},
          "stable_contract": {"type": "null"},
          "invariants": {"maxItems": 0},
          "options": {"minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/option"}, {"properties": {"implementation_form": {"const": "NOT_APPLICABLE"}}}]}}
        }
      },
      "else": {
        "properties": {
          "design_scope": {"enum": ["FUNCTION_SET", "NON_FUNCTION_CODE_UNIT"]},
          "trigger_evidence": {"minItems": 1},
          "change_axis": {"type": "string", "minLength": 8},
          "stable_contract": {"type": "string", "minLength": 8},
          "invariants": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "manifest_path", "manifest_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "typed_hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "path", "sha256"],
      "properties": {
        "artifact_kind": {"type": "string", "minLength": 3},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence_locator": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "symbol_or_pointer", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "symbol_or_pointer": {"type": ["string", "null"], "minLength": 3},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "option": {
      "type": "object", "additionalProperties": false,
      "required": [
        "option_id", "implementation_form", "selected_designs",
        "distributed_constraint_ids", "primary_distributed_constraint_id",
        "participant_bindings", "invariants", "failure_semantics", "complexity",
        "compatibility_and_rollback", "negative_test_ids", "adoption_predicate",
        "rejection_predicate"
      ],
      "properties": {
        "option_id": {"type": "string", "pattern": "^OPT-[A-Za-z0-9._-]+$"},
        "implementation_form": {"enum": ["NOT_APPLICABLE", "DIRECT", "NATIVE_LANGUAGE", "GOF", "PROJECT_ADAPTATION"]},
        "selected_designs": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/selected_design"}, "uniqueItems": true},
        "distributed_constraint_ids": {"type": "array", "items": {"type": "string", "pattern": "^PROJECT-[A-Z0-9-]+$"}, "uniqueItems": true},
        "primary_distributed_constraint_id": {"type": ["string", "null"], "pattern": "^PROJECT-[A-Z0-9-]+$"},
        "participant_bindings": {"type": "array", "items": {"$ref": "#/$defs/participant_binding"}, "uniqueItems": true},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
        "failure_semantics": {"type": "string", "minLength": 8},
        "complexity": {"$ref": "#/$defs/complexity"},
        "compatibility_and_rollback": {"type": "string", "minLength": 8},
        "negative_test_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "adoption_predicate": {"type": "string", "minLength": 8},
        "rejection_predicate": {"type": "string", "minLength": 8}
      }
    },
    "participant_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["participant_role", "exact_symbol", "locator_id"],
      "properties": {
        "participant_role": {"type": "string", "minLength": 3},
        "exact_symbol": {"type": "string", "minLength": 3},
        "locator_id": {"type": "string", "pattern": "^LOC-[A-Za-z0-9._-]+$"}
      }
    },
    "selected_design": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern_id", "implementation_form", "selection_role", "participant_bindings"],
      "properties": {
        "pattern_id": {"type": "string", "pattern": "^GOF-(CRE|STR|BEH)-[0-9]{2}$"},
        "implementation_form": {"enum": ["GOF", "NATIVE_LANGUAGE"]},
        "selection_role": {"enum": ["PRIMARY", "AUXILIARY"]},
        "participant_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/participant_binding"}, "uniqueItems": true}
      }
    },
    "complexity": {
      "type": "object", "additionalProperties": false,
      "required": ["new_files", "new_types", "additional_call_hops", "hot_path_allocations", "cognitive_cost"],
      "properties": {
        "new_files": {"type": "integer", "minimum": 0, "maximum": 10},
        "new_types": {"type": "integer", "minimum": 0, "maximum": 20},
        "additional_call_hops": {"type": "integer", "minimum": 0, "maximum": 5},
        "hot_path_allocations": {"type": "string", "minLength": 3},
        "cognitive_cost": {"type": "string", "minLength": 8}
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "blockers", "proof_ceiling"],
      "properties": {
        "status": {"enum": ["DRAFT", "FROZEN_CANDIDATE"]},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "proof_ceiling": {"const": "PATTERN_PROPOSAL_ONLY_NOT_REVIEW_OR_EXECUTION"}
      }
    }
  }
}
