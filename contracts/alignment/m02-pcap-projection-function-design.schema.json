{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-pcap-projection-function-design.schema.json",
  "title": "M02 PCAP carrier to ClickHouse projection candidate-bound function design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "candidate", "preview_catalog_ref",
    "leaf_bindings", "current_static_findings", "ddl_authority_analysis", "projection_state_machine",
    "function_contracts", "sequencing", "negative_tests", "rollback", "claims", "blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_PCAP_PROJECTION_FUNCTION_DESIGN"},
    "artifact_status": {"const": "CANDIDATE_BOUND_STATIC_DESIGN_BLOCKED_BY_DDL_AUTHORITY_AND_DOWNSTREAM_RECEIPT"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "preview_catalog_ref": {"$ref": "#/$defs/hash_ref"},
    "leaf_bindings": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/leaf_binding"}, "uniqueItems": true},
    "current_static_findings": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/finding"}, "uniqueItems": true},
    "ddl_authority_analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["sources", "observed_drift", "decision", "activation_gate"],
      "properties": {
        "sources": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/ddl_source"}, "uniqueItems": true},
        "observed_drift": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
        "decision": {"const": "ONE_NEW_VERSIONED_MIGRATION_IS_AUTHORITY_OLD_INIT_FILES_BECOME_GENERATED_OR_COMPATIBILITY_INPUTS"},
        "activation_gate": {"const": "BLOCKED_UNTIL_MIGRATION_DDL_PROTO_BIND_SQL_AND_STATEMENT_BUILDER_SHARE_ONE_ORDERED_COLUMN_EXACT_SET"}
      }
    },
    "projection_state_machine": {"$ref": "#/$defs/state_machine"},
    "function_contracts": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/function_contract"}, "uniqueItems": true},
    "sequencing": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/sequence_step"}, "uniqueItems": true},
    "negative_tests": {"type": "array", "minItems": 16, "items": {"$ref": "#/$defs/test_case"}, "uniqueItems": true},
    "rollback": {"$ref": "#/$defs/rollback"},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "forbidden", "proof_ceiling"],
      "properties": {
        "allowed": {"const": "candidate-bound static carrier process checkpoint and ClickHouse projection design exists for the M02 PCAP slice"},
        "forbidden": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "proof_ceiling": {"const": "STATIC_PROJECTION_DESIGN_ONLY_DDL_AUTHORITY_UNRESOLVED_NOT_IMPLEMENTED_CHECKPOINT_TESTED_INDEXED_RECONCILED_OR_AUTHORIZED"}
      }
    },
    "blockers": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 3}, "uniqueItems": true}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "source_blob_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_blob_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 3}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "leaf_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["leaf_id", "atomic_pr_id", "role", "locator"],
      "properties": {
        "leaf_id": {"type": "string", "pattern": "^M02-N(?:010-L0[2-4]|011-L0[1-6])$"},
        "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P2(?:3[4-6]|4[0-5])-(?:CTR|EXP|PRJ)-n(?:010-l0[2-4]|011-l0[1-6])$"},
        "role": {"enum": ["CARRIER_PROCESS", "JOB_GRAPH", "CHECKPOINT", "PROTO_MANIFEST", "DDL_MIGRATION", "INSERT_SQL", "STATEMENT_BINDER", "CARRIER_SINK", "MANIFEST_VALIDATOR"]},
        "locator": {"type": "string", "minLength": 3}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "severity", "path", "symbol", "evidence", "consequence", "evidence_kind"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^M02-PCAP-PROJECTION-P0-[0-9]{2}$"},
        "severity": {"const": "P0"}, "path": {"type": "string", "minLength": 3}, "symbol": {"type": "string", "minLength": 3},
        "evidence": {"type": "string", "minLength": 8}, "consequence": {"type": "string", "minLength": 8},
        "evidence_kind": {"const": "CURRENT_WORKTREE_STATIC_EVIDENCE_NOT_RUNTIME_REPRODUCTION"}
      }
    },
    "ddl_source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "role", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 3}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string", "minLength": 3}, "status": {"const": "CURRENT_WORKTREE_DRIFT_INPUT_NOT_SELECTED_AUTHORITY"}
      }
    },
    "state_machine": {
      "type": "object", "additionalProperties": false,
      "required": ["states", "transitions", "invariants"],
      "properties": {
        "states": {"type": "array", "minItems": 9, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "transitions": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/transition"}, "uniqueItems": true},
        "invariants": {"type": "array", "minItems": 8, "items": {"type": "string", "minLength": 8}, "uniqueItems": true}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "event", "to", "barrier"],
      "properties": {"from": {"type": "string", "minLength": 3}, "event": {"type": "string", "minLength": 3}, "to": {"type": "string", "minLength": 3}, "barrier": {"type": "string", "minLength": 3}}
    },
    "function_contract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "contract_id", "leaf_id", "language", "path", "qualified_symbol", "change_kind", "signature_before", "signature_after",
        "responsibility", "inputs", "outputs", "body_steps", "error_branches", "atomicity", "idempotency", "callers", "callees", "tests", "rollback"
      ],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^FC-M02-PCAP-PROJECTION-[A-Za-z0-9-]+$"},
        "leaf_id": {"type": "string", "pattern": "^M02-N(?:010-L0[2-4]|011-L0[3-6])$"},
        "language": {"const": "java"}, "path": {"type": "string", "minLength": 3}, "qualified_symbol": {"type": "string", "minLength": 3},
        "change_kind": {"enum": ["modify", "new_companion"]}, "signature_before": {"type": ["string", "null"], "minLength": 3},
        "signature_after": {"type": "string", "minLength": 8}, "responsibility": {"type": "string", "minLength": 8},
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "body_steps": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^B[0-9]{2} .+"}, "uniqueItems": true},
        "error_branches": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "atomicity": {"type": "string", "minLength": 8}, "idempotency": {"type": "string", "minLength": 8},
        "callers": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "callees": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TC-M02-PCAP-PROJECTION-[0-9]{2}$"}, "uniqueItems": true},
        "rollback": {"type": "string", "minLength": 8}
      }
    },
    "sequence_step": {
      "type": "object", "additionalProperties": false,
      "required": ["order", "leaf_id", "precondition", "result", "activation"],
      "properties": {
        "order": {"type": "integer", "minimum": 1}, "leaf_id": {"type": "string", "pattern": "^M02-N(?:010-L0[2-4]|011-L0[1-6])$"},
        "precondition": {"type": "string", "minLength": 3}, "result": {"type": "string", "minLength": 3}, "activation": {"type": "string", "minLength": 3}
      }
    },
    "test_case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "kind", "injection", "oracle", "execution_status"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^TC-M02-PCAP-PROJECTION-[0-9]{2}$"},
        "kind": {"enum": ["negative", "fault", "recovery", "compatibility", "property", "checkpoint", "schema", "reconcile"]},
        "injection": {"type": "string", "minLength": 3}, "oracle": {"type": "string", "minLength": 8}, "execution_status": {"const": "NOT_RUN"}
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["entrypoint", "steps", "durable_data_policy", "irreversible_boundary"],
      "properties": {
        "entrypoint": {"type": "string", "minLength": 3}, "steps": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
        "durable_data_policy": {"type": "string", "minLength": 8}, "irreversible_boundary": {"type": "string", "minLength": 8}
      }
    }
  }
}
