{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-code-direct-leaf-catalog.v4.schema.json",
  "title": "M02 code-direct delivery-package owner catalog revision v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "revision_id",
    "base_catalog", "allocation_ledger", "id_epoch", "base_leaf_count",
    "appended_leaf_count", "leaf_count", "type_counts", "parent_counts",
    "prior_leaf_field_freeze", "leaves", "terminal_by_parent",
    "completion_contract_revisions", "append_only_edges", "external_activities",
    "contract_owner_rebindings", "delivery_artifact_contract", "validation",
    "global_switch_gate", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "4.0.0"},
    "artifact_kind": {"const": "M02_CODE_DIRECT_LEAF_CATALOG_REVISION"},
    "artifact_status": {"const": "VERSIONED_PREVIEW_NOT_GLOBAL_REGISTRY"},
    "revision_id": {"const": "M02-CODE-DIRECT-V4"},
    "base_catalog": {"$ref": "#/$defs/hash_ref"},
    "allocation_ledger": {"$ref": "#/$defs/hash_ref"},
    "id_epoch": {"const": "T1-M02-P101-P525"},
    "base_leaf_count": {"const": 421},
    "appended_leaf_count": {"const": 4},
    "leaf_count": {"const": 425},
    "type_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "parent_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "prior_leaf_field_freeze": {"$ref": "#/$defs/freeze"},
    "leaves": {
      "type": "array", "minItems": 425, "maxItems": 425,
      "items": {"$ref": "#/$defs/leaf"}
    },
    "terminal_by_parent": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2}$"}
    },
    "completion_contract_revisions": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"$ref": "#/$defs/completion_revision"}
    },
    "append_only_edges": {
      "type": "array", "minItems": 1198, "uniqueItems": true,
      "items": {"$ref": "#/$defs/edge"}
    },
    "external_activities": {"type": "array", "minItems": 3, "maxItems": 3},
    "contract_owner_rebindings": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true
    },
    "delivery_artifact_contract": {"type": "object"},
    "validation": {"$ref": "#/$defs/validation"},
    "global_switch_gate": {"$ref": "#/$defs/switch_gate"},
    "proof_ceiling": {
      "const": "VERSIONED_STATIC_DESIGN_PREVIEW_ONLY_NOT_GLOBAL_REGISTRATION_PRODUCT_ARTIFACT_CREATION_TARGET_BINDING_FUNCTION_REVIEW_IMPLEMENTATION_TEST_EXECUTION_AUTHORIZATION_OR_ACCEPTANCE"
    }
  },
  "$defs": {
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "hash_status_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "CURRENT_ACTIVE_INPUT_NOT_V4"}
      }
    },
    "freeze": {
      "type": "object", "additionalProperties": false,
      "required": ["leaf_id_epoch", "field_names", "ordered_leaf_projection_sha256", "status"],
      "properties": {
        "leaf_id_epoch": {"const": "T1-M02-P101-P521"},
        "field_names": {
          "type": "array", "minItems": 17, "maxItems": 17, "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "ordered_leaf_projection_sha256": {"const": "f4058eb319d2f9fcf98de259eaba3a1b6bcc51ab4b713d709fa8b10269d689ae"},
        "status": {"const": "PASS_EXACT_FIELD_PRESERVATION"}
      }
    },
    "leaf": {
      "type": "object", "additionalProperties": false,
      "required": [
        "leaf_id", "atomic_pr_id", "parent_task_id", "leaf_number", "pr_type",
        "phase", "write_locators", "target_state", "prerequisites_raw",
        "single_outcome", "oracle_and_rollback", "depends_on_leaf_ids",
        "depends_on_external_activities", "terminal_task_idx",
        "formal_execution_status", "allowed_claim", "forbidden_claims"
      ],
      "properties": {
        "leaf_id": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2,3}$"},
        "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P(?:[1-4][0-9]{2}|5(?:0[0-9]|1[0-9]|2[0-5]))-[A-Z-]+-n[0-9]{3}-l[0-9]{2,3}$"},
        "parent_task_id": {"type": "string", "pattern": "^T1-M02-N[0-9]{3}$"},
        "leaf_number": {"type": "integer", "minimum": 1},
        "pr_type": {"enum": ["CTR", "EXP", "PRJ", "WRT", "REF", "OPS", "TST-PRE", "TST-POST", "IDX", "PROM"]},
        "phase": {"type": "string", "minLength": 3},
        "write_locators": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "target_state": {"enum": ["EXISTING", "PLANNED", "PLANNED_OUTPUT"]},
        "prerequisites_raw": {"type": "string", "minLength": 1},
        "single_outcome": {"type": "string", "minLength": 3},
        "oracle_and_rollback": {"type": "string", "minLength": 3},
        "depends_on_leaf_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "depends_on_external_activities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "terminal_task_idx": {"type": "boolean"},
        "formal_execution_status": {"type": "string", "minLength": 3},
        "allowed_claim": {"type": "string", "minLength": 3},
        "forbidden_claims": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "completion_revision": {
      "type": "object", "additionalProperties": false,
      "required": [
        "parent_task_id", "terminal_leaf_id", "prior_completion_member_leaf_ids",
        "appended_completion_member_leaf_ids", "revised_completion_member_leaf_ids", "revision_semantics"
      ],
      "properties": {
        "parent_task_id": {"enum": ["T1-M02-N007", "T1-M02-N008", "T1-M02-N013"]},
        "terminal_leaf_id": {"type": "string"},
        "prior_completion_member_leaf_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
        "appended_completion_member_leaf_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
        "revised_completion_member_leaf_ids": {"type": "array", "minItems": 2, "uniqueItems": true},
        "revision_semantics": {"const": "TERMINAL_ID_AND_FLAG_FROZEN_COMPLETION_EXACT_SET_VERSION_REVISED"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "reason", "edge_kind"],
      "properties": {
        "from": {"type": "string", "pattern": "^(?:M02-N[0-9]{3}-L[0-9]{2,3}|EXT-T1-M02-N[0-9]{3}-[A-Z-]+)$"},
        "to": {"type": "string", "pattern": "^(?:M02-N[0-9]{3}-L[0-9]{2,3}|EXT-T1-M02-N[0-9]{3}-[A-Z-]+)$"},
        "reason": {"type": "string", "minLength": 8},
        "edge_kind": {"enum": ["BASE_FROZEN", "APPENDED_PREREQUISITE", "APPENDED_TO_EXISTING", "COMPLETION_REVISION"]}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "base_catalog_hash", "prior_leaf_field_exact",
        "allocation_explicit_exact_set", "id_epoch_contiguous", "unique_leaf_ids",
        "unique_atomic_pr_ids", "write_locator_unique", "delivery_train_exact",
        "delivery_artifact_exact_five", "terminal_map_exact", "completion_member_exact",
        "no_new_leaf_depends_on_terminal", "mixed_dag", "mutation_guards"
      ],
      "properties": {
        "schema": {"const": "PASS"},
        "base_catalog_hash": {"const": "PASS"},
        "prior_leaf_field_exact": {"const": "PASS"},
        "allocation_explicit_exact_set": {"const": "PASS"},
        "id_epoch_contiguous": {"const": "PASS"},
        "unique_leaf_ids": {"const": true},
        "unique_atomic_pr_ids": {"const": true},
        "write_locator_unique": {"const": true},
        "delivery_train_exact": {"const": "PASS"},
        "delivery_artifact_exact_five": {"const": "PASS"},
        "terminal_map_exact": {"const": "PASS"},
        "completion_member_exact": {"const": "PASS"},
        "no_new_leaf_depends_on_terminal": {"const": true},
        "mixed_dag": {"const": "PASS"},
        "mutation_guards": {
          "type": "object", "additionalProperties": false,
          "required": [
            "prior_leaf_drift", "id_reuse", "locator_reuse", "delivery_train_shape_drift",
            "delivery_artifact_omission", "delivery_artifact_role_drift", "completion_omission",
            "new_leaf_depends_on_terminal", "feed_source_drift", "dag_cycle", "extra_edge",
            "allocation_semantic_drift", "global_catalog_exact_set"
          ],
          "properties": {
            "prior_leaf_drift": {"const": "PASS"},
            "id_reuse": {"const": "PASS"},
            "locator_reuse": {"const": "PASS"},
            "delivery_train_shape_drift": {"const": "PASS"},
            "delivery_artifact_omission": {"const": "PASS"},
            "delivery_artifact_role_drift": {"const": "PASS"},
            "completion_omission": {"const": "PASS"},
            "new_leaf_depends_on_terminal": {"const": "PASS"},
            "feed_source_drift": {"const": "PASS"},
            "dag_cycle": {"const": "PASS"},
            "extra_edge": {"const": "PASS"},
            "allocation_semantic_drift": {"const": "PASS"},
            "global_catalog_exact_set": {"const": "PASS"}
          }
        }
      }
    },
    "switch_gate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "decision", "legacy_active_m02_pr_count", "candidate_m02_leaf_count",
        "candidate_global_atomic_pr_count", "legacy_catalog_refs", "required_catalogs", "switch_rule"
      ],
      "properties": {
        "decision": {"const": "BLOCKED_PREVIEW_ONLY"},
        "legacy_active_m02_pr_count": {"const": 34},
        "candidate_m02_leaf_count": {"const": 425},
        "candidate_global_atomic_pr_count": {"const": 1680},
        "legacy_catalog_refs": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {"$ref": "#/$defs/hash_status_ref"}
        },
        "required_catalogs": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "switch_rule": {"const": "TASK_CLAIM_PR_DESIGN_AND_OVERLAY_MUST_SWITCH_ATOMICALLY_TO_ONE_V4_CANDIDATE_HASH_AFTER_REVIEW"}
      }
    }
  }
}
