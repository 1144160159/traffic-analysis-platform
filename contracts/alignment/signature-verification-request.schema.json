{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/signature-verification-request.schema.json",
  "title": "Topic One exact signature verification request",
  "description": "The signed_payload object is the complete domain-separated content authenticated by verification_material.detached_signature_base64. Verification material is deliberately outside the signed object to avoid self-reference.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "request_id", "signed_payload", "verification_material"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "canonicalization_version": {"const": "M01-SIGNATURE-REQUEST-C14N-V1"},
    "request_id": {"type": "string", "pattern": "^T1-SIGREQ-[A-Za-z0-9._:-]+$", "maxLength": 160},
    "signed_payload": {"$ref": "#/$defs/signed_payload"},
    "verification_material": {"$ref": "#/$defs/verification_material"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_object_id": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "rfc3339_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"},
    "base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "minLength": 4},
    "signature_algorithm": {
      "enum": ["ECDSA_P256_SHA256", "ECDSA_P384_SHA384", "RSA_PSS_SHA256", "RSA_PSS_SHA384", "ED25519"]
    },
    "authority_role": {
      "enum": [
        "PROJECT_OWNER",
        "TEST_OWNER",
        "ACCEPTANCE_AUTHORITY",
        "SUPPLY_CHAIN_OWNER",
        "SECURITY_OWNER",
        "DOMAIN_OWNER",
        "LANGUAGE_OWNER",
        "RELIABILITY_DATA_EXPERT",
        "SECURITY_TENANT_EXPERT",
        "QA_SRE_PERFORMANCE_EXPERT",
        "MAINTAINABILITY_RED_TEAM",
        "ADJUDICATOR",
        "CONTRACT_OWNER",
        "EXECUTION_OWNER",
        "WORK_ORDER_OWNER",
        "CNAS_SCOPE_AUTHORITY"
      ]
    },
    "verification_purpose": {
      "enum": [
        "CANDIDATE_ARTIFACT_PROVENANCE",
        "IMPLEMENTATION_CANDIDATE_SUPPLY_CHAIN",
        "REQUIREMENT_SATISFACTION_AUTHORITY",
        "BOM_TRANSITION_AUTHORITY",
        "EXTERNAL_ACTIVITY_RECEIPT",
        "SIGNED_CONTRACT_INTAKE",
        "EXECUTION_OVERLAY_ACCEPTANCE",
        "FAIL_CLOSED_SELF_TEST",
        "WORK_ORDER_EVIDENCE_RUN"
      ]
    },
    "subject_type": {
      "enum": [
        "CANDIDATE_ARTIFACT",
        "IMPLEMENTATION_CANDIDATE",
        "REQUIREMENT_SATISFACTION",
        "BOM_TRANSITION",
        "EXTERNAL_ACTIVITY",
        "SIGNED_CONTRACT",
        "EXECUTION_OVERLAY",
        "SELF_TEST",
        "WORK_ORDER_EVIDENCE"
      ]
    },
    "authority_scope": {
      "enum": [
        "CANDIDATE",
        "PROFILE",
        "ENVIRONMENT",
        "PURPOSE",
        "PROJECT",
        "TEST",
        "ACCEPTANCE",
        "SUPPLY_CHAIN",
        "CONTRACT",
        "EXECUTION",
        "WORK_ORDER",
        "CNAS_ACCREDITATION"
      ]
    },
    "authority_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "role"],
      "properties": {
        "authority_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{2,255}$"},
        "role": {"$ref": "#/$defs/authority_role"}
      }
    },
    "cnas_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accreditation_id", "scope_item_id", "method_id", "scope_sha256"],
      "properties": {
        "accreditation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"},
        "scope_item_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"},
        "method_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"},
        "scope_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "subject_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "content_base64", "content_sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"},
        "media_type": {"enum": ["application/json", "application/octet-stream", "text/plain"]},
        "content_base64": {"$ref": "#/$defs/base64"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    },
    "signed_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "subject_type",
        "subject_id",
        "subject_payload",
        "candidate_commit",
        "profile_id",
        "environment_id",
        "purpose",
        "signature_algorithm",
        "signer_certificate_sha256",
        "certificate_chain_sha256",
        "claimed_authorities",
        "required_authority_roles",
        "required_scopes",
        "issued_at",
        "expires_at",
        "evaluation_time",
        "policy_id",
        "policy_version",
        "policy_fingerprint_sha256",
        "nonce",
        "cnas_context"
      ],
      "properties": {
        "domain": {"const": "traffic-analysis-platform/topic1/signature-verification/v1"},
        "subject_type": {"$ref": "#/$defs/subject_type"},
        "subject_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"},
        "subject_payload": {"$ref": "#/$defs/subject_payload"},
        "candidate_commit": {"$ref": "#/$defs/git_object_id"},
        "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "environment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "purpose": {"$ref": "#/$defs/verification_purpose"},
        "signature_algorithm": {"$ref": "#/$defs/signature_algorithm"},
        "signer_certificate_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_chain_sha256": {"$ref": "#/$defs/sha256"},
        "claimed_authorities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/authority_claim"}
        },
        "required_authority_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/authority_role"}
        },
        "required_scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/authority_scope"}
        },
        "issued_at": {"$ref": "#/$defs/rfc3339_utc"},
        "expires_at": {"$ref": "#/$defs/rfc3339_utc"},
        "evaluation_time": {"$ref": "#/$defs/rfc3339_utc"},
        "policy_id": {"type": "string", "pattern": "^T1-SIGNATURE-POLICY-[A-Za-z0-9._-]+$", "maxLength": 128},
        "policy_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
        "policy_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22,128}$"},
        "cnas_context": {
          "oneOf": [
            {"$ref": "#/$defs/cnas_context"},
            {"type": "null"}
          ]
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_id", "certificate_sha256", "certificate_der_base64"],
      "properties": {
        "certificate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_der_base64": {"$ref": "#/$defs/base64"}
      }
    },
    "verification_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detached_signature_base64", "signature_sha256", "certificate_chain"],
      "properties": {
        "detached_signature_base64": {"$ref": "#/$defs/base64"},
        "signature_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/certificate"}
        }
      }
    }
  }
}
