{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-code-direct-leaf-allocation.v2.schema.json",
  "title": "M02 append-only code-direct leaf allocation ledger v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "revision_id",
    "base_catalog", "source_design_refs", "semantic_projection_sha256",
    "allocation_epoch", "append_leaf_count", "trains",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "M02_CODE_DIRECT_LEAF_ALLOCATION_LEDGER"},
    "artifact_status": {"const": "VERSIONED_PREVIEW_NOT_GLOBAL_REGISTRY"},
    "revision_id": {"const": "M02-CODE-DIRECT-V2"},
    "base_catalog": {"$ref": "#/$defs/hash_ref"},
    "source_design_refs": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {"$ref": "#/$defs/source_hash_ref"}
    },
    "semantic_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allocation_epoch": {"const": "T1-M02-P308-P506"},
    "append_leaf_count": {"const": 199},
    "trains": {
      "type": "array", "minItems": 65, "maxItems": 65,
      "items": {"$ref": "#/$defs/train"}
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "forbidden", "proof_ceiling"],
      "properties": {
        "allowed": {"const": "P308-P506 append-only identities and support-train intent are allocated for v2 preview validation"},
        "forbidden": {
          "type": "array", "minItems": 5, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "proof_ceiling": {"const": "ALLOCATION_ONLY_NOT_GLOBAL_REGISTRATION_IMPLEMENTATION_TEST_EXECUTION_AUTHORIZATION_OR_ACCEPTANCE"}
      }
    }
  },
  "$defs": {
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "contracts/alignment/m02-code-direct-leaf-catalog.v1.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^contracts/alignment/m02-.+-function-design\\.v1\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "train": {
      "type": "object", "additionalProperties": false,
      "required": [
        "train_id", "parent_task_id", "gap_id", "owner_kind",
        "single_result", "steps", "feeds_existing_leaf_ids",
        "terminal_leaf_id"
      ],
      "properties": {
        "train_id": {"type": "string", "pattern": "^M02-V2-TRAIN-[0-9]{2}$"},
        "parent_task_id": {"type": "string", "pattern": "^T1-M02-N(?:001|004|005|006|008|012)$"},
        "gap_id": {"type": "string", "minLength": 8},
        "owner_kind": {"enum": ["CONTRACT", "RUNTIME_WRITER", "CONTRACT_AND_WRITER", "DATABASE_MIGRATION_AND_WRITER"]},
        "single_result": {"type": "string", "minLength": 12},
        "steps": {
          "type": "array", "minItems": 3, "maxItems": 4,
          "items": {"$ref": "#/$defs/step"}
        },
        "feeds_existing_leaf_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2,3}$"}
        },
        "terminal_leaf_id": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2}$"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": [
        "leaf_id", "atomic_pr_id", "pr_type", "primary_locator",
        "companion_locators", "target_state", "prerequisite_leaf_ids",
        "single_outcome", "oracle_and_rollback"
      ],
      "properties": {
        "leaf_id": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2,3}$"},
        "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P(?:3(?:0[8-9]|[1-9][0-9])|4[0-9]{2}|50[0-6])-(?:CTR|EXP|WRT|REF|TST-PRE)-n[0-9]{3}-l[0-9]{2,3}$"},
        "pr_type": {"enum": ["CTR", "EXP", "WRT", "REF", "TST-PRE"]},
        "primary_locator": {"type": "string", "minLength": 3},
        "companion_locators": {
          "type": "array", "maxItems": 4, "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "target_state": {"enum": ["PLANNED", "PLANNED_OUTPUT"]},
        "prerequisite_leaf_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M02-N[0-9]{3}-L[0-9]{2,3}$"}
        },
        "single_outcome": {"type": "string", "minLength": 8},
        "oracle_and_rollback": {"type": "string", "minLength": 8}
      }
    }
  }
}
