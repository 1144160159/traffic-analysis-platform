{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-responsibility-assignment.schema.json",
  "title": "M02 named responsibility assignment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "assignment_id", "source_task_registry",
    "source_replacement_catalog", "assignments", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_RESPONSIBILITY_ASSIGNMENT"},
    "assignment_id": {"type": "string", "pattern": "^M02-RESP-[A-Za-z0-9._-]+$"},
    "source_task_registry": {"$ref": "#/$defs/hash_ref"},
    "source_replacement_catalog": {"$ref": "#/$defs/hash_ref"},
    "assignments": {
      "type": "array", "minItems": 16, "maxItems": 16, "uniqueItems": true,
      "items": {"$ref": "#/$defs/assignment"}
    },
    "proof_ceiling": {"const": "NAMED_RESPONSIBILITY_INPUT_ONLY_REQUIRES_INDEPENDENT_SIGNED_INTAKE_NOT_EXECUTION_AUTHORIZATION"}
  },
  "$defs": {
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "owner_role", "owner", "reviewers", "approvers"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^T1-M02-N0(?:0[1-9]|1[0-6])$"},
        "owner_role": {"type": "string", "minLength": 3},
        "owner": {"type": "string", "minLength": 3},
        "reviewers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "approvers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    }
  }
}
