{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/integrated-system-bom-transition.schema.json",
  "title": "Topic One integrated BOM immutable state transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transition_id", "bom_id", "candidate_manifest_sha256", "profile_id",
    "environment_id", "input_bom_path", "input_bom_sha256", "input_state",
    "output_bom_path", "output_bom_sha256", "output_state", "state_path",
    "predecessor_transition_sha256", "evidence_manifest_sha256s", "authority_receipt_path",
    "authority_receipt_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "transition_id": {"type": "string", "pattern": "^T1-BOM-TRANSITION-[A-Za-z0-9._-]+$"},
    "bom_id": {"type": "string", "pattern": "^T1-BOM-[A-Za-z0-9._-]+$"},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "minLength": 1},
    "environment_id": {"type": "string", "minLength": 1},
    "input_bom_path": {"type": "string", "minLength": 1},
    "input_bom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_state": {"$ref": "#/$defs/state"},
    "output_bom_path": {"type": "string", "minLength": 1},
    "output_bom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_state": {"$ref": "#/$defs/state"},
    "state_path": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/state"}},
    "predecessor_transition_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "evidence_manifest_sha256s": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "authority_receipt_path": {"type": "string", "minLength": 1},
    "authority_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "state": {"enum": ["BOM_DRAFT", "ASSEMBLED", "DEPLOYED_VERIFIED", "CNAS_FROZEN", "CONTRACT_RELEASED", "RELEASED_OBSERVING", "STABLE", "SUPERSEDED", "FAILED"]}
  }
}
