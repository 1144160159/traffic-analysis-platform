{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic.local/contracts/alignment/asset-authority-live-run-manifest.schema.json",
  "title": "P919 authorized real-dependency reconciliation run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind", "schema_version", "run_id", "candidate_manifest_sha256",
    "profile_id", "environment_id", "environment_class", "time_window",
    "production_applied", "execution_package_sha256", "plan_kind", "plan_id", "plan_sha256",
    "bom_transition_sha256", "required_projection_targets", "receipt_refs"
  ],
  "properties": {
    "artifact_kind": {"const": "ASSET_AUTHORITY_LIVE_RUN_MANIFEST"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 8},
    "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "profile_id": {"type": "string", "minLength": 3},
    "environment_id": {"type": "string", "minLength": 3},
    "environment_class": {"enum": ["AUTHORIZED_REAL_DEPENDENCY", "PRODUCTION_CANARY"]},
    "time_window": {"type": "string", "minLength": 8},
    "production_applied": {"type": "boolean"},
    "execution_package_sha256": {"$ref": "#/$defs/sha256"},
    "plan_kind": {"const": "EVIDENCE"},
    "plan_id": {"type": "string", "minLength": 3},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "bom_transition_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "required_projection_targets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
    },
    "receipt_refs": {
      "type": "object", "additionalProperties": false,
      "required": ["AUTHORITY", "BROKER", "PROJECTION"],
      "properties": {
        "AUTHORITY": {"$ref": "#/$defs/hash_ref"},
        "BROKER": {"$ref": "#/$defs/hash_ref"},
        "PROJECTION": {"$ref": "#/$defs/hash_ref"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
