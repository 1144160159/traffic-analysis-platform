{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/promotion-intent.schema.json",
  "title": "Promotion intent pre-merge manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "promotion_id", "candidate_manifest_sha256", "profile_id",
    "current_idx_manifest_sha256", "promotion_commit_parent", "allowed_paths",
    "premerge_equivalence_result", "bom_transition_manifest_sha256",
    "milestone_promotion_closure_sha256", "approvals", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "promotion_id": {"type": "string", "minLength": 1},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "minLength": 1},
    "current_idx_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "promotion_commit_parent": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "premerge_equivalence_result": {"const": "PASS"},
    "bom_transition_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "milestone_promotion_closure_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "approvals": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "created_at": {"type": "string", "minLength": 1}
  }
}
