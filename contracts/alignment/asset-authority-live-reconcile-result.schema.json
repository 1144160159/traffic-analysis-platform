{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic.local/contracts/alignment/asset-authority-live-reconcile-result.schema.json",
  "title": "P919 candidate-bound G2 and G3 reconciliation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind", "schema_version", "subject_pr_id", "run_id",
    "candidate_manifest_sha256", "profile_id", "environment_id", "input_sha256",
    "identity", "gate_results", "unexplained_differences", "result", "proof_ceiling"
  ],
  "properties": {
    "artifact_kind": {"const": "ASSET_AUTHORITY_LIVE_RECONCILE_RESULT"},
    "schema_version": {"const": "1.0.0"},
    "subject_pr_id": {"const": "T1-M06-P919-TST-POST-n004-asset-authority-live-reconcile"},
    "run_id": {"type": "string", "minLength": 8},
    "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "profile_id": {"type": "string", "minLength": 3},
    "environment_id": {"type": "string", "minLength": 3},
    "input_sha256": {
      "type": "object", "additionalProperties": false,
      "required": ["run_manifest", "authority", "broker", "projection"],
      "properties": {
        "run_manifest": {"$ref": "#/$defs/sha256"},
        "authority": {"$ref": "#/$defs/sha256"},
        "broker": {"$ref": "#/$defs/sha256"},
        "projection": {"$ref": "#/$defs/sha256"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant_ref", "trace_id", "event_id", "asset_id", "revision"],
      "properties": {
        "tenant_ref": {"type": "string", "minLength": 3},
        "trace_id": {"type": "string", "minLength": 3},
        "event_id": {"type": "string", "minLength": 3},
        "asset_id": {"type": "string", "minLength": 3},
        "revision": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "gate_results": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate_id", "result", "oracle_ids"],
        "properties": {
          "gate_id": {"enum": ["G2", "G3"]},
          "result": {"const": "PASS"},
          "oracle_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}, "uniqueItems": true}
        }
      }
    },
    "unexplained_differences": {"type": "array", "maxItems": 0},
    "result": {"const": "PASS"},
    "proof_ceiling": {"const": "G3_RECONCILIATION_ONLY_NOT_REQUIREMENT_MILESTONE_OR_PRODUCTION_ACCEPTANCE"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
