{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-capture-flow-identity-function-design.schema.json",
  "title": "M02 capture to FlowEvent identity candidate-bound function design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "candidate", "preview_catalog_ref",
    "leaf_bindings", "current_static_findings", "identity_state_machine", "direction_contract",
    "function_contracts", "missing_atomic_leaves", "sequencing", "negative_tests",
    "rollback", "claims", "blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_CAPTURE_FLOW_IDENTITY_FUNCTION_DESIGN"},
    "artifact_status": {"const": "CANDIDATE_BOUND_STATIC_DESIGN_BLOCKED_BY_MISSING_IDENTITY_ATOMIC_LEAVES"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "preview_catalog_ref": {"$ref": "#/$defs/hash_ref"},
    "leaf_bindings": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/leaf_binding"}, "uniqueItems": true},
    "current_static_findings": {"type": "array", "minItems": 19, "maxItems": 19, "items": {"$ref": "#/$defs/finding"}, "uniqueItems": true},
    "identity_state_machine": {"$ref": "#/$defs/state_machine"},
    "direction_contract": {"$ref": "#/$defs/direction_contract"},
    "function_contracts": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/function_contract"}, "uniqueItems": true},
    "missing_atomic_leaves": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/missing_leaf"}, "uniqueItems": true},
    "sequencing": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/sequence_step"}, "uniqueItems": true},
    "negative_tests": {"type": "array", "minItems": 22, "maxItems": 22, "items": {"$ref": "#/$defs/test_case"}, "uniqueItems": true},
    "rollback": {"$ref": "#/$defs/rollback"},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "forbidden", "proof_ceiling"],
      "properties": {
        "allowed": {"const": "candidate-bound static capture timestamp canonical flow identity dual-path parity and replay identity design exists for the M02 FlowEvent producer slice"},
        "forbidden": {"type": "array", "minItems": 8, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "proof_ceiling": {"const": "STATIC_DESIGN_ONLY_MISSING_IDENTITY_LEAVES_NOT_IMPLEMENTED_FUNCTION_REVIEWED_VECTOR_TESTED_REPLAY_PROVEN_OR_AUTHORIZED"}
      }
    },
    "blockers": {"type": "array", "minItems": 8, "items": {"type": "string", "minLength": 3}, "uniqueItems": true}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "source_blob_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_blob_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 3}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "leaf_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["leaf_id", "atomic_pr_id", "role", "locator"],
      "properties": {
        "leaf_id": {"type": "string", "pattern": "^M02-N(?:001-L0[12]|004-L15|005-L0[1-6])$"},
        "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P(?:10[12]|159|17[1-6])-(?:CTR|WRT)-n(?:001-l0[12]|004-l15|005-l0[1-6])$"},
        "role": {"enum": ["EVENT_HEADER_CONTRACT", "FLOW_EVENT_CONTRACT", "OFFLINE_TIMESTAMP", "CANONICAL_FLOW_KEY", "COMMUNITY_ID", "FULL_PATH_SAMPLE", "FAST_PATH_SAMPLE", "FLOW_EVENT_BUILD", "STABLE_PARTITION"]},
        "locator": {"type": "string", "minLength": 3}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "severity", "path", "symbol", "evidence", "consequence", "evidence_kind"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^M02-FLOW-ID-P0-[0-9]{2}$"},
        "severity": {"const": "P0"},
        "path": {"type": "string", "minLength": 3},
        "symbol": {"type": "string", "minLength": 3},
        "evidence": {"type": "string", "minLength": 8},
        "consequence": {"type": "string", "minLength": 8},
        "evidence_kind": {"const": "CURRENT_WORKTREE_STATIC_EVIDENCE_NOT_RUNTIME_REPRODUCTION"}
      }
    },
    "state_machine": {
      "type": "object", "additionalProperties": false,
      "required": ["states", "transitions", "invariants"],
      "properties": {
        "states": {"type": "array", "minItems": 10, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "transitions": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/transition"}, "uniqueItems": true},
        "invariants": {"type": "array", "minItems": 10, "items": {"type": "string", "minLength": 8}, "uniqueItems": true}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "event", "to", "barrier"],
      "properties": {"from": {"type": "string", "minLength": 3}, "event": {"type": "string", "minLength": 3}, "to": {"type": "string", "minLength": 3}, "barrier": {"type": "string", "minLength": 3}}
    },
    "direction_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["tuple_order", "packet_direction", "one_way_policy", "aggregate_direction", "counter_meaning", "compatibility_gate"],
      "properties": {
        "tuple_order": {"const": "protocol-aware canonical endpoint order shared by FlowKey and Community ID v1"},
        "packet_direction": {"const": "FORWARD means observed source endpoint equals canonical endpoint A; BACKWARD means endpoint B for reversible observations"},
        "one_way_policy": {"const": "unpaired ICMP and ICMPv6 messages carry one_way=true and are not forced into a reversible request reply pair"},
        "aggregate_direction": {"const": "FlowEvent.direction is bidirectional for a two-counter aggregate and never claims client/server inference"},
        "counter_meaning": {"const": "packets_fwd bytes_fwd and flags_fwd are canonical A-to-B; bwd fields are canonical B-to-A"},
        "compatibility_gate": {"const": "old c2s consumers require an explicit additive compatibility decision before activation"}
      }
    },
    "function_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "leaf_id", "language", "path", "qualified_symbol", "change_kind", "signature_before", "signature_after", "responsibility", "inputs", "outputs", "body_steps", "error_branches", "atomicity", "idempotency", "callers", "callees", "tests", "rollback"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^FC-M02-FLOW-ID-[A-Za-z0-9-]+$"},
        "leaf_id": {"type": "string", "pattern": "^M02-N(?:004-L15|005-L0[1-6])$"},
        "language": {"const": "rust"},
        "path": {"type": "string", "minLength": 3},
        "qualified_symbol": {"type": "string", "minLength": 3},
        "change_kind": {"enum": ["modify", "new_companion"]},
        "signature_before": {"type": ["string", "null"], "minLength": 3},
        "signature_after": {"type": "string", "minLength": 8},
        "responsibility": {"type": "string", "minLength": 8},
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "body_steps": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^B[0-9]{2} .+"}, "uniqueItems": true},
        "error_branches": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "atomicity": {"type": "string", "minLength": 8},
        "idempotency": {"type": "string", "minLength": 8},
        "callers": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "callees": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TC-M02-FLOW-ID-[0-9]{2}$"}, "uniqueItems": true},
        "rollback": {"type": "string", "minLength": 8}
      }
    },
    "missing_leaf": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "required_locators", "single_result", "reason", "resolution", "status"],
      "properties": {
        "gap_id": {"type": "string", "pattern": "^M02-FLOW-ID-GAP-(?:0[1-9]|1[0-3])$"},
        "required_locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "single_result": {"type": "string", "minLength": 8},
        "reason": {"type": "string", "minLength": 8},
        "resolution": {"type": "string", "minLength": 8},
        "status": {"const": "BLOCKED_MISSING_APPEND_ONLY_ATOMIC_LEAF_AND_SUPPORT_TRAIN"}
      }
    },
    "sequence_step": {
      "type": "object", "additionalProperties": false,
      "required": ["order", "leaf_id", "precondition", "result", "activation"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "leaf_id": {"type": "string", "pattern": "^M02-N(?:001-L0[12]|004-L15|005-L0[1-6])$"},
        "precondition": {"type": "string", "minLength": 3},
        "result": {"type": "string", "minLength": 3},
        "activation": {"type": "string", "minLength": 3}
      }
    },
    "test_case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "kind", "injection", "oracle", "execution_status"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^TC-M02-FLOW-ID-[0-9]{2}$"},
        "kind": {"enum": ["negative", "property", "compatibility", "replay", "cross_language", "capture", "parser", "fault"]},
        "injection": {"type": "string", "minLength": 3},
        "oracle": {"type": "string", "minLength": 8},
        "execution_status": {"const": "NOT_RUN"}
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["entrypoint", "steps", "durable_data_policy", "irreversible_boundary"],
      "properties": {
        "entrypoint": {"type": "string", "minLength": 3},
        "steps": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
        "durable_data_policy": {"type": "string", "minLength": 8},
        "irreversible_boundary": {"type": "string", "minLength": 8}
      }
    }
  }
}
