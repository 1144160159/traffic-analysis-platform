{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic.local/contracts/alignment/asset-authority-live-receipt.schema.json",
  "title": "P919 typed authority broker or projection receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind", "schema_version", "receipt_kind", "receipt_id", "run_id",
    "candidate_manifest_sha256", "profile_id", "environment_id", "tenant_ref",
    "trace_id", "event_id", "asset_id", "revision", "facts",
    "issued_at", "trusted_verifier_receipt", "verification_status"
  ],
  "properties": {
    "artifact_kind": {"const": "ASSET_AUTHORITY_LIVE_RECEIPT"},
    "schema_version": {"const": "1.0.0"},
    "receipt_kind": {"enum": ["AUTHORITY", "BROKER", "PROJECTION"]},
    "receipt_id": {"type": "string", "minLength": 8},
    "run_id": {"type": "string", "minLength": 8},
    "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "profile_id": {"type": "string", "minLength": 3},
    "environment_id": {"type": "string", "minLength": 3},
    "tenant_ref": {"type": "string", "minLength": 3},
    "trace_id": {"type": "string", "minLength": 3},
    "event_id": {"type": "string", "minLength": 3},
    "asset_id": {"type": "string", "minLength": 3},
    "revision": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "facts": {"type": "object"},
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "trusted_verifier_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verification_status": {"const": "PASS"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
