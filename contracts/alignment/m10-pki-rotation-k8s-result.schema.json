{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m10-pki-rotation-k8s-result.schema.json",
  "title": "T1-M10-N008 Kubernetes atomic PKI rotation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "task_id", "atomic_pr_ids", "run_id",
    "status", "engineering_status", "acceptance_status", "profile_id",
    "environment_kind", "candidate_id", "pki_catalog_sha256", "source_sha256",
    "catalog_counts", "build_toolchain", "fail_closed_dimensions",
    "kubernetes_jobs", "blocking_codes", "required_gates",
    "shared_infrastructure_touched", "production_applied",
    "run_scoped_resources_removed", "allowed_claims", "does_not_prove"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "M10_PKI_ROTATION_K8S_NEGATIVE_TEST_RESULT"},
    "task_id": {"const": "T1-M10-N008"},
    "atomic_pr_ids": {"const": ["T1-M10-P018-OPS-n008-s1", "T1-M10-P019-TST-POST-n008-s2"]},
    "run_id": {"type": "string", "format": "uuid"},
    "status": {"const": "PASS"},
    "engineering_status": {"const": "PASS"},
    "acceptance_status": {"const": "BLOCKED_NOT_ENABLED"},
    "profile_id": {"const": "M10-N008-K8S-ATOMIC-PKI-ROTATION-V1"},
    "environment_kind": {"const": "KUBERNETES"},
    "candidate_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "pki_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"type": "object", "minProperties": 20, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "catalog_counts": {"type": "object"},
    "build_toolchain": {"const": "go version go1.25.12 linux/amd64"},
    "fail_closed_dimensions": {
      "const": ["wrong_ca", "expired_certificate", "san_mismatch", "revoked_serial", "interrupted_rotation", "dual_trust_cutover"]
    },
    "kubernetes_jobs": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/job"}
    },
    "blocking_codes": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_gates": {"type": "object"},
    "shared_infrastructure_touched": {"const": false},
    "production_applied": {"const": false},
    "run_scoped_resources_removed": {"const": true},
    "allowed_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "does_not_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "result"],
      "properties": {
        "identity": {
          "type": "object",
          "required": ["namespace", "job_name", "job_uid", "pod_name", "pod_uid", "node", "started_at", "completed_at", "container_id", "image", "image_id"]
        },
        "result": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "profile_id", "test_groups", "top_level_tests", "fail_closed_dimensions"],
          "properties": {
            "status": {"const": "PASS"},
            "profile_id": {"const": "M10-N008-K8S-ATOMIC-PKI-ROTATION-V1"},
            "test_groups": {"const": 1},
            "top_level_tests": {"const": 4},
            "fail_closed_dimensions": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
