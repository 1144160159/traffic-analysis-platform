{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-gate-input-preflight.schema.json",
  "title": "M02 C03-C07 external input exact-set preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "source_locator_coverage",
    "source_function_review_coverage", "source_task_registry", "source_replacement_catalog",
    "contract_refs", "candidate_intake", "responsibility_intake", "locator_receipt_intake",
    "compatibility_review_intake", "review_receipt_intake", "gate_results", "unexpected_primary_artifacts",
    "validation", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_C03_C07_EXTERNAL_INPUT_PREFLIGHT"},
    "artifact_status": {"enum": ["BLOCKED_EXTERNAL_INPUTS_INCOMPLETE", "READY_EXTERNAL_INPUTS_EXACT_NOT_GATE_PASS"]},
    "source_locator_coverage": {"$ref": "#/$defs/hash_ref"},
    "source_function_review_coverage": {"$ref": "#/$defs/hash_ref"},
    "source_task_registry": {"$ref": "#/$defs/hash_ref"},
    "source_replacement_catalog": {"$ref": "#/$defs/hash_ref"},
    "contract_refs": {"type": "array", "minItems": 20, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/hash_ref"}},
    "candidate_intake": {"$ref": "#/$defs/candidate_intake"},
    "responsibility_intake": {"$ref": "#/$defs/responsibility_intake"},
    "locator_receipt_intake": {"$ref": "#/$defs/exact_set_intake"},
    "compatibility_review_intake": {"$ref": "#/$defs/exact_set_intake"},
    "review_receipt_intake": {"$ref": "#/$defs/exact_set_intake"},
    "gate_results": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"$ref": "#/$defs/gate_result"}
    },
    "unexpected_primary_artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_hashes_exact", "expected_path_sets_derived", "managed_roots_scanned",
        "candidate_cross_binding_checked", "receipt_candidate_binding_checked",
        "no_missing_or_unverified_input_claimed_pass", "mutation_guards"
      ],
      "properties": {
        "source_hashes_exact": {"const": "PASS"},
        "expected_path_sets_derived": {"const": "PASS"},
        "managed_roots_scanned": {"const": "PASS"},
        "candidate_cross_binding_checked": {"const": "PASS"},
        "receipt_candidate_binding_checked": {"const": "PASS"},
        "no_missing_or_unverified_input_claimed_pass": {"const": true},
        "mutation_guards": {
          "type": "object", "additionalProperties": false,
          "required": ["locator_omission", "compatibility_review_omission", "review_omission", "unexpected_artifact", "candidate_false_pass", "responsibility_false_pass", "gate_false_pass"],
          "properties": {
            "locator_omission": {"const": "PASS"},
            "compatibility_review_omission": {"const": "PASS"},
            "review_omission": {"const": "PASS"},
            "unexpected_artifact": {"const": "PASS"},
            "candidate_false_pass": {"const": "PASS"},
            "responsibility_false_pass": {"const": "PASS"},
            "gate_false_pass": {"const": "PASS"}
          }
        }
      }
    },
    "proof_ceiling": {"const": "EXTERNAL_INPUT_EXACT_SET_PREFLIGHT_ONLY_NOT_IDENTITY_INVENTION_SIGNATURE_VERIFICATION_LOCATOR_RESOLUTION_REVIEW_APPROVAL_IMPLEMENTATION_SWITCH_EXECUTION_OR_ACCEPTANCE"}
  },
  "$defs": {
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "artifact_probe": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_path", "exists", "sha256", "status", "blocking_reasons"],
      "properties": {
        "expected_path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "status": {"type": "string", "minLength": 3},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "candidate_intake": {
      "type": "object", "additionalProperties": false,
      "required": ["required_source_path_count", "required_source_path_exact_set_sha256", "required_source_paths", "design_manifest", "implementation_manifest", "same_commit", "status"],
      "properties": {
        "required_source_path_count": {"const": 163},
        "required_source_path_exact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "required_source_paths": {"type": "array", "minItems": 163, "maxItems": 163, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "design_manifest": {"$ref": "#/$defs/artifact_probe"},
        "implementation_manifest": {"$ref": "#/$defs/artifact_probe"},
        "same_commit": {"type": "boolean"},
        "status": {"enum": ["BLOCKED_CANDIDATE_INPUTS_MISSING_OR_INVALID", "READY_SAME_CLEAN_CANDIDATE_INPUT"]}
      }
    },
    "responsibility_intake": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_task_count", "manifest", "signed_intake", "assigned_task_count", "signature_verification_available", "status"],
      "properties": {
        "expected_task_count": {"const": 16},
        "manifest": {"$ref": "#/$defs/artifact_probe"},
        "signed_intake": {"$ref": "#/$defs/artifact_probe"},
        "assigned_task_count": {"type": "integer", "minimum": 0, "maximum": 16},
        "signature_verification_available": {"type": "boolean"},
        "status": {"enum": ["BLOCKED_RESPONSIBILITY_OR_SIGNATURE_INPUT_MISSING", "READY_SIGNED_RESPONSIBILITY_INPUT"]}
      }
    },
    "exact_set_intake": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_count", "found_count", "validated_count", "invalid_count", "missing_count", "unexpected_count", "expected_path_exact_set_sha256", "expected_paths", "found_paths", "missing_paths", "invalid_artifacts", "unexpected_paths", "status"],
      "properties": {
        "expected_count": {"type": "integer", "minimum": 1},
        "found_count": {"type": "integer", "minimum": 0},
        "validated_count": {"type": "integer", "minimum": 0},
        "invalid_count": {"type": "integer", "minimum": 0},
        "missing_count": {"type": "integer", "minimum": 0},
        "unexpected_count": {"type": "integer", "minimum": 0},
        "expected_path_exact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "found_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "missing_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "invalid_artifacts": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "error"],
            "properties": {"path": {"type": "string", "minLength": 1}, "error": {"type": "string", "minLength": 1}}
          }
        },
        "unexpected_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "status": {"enum": ["BLOCKED_EXACT_SET_INCOMPLETE", "READY_EXACT_SET_VALIDATED"]}
      }
    },
    "gate_result": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "status", "evidence", "blocking_reason"],
      "properties": {
        "gate_id": {"enum": ["REG03-C03", "REG03-C04", "REG03-C06", "REG03-C07"]},
        "status": {"enum": ["READY", "BLOCKED"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "blocking_reason": {"type": ["string", "null"]}
      }
    }
  }
}
