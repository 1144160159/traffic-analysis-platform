{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-pcap-spool-function-design.schema.json",
  "title": "M02 PCAP durable spool candidate-bound function design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "artifact_status", "candidate",
    "preview_catalog_ref", "leaf_bindings", "current_static_findings",
    "spool_state_machine", "function_contracts", "missing_atomic_leaves",
    "registry_revision_gate",
    "sequencing", "negative_tests", "rollback", "claims", "blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_PCAP_SPOOL_FUNCTION_DESIGN"},
    "artifact_status": {"const": "CANDIDATE_BOUND_STATIC_DESIGN_BLOCKED_BY_MISSING_ATOMIC_LEAVES"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "preview_catalog_ref": {"$ref": "#/$defs/hash_ref"},
    "leaf_bindings": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {"$ref": "#/$defs/leaf_binding"}, "uniqueItems": true
    },
    "current_static_findings": {
      "type": "array", "minItems": 10,
      "items": {"$ref": "#/$defs/finding"}, "uniqueItems": true
    },
    "spool_state_machine": {"$ref": "#/$defs/state_machine"},
    "function_contracts": {
      "type": "array", "minItems": 9,
      "items": {"$ref": "#/$defs/function_contract"}, "uniqueItems": true
    },
    "missing_atomic_leaves": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/missing_leaf"}, "uniqueItems": true
    },
    "registry_revision_gate": {"$ref": "#/$defs/registry_revision_gate"},
    "sequencing": {
      "type": "array", "minItems": 9,
      "items": {"$ref": "#/$defs/sequence_step"}, "uniqueItems": true
    },
    "negative_tests": {
      "type": "array", "minItems": 16,
      "items": {"$ref": "#/$defs/test_case"}, "uniqueItems": true
    },
    "rollback": {"$ref": "#/$defs/rollback"},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "forbidden", "proof_ceiling"],
      "properties": {
        "allowed": {"const": "candidate-bound static P0 analysis and function-level target design exist for the M02 PCAP durable spool slice, with uncovered atomic work explicitly blocked"},
        "forbidden": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "proof_ceiling": {"const": "STATIC_DESIGN_ONLY_MISSING_ATOMIC_LEAVES_NOT_IMPLEMENTED_TESTED_EXECUTION_AUTHORIZED_OR_ACCEPTED"}
      }
    },
    "blockers": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 3}, "uniqueItems": true}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "source_blob_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_blob_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "leaf_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["leaf_id", "atomic_pr_id", "role", "locator"],
      "properties": {
        "leaf_id": {"type": "string", "pattern": "^M02-N006-L(?:0[4-8]|1[2567])$"},
        "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P1(?:8[3-7]|9[12456])-WRT-n006-l(?:0[4-8]|1[2567])$"},
        "role": {"enum": ["UPLOAD_CONSUMER", "DURABLE_SPOOL", "BUFFER_LEASE", "JOURNAL_PENDING", "ROTATOR_PRODUCER", "OBJECT_RECEIPT", "JOURNAL_RECEIPT", "MAIN_UPLOAD", "RECOVERY"]},
        "locator": {"type": "string", "minLength": 3}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "severity", "path", "symbol", "evidence", "consequence", "evidence_kind"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^M02-PCAP-P0-[0-9]{2}$"},
        "severity": {"const": "P0"},
        "path": {"type": "string", "minLength": 3},
        "symbol": {"type": "string", "minLength": 3},
        "evidence": {"type": "string", "minLength": 8},
        "consequence": {"type": "string", "minLength": 8},
        "evidence_kind": {"const": "CURRENT_WORKTREE_STATIC_EVIDENCE_NOT_RUNTIME_REPRODUCTION"}
      }
    },
    "state_machine": {
      "type": "object", "additionalProperties": false,
      "required": ["states", "transitions", "invariants"],
      "properties": {
        "states": {"type": "array", "minItems": 10, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "transitions": {"type": "array", "minItems": 11, "items": {"$ref": "#/$defs/transition"}, "uniqueItems": true},
        "invariants": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 8}, "uniqueItems": true}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "event", "to", "durability_barrier"],
      "properties": {
        "from": {"type": "string", "minLength": 3},
        "event": {"type": "string", "minLength": 3},
        "to": {"type": "string", "minLength": 3},
        "durability_barrier": {"type": "string", "minLength": 3}
      }
    },
    "function_contract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "contract_id", "leaf_id", "language", "path", "qualified_symbol",
        "change_kind", "signature_before", "signature_after", "responsibility",
        "inputs", "outputs", "body_steps", "error_branches", "atomicity",
        "idempotency", "callers", "callees", "tests", "rollback"
      ],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^FC-M02-PCAP-[A-Za-z0-9-]+$"},
        "leaf_id": {"type": "string", "pattern": "^M02-N006-L(?:0[4-8]|1[2567])$"},
        "language": {"const": "rust"},
        "path": {"type": "string", "minLength": 3},
        "qualified_symbol": {"type": "string", "minLength": 3},
        "change_kind": {"enum": ["modify", "new_companion"]},
        "signature_before": {"type": ["string", "null"], "minLength": 3},
        "signature_after": {"type": "string", "minLength": 8},
        "responsibility": {"type": "string", "minLength": 8},
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "body_steps": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^B[0-9]{2} .+"}, "uniqueItems": true},
        "error_branches": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "atomicity": {"type": "string", "minLength": 8},
        "idempotency": {"type": "string", "minLength": 8},
        "callers": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "callees": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TC-M02-PCAP-[0-9]{2}$"}, "uniqueItems": true},
        "rollback": {"type": "string", "minLength": 8}
      }
    },
    "missing_leaf": {
      "type": "object", "additionalProperties": false,
      "required": ["gap_id", "required_locator", "proposed_signature", "single_result", "reason", "blocked_by", "resolution", "status"],
      "properties": {
        "gap_id": {"type": "string", "pattern": "^M02-PCAP-GAP-0[1-3]$"},
        "required_locator": {"type": "string", "minLength": 3},
        "proposed_signature": {"type": "string", "minLength": 16},
        "single_result": {"type": "string", "minLength": 8},
        "reason": {"type": "string", "minLength": 8},
        "blocked_by": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
        "resolution": {"type": "string", "minLength": 8},
        "status": {"const": "BLOCKED_MISSING_ATOMIC_LEAF_AND_STABLE_ID"}
      }
    },
    "registry_revision_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "frozen_epoch", "active_global_m02_pr_count", "preview_leaf_count", "revision_requirements", "support_train", "atomic_switch"],
      "properties": {
        "decision": {"const": "KEEP_GAPS_BLOCKED_UNTIL_FORMAL_REGISTRY_REVISION"},
        "frozen_epoch": {"const": "T1-M02-P101-P307"},
        "active_global_m02_pr_count": {"const": 34},
        "preview_leaf_count": {"const": 207},
        "revision_requirements": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
        "support_train": {"const": "EACH_NEW_PRODUCTION_WRT_REQUIRES_DISTINCT_REF_AND_TST_CLOSURE_PLUS_ONE_UNIQUE_TERMINAL_IDX_OR_EXPLICIT_TOMBSTONE_REPLACEMENT"},
        "atomic_switch": {"const": "TASK_CLAIM_PR_DESIGN_AND_OVERLAY_CATALOGS_MUST_SWITCH_TO_ONE_CANDIDATE_HASH_OR_OLD_34_M02_CARDS_REMAIN_ACTIVE"}
      }
    },
    "sequence_step": {
      "type": "object", "additionalProperties": false,
      "required": ["order", "leaf_id", "precondition", "result", "activation"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "leaf_id": {"type": "string", "pattern": "^M02-N006-L(?:0[4-8]|1[2567])$"},
        "precondition": {"type": "string", "minLength": 3},
        "result": {"type": "string", "minLength": 3},
        "activation": {"type": "string", "minLength": 3}
      }
    },
    "test_case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "kind", "injection", "oracle", "execution_status"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^TC-M02-PCAP-[0-9]{2}$"},
        "kind": {"enum": ["negative", "fault", "recovery", "concurrency", "compatibility", "property", "shutdown"]},
        "injection": {"type": "string", "minLength": 3},
        "oracle": {"type": "string", "minLength": 8},
        "execution_status": {"const": "NOT_RUN"}
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["entrypoint", "steps", "durable_data_policy", "irreversible_boundary"],
      "properties": {
        "entrypoint": {"type": "string", "minLength": 3},
        "steps": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 8}, "uniqueItems": true},
        "durable_data_policy": {"type": "string", "minLength": 8},
        "irreversible_boundary": {"type": "string", "minLength": 8}
      }
    }
  }
}
