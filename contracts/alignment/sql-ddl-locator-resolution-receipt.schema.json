{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/sql-ddl-locator-resolution-receipt.schema.json",
  "title": "Candidate-bound PostgreSQL or ClickHouse DDL locator receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "status", "proof_level", "candidate",
    "resolver", "locator", "ambiguity_count", "resolved_at", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "SQL_DDL_LOCATOR_RESOLUTION_RECEIPT"},
    "status": {"const": "RESOLVED"},
    "proof_level": {"const": "DIALECT_DDL_PARSE_TREE"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "resolver": {"$ref": "#/$defs/resolver"},
    "locator": {"$ref": "#/$defs/locator"},
    "ambiguity_count": {"const": 1},
    "resolved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "proof_ceiling": {"const": "EXACT_DDL_LOCATOR_ONLY_NOT_MIGRATION_SAFETY_DATABASE_COMPATIBILITY_DEPLOYMENT_OR_EXECUTION_AUTHORIZATION"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "manifest_path", "manifest_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "resolver": {
      "type": "object", "additionalProperties": false,
      "required": ["resolver_id", "engine", "engine_version", "source_path", "source_sha256"],
      "properties": {
        "resolver_id": {"const": "traffic-sql-ddl-locator@1"},
        "engine": {"const": "traffic-stdlib-ddl-token-parser"},
        "engine_version": {"const": "postgres-clickhouse-ddl-v1"},
        "source_path": {"const": "scripts/alignment/sql_ddl_locator.py"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "position": {
      "type": "object", "additionalProperties": false,
      "required": ["byte_offset", "line", "column"],
      "properties": {
        "byte_offset": {"type": "integer", "minimum": 0},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      }
    },
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "statement_kind", "qualified_object", "normalized_statement_sha256", "source_span_sha256", "start", "end"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "statement_kind": {"enum": ["CREATE_TABLE", "ALTER_TABLE"]},
        "qualified_object": {"type": "string", "minLength": 1},
        "normalized_statement_sha256": {"$ref": "#/$defs/sha256"},
        "source_span_sha256": {"$ref": "#/$defs/sha256"},
        "start": {"$ref": "#/$defs/position"},
        "end": {"$ref": "#/$defs/position"}
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": [
        "locator_id", "language", "dialect", "path", "query", "match_strategy",
        "declaration_kind", "qualified_object", "statement_count", "statements",
        "candidate_blob_sha256", "source_span_sha256", "normalized_parse_tree_sha256",
        "start", "end"
      ],
      "properties": {
        "locator_id": {"type": "string", "pattern": "^LOC-[A-Za-z0-9._-]+$"},
        "language": {"const": "sql"},
        "dialect": {"enum": ["postgres", "clickhouse"]},
        "path": {"type": "string", "pattern": "^deployments/(?:postgres|clickhouse)/migrations/.+\\.sql$"},
        "query": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "match_strategy": {"const": "EXACT_DIALECT_DDL_DECLARATION_OR_ALTER_TABLE_GROUP"},
        "declaration_kind": {"enum": ["TABLE", "CONSTRAINT", "ALTER_TABLE_GROUP"]},
        "qualified_object": {"type": "string", "minLength": 1},
        "statement_count": {"type": "integer", "minimum": 1},
        "statements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/statement"}},
        "candidate_blob_sha256": {"$ref": "#/$defs/sha256"},
        "source_span_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_parse_tree_sha256": {"$ref": "#/$defs/sha256"},
        "start": {"$ref": "#/$defs/position"},
        "end": {"$ref": "#/$defs/position"}
      }
    }
  }
}
