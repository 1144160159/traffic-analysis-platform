{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/function-design-review-receipt.schema.json",
  "title": "Function design review receipt over immutable upstream artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "receipt_id", "atomic_pr_id", "candidate",
    "pattern_decision_ref", "code_unit_contract_ref", "function_exact_set_sha256",
    "test_oracle_exact_set_sha256", "negative_test_manifest_ref", "review_disposition",
    "unresolved_p0", "vetoes", "signed_payload_sha256", "attestations", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "FUNCTION_DESIGN_REVIEW_RECEIPT"},
    "receipt_id": {"type": "string", "pattern": "^FDR-[A-Za-z0-9._-]+$"},
    "atomic_pr_id": {"type": "string", "pattern": "^T1-M[0-9]{2}(?:-R[0-9]{2})?-P[0-9]{3}-[A-Z-]+-[a-z0-9-]+$"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "pattern_decision_ref": {"allOf": [{"$ref": "#/$defs/decision_ref"}, {"properties": {"artifact_kind": {"const": "FINAL_PATTERN_DECISION"}}}]},
    "code_unit_contract_ref": {"allOf": [{"$ref": "#/$defs/typed_ref"}, {"properties": {"artifact_kind": {"const": "CODE_UNIT_CONTRACT"}}}]},
    "function_exact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_oracle_exact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "negative_test_manifest_ref": {"$ref": "#/$defs/typed_ref"},
    "review_disposition": {"enum": ["UNIFIED", "SPLIT_PR", "REVISE", "BLOCKED"]},
    "unresolved_p0": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
    "vetoes": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
    "signed_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attestations": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/attestation"}, "uniqueItems": true},
    "proof_ceiling": {"const": "FUNCTION_DESIGN_REVIEW_ONLY_NOT_EXECUTION_OR_IMPLEMENTATION_ACCEPTANCE"}
  },
  "allOf": [
    {
      "if": {"properties": {"review_disposition": {"const": "UNIFIED"}}},
      "then": {"properties": {"unresolved_p0": {"maxItems": 0}, "vetoes": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "candidate": {"type": "object", "additionalProperties": false, "required": ["commit", "manifest_path", "manifest_sha256"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "manifest_path": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "decision_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_kind", "decision_id", "path", "sha256", "candidate_manifest_sha256"], "properties": {"artifact_kind": {"type": "string", "minLength": 3}, "decision_id": {"type": "string", "minLength": 3}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "typed_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_kind", "path", "sha256", "candidate_manifest_sha256"], "properties": {"artifact_kind": {"type": "string", "minLength": 3}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "attestation": {"type": "object", "additionalProperties": false, "required": ["role", "reviewer_identity", "payload_sha256", "policy_id", "signature_artifact_ref"], "properties": {"role": {"enum": ["LANGUAGE_OWNER", "QA_SRE_PERFORMANCE_EXPERT", "MAINTAINABILITY_RED_TEAM", "ADJUDICATOR"]}, "reviewer_identity": {"type": "string", "minLength": 3}, "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "policy_id": {"type": "string", "minLength": 3}, "signature_artifact_ref": {"$ref": "#/$defs/hash_ref"}}},
    "hash_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
