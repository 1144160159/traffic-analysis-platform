{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/shell-ast-locator-resolution-receipt.schema.json",
  "title": "Candidate-bound shell AST locator resolution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "status", "proof_level", "candidate", "resolver", "locator", "ambiguity_count", "resolved_at", "proof_ceiling"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "SHELL_AST_LOCATOR_RESOLUTION_RECEIPT"},
    "status": {"const": "RESOLVED"},
    "proof_level": {"const": "LANGUAGE_AST"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "resolver": {"$ref": "#/$defs/resolver"},
    "locator": {"$ref": "#/$defs/locator"},
    "ambiguity_count": {"const": 1},
    "resolved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "proof_ceiling": {"const": "EXACT_LOCATOR_ONLY_NOT_SHELL_BEHAVIOR_DEPLOYMENT_OR_EXECUTION_AUTHORIZATION"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "manifest_path", "manifest_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "resolver": {
      "type": "object", "additionalProperties": false,
      "required": ["resolver_id", "engine", "engine_version", "source_path", "source_sha256"],
      "properties": {
        "resolver_id": {"const": "traffic-shell-ast-locator@1"},
        "engine": {"const": "mvdan.cc/sh/syntax"},
        "engine_version": {"const": "mvdan.cc/sh/v3-v3.13.1"},
        "source_path": {"const": "scripts/alignment/shell_ast_locator/main.go"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "position": {
      "type": "object", "additionalProperties": false,
      "required": ["byte_offset", "line", "column"],
      "properties": {
        "byte_offset": {"type": "integer", "minimum": 0},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false,
      "required": ["locator_id", "language", "path", "query", "match_strategy", "rendered_word", "literal_value", "candidate_blob_sha256", "source_span_sha256", "normalized_ast_sha256", "start", "end"],
      "properties": {
        "locator_id": {"type": "string", "pattern": "^LOC-[A-Za-z0-9._-]+$"},
        "language": {"const": "shell"},
        "path": {"type": "string", "pattern": "^.+\\.sh$"},
        "query": {"type": "string", "minLength": 1},
        "match_strategy": {"const": "EXACT_AST_WORD_FIRST_COLON_FIELD"},
        "rendered_word": {"type": "string", "minLength": 1},
        "literal_value": {"type": "string", "minLength": 1},
        "candidate_blob_sha256": {"$ref": "#/$defs/sha256"},
        "source_span_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_ast_sha256": {"$ref": "#/$defs/sha256"},
        "start": {"$ref": "#/$defs/position"},
        "end": {"$ref": "#/$defs/position"}
      }
    }
  }
}
