{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/alignment/m02-compatibility-default-off-review.schema.json",
  "title": "M02 candidate-bound compatibility and default-off review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "receipt_id", "atomic_pr_id", "candidate",
    "target_locators", "target_locator_exact_set_sha256", "compatibility_mode",
    "default_runtime_state", "legacy_contract_preserved", "compatibility_contract_ref",
    "verification_plan_ref", "rollback_plan_ref", "review_disposition", "unresolved_p0",
    "signed_payload_sha256", "attestations", "proof_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "M02_COMPATIBILITY_DEFAULT_OFF_REVIEW_RECEIPT"},
    "receipt_id": {"type": "string", "pattern": "^CDR-[A-Za-z0-9._-]+$"},
    "atomic_pr_id": {"type": "string", "pattern": "^T1-M02-P[0-9]{3}-[A-Z-]+-n[0-9]{3}-l[0-9]{2,3}$"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "target_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "target_locator_exact_set_sha256": {"$ref": "#/$defs/sha256"},
    "compatibility_mode": {"enum": ["ADDITIVE_DEFAULT_OFF", "ADDITIVE_BACKWARD_COMPATIBLE", "NO_RUNTIME_BEHAVIOR_CHANGE", "TEST_OR_EVIDENCE_ONLY"]},
    "default_runtime_state": {"enum": ["DISABLED_UNLESS_EXPLICITLY_ENABLED", "LEGACY_BEHAVIOR_PRESERVED", "NO_RUNTIME_CHANGE"]},
    "legacy_contract_preserved": {"const": true},
    "compatibility_contract_ref": {"$ref": "#/$defs/typed_ref"},
    "verification_plan_ref": {"$ref": "#/$defs/typed_ref"},
    "rollback_plan_ref": {"$ref": "#/$defs/typed_ref"},
    "review_disposition": {"const": "APPROVED"},
    "unresolved_p0": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
    "attestations": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/attestation"}},
    "proof_ceiling": {"const": "COMPATIBILITY_DEFAULT_OFF_REVIEW_ONLY_NOT_LOCATOR_RESOLUTION_IMPLEMENTATION_EXECUTION_SWITCH_OR_ACCEPTANCE"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "manifest_path", "manifest_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "typed_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "path", "sha256", "candidate_manifest_sha256"],
      "properties": {
        "artifact_kind": {"type": "string", "minLength": 3},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "reviewer_identity", "payload_sha256", "policy_id", "signature_artifact_ref"],
      "properties": {
        "role": {"enum": ["DOMAIN_OWNER", "COMPATIBILITY_REVIEWER", "QA_SRE_PERFORMANCE_EXPERT", "ADJUDICATOR"]},
        "reviewer_identity": {"type": "string", "minLength": 3},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "policy_id": {"type": "string", "minLength": 3},
        "signature_artifact_ref": {"$ref": "#/$defs/hash_ref"}
      }
    },
    "hash_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
