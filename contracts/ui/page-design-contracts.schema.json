{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis.local/contracts/ui/page-design-contracts.schema.json",
  "title": "Traffic Analysis UI Page Design Contract Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "baseline_viewport",
    "design_system",
    "candidate_binding",
    "shared_rules",
    "pages",
    "compatibility_aliases"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "contract_id": {"const": "UI-ADD-001"},
    "contract_version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"},
    "baseline_viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "device_scale_factor", "browser", "mock_enabled"],
      "properties": {
        "width": {"const": 1920},
        "height": {"const": 1080},
        "device_scale_factor": {"const": 1},
        "browser": {"const": "Windows Chrome"},
        "mock_enabled": {"const": false}
      }
    },
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens_source", "required_tokens", "component_library"],
      "properties": {
        "tokens_source": {"type": "string", "minLength": 1},
        "required_tokens": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^--"}},
        "component_library": {"const": "Ant Design 5 plus repository-native components"}
      }
    },
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "manifest_path", "required_hashes"],
      "properties": {
        "required": {"const": true},
        "manifest_path": {"type": "string", "minLength": 1},
        "required_hashes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["contract_sha256", "route_manifest_sha256", "page_api_plans_sha256", "dist_sha256", "image_id"]}
        }
      }
    },
    "shared_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_preserve", "prohibited", "required_states", "reviewer"],
      "properties": {
        "must_preserve": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prohibited": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_states": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reviewer": {"type": "string", "minLength": 1}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {"$ref": "#/$defs/page"}
    },
    "compatibility_aliases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/alias"}
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "route",
        "component",
        "auth_mode",
        "baseline_state",
        "target_task",
        "visual_truth",
        "information_architecture",
        "api_plan_key",
        "typescript_contracts",
        "feature_ids",
        "required_scopes",
        "must_preserve",
        "owner",
        "reviewer"
      ],
      "properties": {
        "page_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "route": {"type": "string", "minLength": 1},
        "component": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$"},
        "auth_mode": {"enum": ["public", "protected", "protected-readonly"]},
        "baseline_state": {"type": "string", "minLength": 1},
        "target_task": {"type": "string", "minLength": 8},
        "visual_truth": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\.png$"}},
        "information_architecture": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "api_plan_key": {"type": ["string", "null"]},
        "typescript_contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\.ts$"}},
        "feature_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[FT]-[A-Z]+-[0-9]{3}$"}},
        "required_scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "must_preserve": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string", "pattern": "^WP-[0-9]{2}-"},
        "reviewer": {"const": "QA-UI-INDEPENDENT"}
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "legacy_path", "canonical_page_id", "redirect_target", "api_plan_key"],
      "properties": {
        "route_id": {"type": "string", "pattern": "^topic-"},
        "legacy_path": {"type": "string", "pattern": "^/topics/"},
        "canonical_page_id": {"const": "topics"},
        "redirect_target": {"type": "string", "pattern": "^/topics\\?topic="},
        "api_plan_key": {"type": "string", "pattern": "^topic-"}
      }
    }
  }
}
