{
  "schema_version": 1,
  "contract_id": "traffic-platform-flink-sink-reconciliation-v1",
  "remediation_id": "T-FLINK-004",
  "scope": "Canonical nine Flink jobs, external sink acknowledgement, replay marking and key-level reconciliation. Static G0/G1 guards do not prove live G2/G3 reconciliation.",
  "protocol": {
    "jdbc": "stable business key plus projection version; retain checkpoint state until executeBatch receipt",
    "opensearch": "stable document id; bounded retry; any failed bulk item fails the operator",
    "http": "stable event identity in payload or idempotency key; bounded retry; only explicit 2xx receipt clears pending state",
    "minio": "temporary object followed by immutable manifest containing sha256, size, state and business reference",
    "replay_marker": "replay_id is assigned before replay processing; empty means online traffic",
    "reconciliation": "compare event_id or a documented derived business key and version; count-only comparison is forbidden"
  },
  "required_job_metrics": [
    "input_total",
    "accepted_total",
    "dropped_total",
    "late_total",
    "failed_total",
    "dlq_total",
    "sink_success_total",
    "last_watermark"
  ],
  "jobs": [
    {
      "id": "flink-session-job",
      "reconciliation_keys": ["event_id", "tenant_id+session_id+state_version"],
      "sinks": ["ClickHouse flows_raw", "ClickHouse sessions", "OpenSearch sessions_v1", "Kafka sessions.v1 and dlq.v1"],
      "gaps": ["unified eight-metric vector", "replay_id on every projection", "live source-offset to CH/OS/Kafka key reconciliation"]
    },
    {
      "id": "flink-feature-job",
      "reconciliation_keys": ["event_id", "tenant_id+session_id+feature_set_id"],
      "sinks": ["ClickHouse features", "Kafka features.v1, dlq.v1 and l2 trigger"],
      "gaps": ["checkpointed JDBC ACK receipt", "unified eight-metric vector", "replay_id and live key reconciliation"]
    },
    {
      "id": "flink-rule-job",
      "reconciliation_keys": ["event_id", "tenant_id+detection_id"],
      "sinks": ["ClickHouse detections", "Kafka detections.v1 and dlq.v1"],
      "gaps": ["checkpointed JDBC ACK receipt", "unified eight-metric vector", "replay_id and live key reconciliation"]
    },
    {
      "id": "flink-pcap-index-job",
      "reconciliation_keys": ["tenant_id+probe_id+file_key+ts_start+ts_end"],
      "sinks": ["ClickHouse pcap_index", "Kafka dlq.v1"],
      "gaps": ["sink-owned executeBatch success metric", "checkpointed JDBC receipt", "replay_id and live object-manifest/index reconciliation"]
    },
    {
      "id": "flink-cep-job",
      "reconciliation_keys": ["event_id", "tenant_id+campaign_id"],
      "sinks": ["ClickHouse campaigns", "Kafka campaigns.v1 and dlq.v1"],
      "gaps": ["checkpointed JDBC ACK receipt", "unified eight-metric vector", "replay_id and live key reconciliation"]
    },
    {
      "id": "flink-behavior-job",
      "reconciliation_keys": ["event_id", "tenant_id+detection_id"],
      "sinks": ["ClickHouse detections_behavior", "Kafka detections.v1 and model-update ACK"],
      "gaps": ["checkpointed JDBC ACK receipt", "unified eight-metric vector", "replay_id and live key reconciliation"]
    },
    {
      "id": "flink-alert-generator-job",
      "reconciliation_keys": ["alert_id", "evidence_id", "event_id"],
      "sinks": ["ClickHouse alerts and evidence", "OpenSearch alerts", "Kafka alerts.v1"],
      "gaps": ["checkpointed JDBC ACK receipt", "unified eight-metric vector", "replay_id and live CH/OS/Kafka key reconciliation"]
    },
    {
      "id": "flink-log-job",
      "reconciliation_keys": ["log_id"],
      "sinks": ["Loki HTTP push", "OpenSearch device logs"],
      "gaps": ["Loki effect is at-least-once rather than idempotent", "unified eight-metric vector", "replay_id and live Loki/OpenSearch key reconciliation"]
    },
    {
      "id": "flink-user-behavior-job",
      "reconciliation_keys": ["anomaly_id+event_version", "alert_id"],
      "sinks": ["ClickHouse user_anomalies_v2", "Kafka alerts.v1 and dlq.v1"],
      "gaps": ["unified late/DLQ/last-watermark export", "live source-offset to user_anomalies_v2/alerts/DLQ key reconciliation"]
    }
  ],
