    {
      "source": "java/flink-jobs/flink-session-job/src/main/java/com/traffic/flink/session/sink/FlowRawClickHouseSinkFunction.java",
      "state_name": "clickhouse-flow-raw-pending-v1",
      "ack_token": "writeWithRetry(batch);",
      "clear_token": "buffer.subList(0, batch.size()).clear();",
      "guarantee": "at-least-once with deterministic event_id"
    },
    {
      "source": "java/flink-jobs/flink-session-job/src/main/java/com/traffic/flink/session/sink/OpenSearchSinkFunction.java",
      "state_name": "opensearch-session-pending-v1",
      "ack_token": "client.bulk(bulkRequest, RequestOptions.DEFAULT)",
      "clear_token": "buffer.clear();",
      "guarantee": "effectively-once document projection by deterministic event_id"
    },
    {
      "source": "java/flink-jobs/flink-log-job/src/main/java/com/traffic/flink/log/sink/LokiSinkFactory.java",
      "state_name": "loki-pending-streams-v1",
      "ack_token": "status >= 200 && status < 300",
      "clear_token": "pendingStreams.subList(0, attempt.size()).clear();",
      "guarantee": "at-least-once HTTP delivery with retained retry buffer"
    }
  ],
  "business_time": {
    "job_id": "flink-user-behavior-job",
