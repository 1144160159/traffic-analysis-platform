{
  "schema_version": 1,
  "contract_id": "flink-application-cluster-migration-v1",
  "phase": "expand",
  "namespace": "flink",
  "source_session_cluster_id": "flink-traffic",
  "application_image": {
    "build_file": "java/flink-jobs/deployments/Dockerfile.application",
    "required_reference": "repository@sha256:<64-lowercase-hex>"
  },
  "state": {
    "checkpoint_root": "s3://flink-checkpoints/checkpoints/application-clusters",
    "savepoint_root": "s3://flink-checkpoints/savepoints/application-clusters",
    "ha_root": "s3://flink-checkpoints/ha/application-clusters",
    "job_result_root": "s3://flink-checkpoints/job-result-store/application-clusters",
    "rollback_savepoint_retention": "until G7 plus T+7 observation and explicit approval",
    "allow_non_restored_state": false
  },
  "migration": {
    "strategy": "serial-stop-with-savepoint-restore",
    "max_parallel_applications_during_migration": 1,
    "preconditions": [
      "source job RUNNING with no root exception",
      "fresh completed checkpoint recorded",
      "stop-with-savepoint completed under the job-specific savepoint prefix",
      "savepoint manifest sha256 and source job id recorded",
      "application image digest and contract digest recorded"
    ],
    "success_conditions": [
      "exactly one RUNNING job with canonical name",
      "all expected tasks RUNNING",
      "restore count is positive",
      "new completed checkpoint exists under the job-specific checkpoint path",
      "Kafka principal and consumer group match this contract",
      "source and projections reconcile within the approved window"
    ],
    "rollback": [
      "cancel the new application cluster without disposing the retained savepoint",
      "restore the source Session Cluster job from the retained rollback savepoint",
      "do not use allowNonRestoredState",
      "verify RUNNING tasks, a new checkpoint, Kafka lag and sink reconciliation"
    ]
  },
  "online_expand_budget": {
    "max_additional_cpu_requests": 8,
    "max_additional_memory_requests_gib": 22,
    "automatic_pause_on_exceed": true
  },
  "common_resources": {
    "jobmanager": {"cpu": 1, "memory_process": "2048m", "replicas": 2},
    "taskmanager": {"cpu": 2, "memory_process": "6144m", "slots": 4},
    "local_rocksdb_empty_dir_size": "20Gi"
  },
  "jobs": [
    {
      "migration_order": 1,
      "id": "flink-pcap-index-job",
      "cluster_id": "flink-app-pcap-index",
      "principal_id": "flink-pcap-index-job",
      "job_name": "PCAP Index Job v2",
      "module": "flink-pcap-index-job",
      "main_class": "com.traffic.flink.pcap.PcapIndexJob",
      "jar_uri": "local:///opt/flink/usrlib/flink-pcap-index-job.jar",
      "parallelism": 2,
      "max_parallelism": 128,
      "expected_tasks": 2,
      "taskmanager_replicas_ceiling": 1
    },
    {
      "migration_order": 2,
      "id": "flink-user-behavior-job",
      "cluster_id": "flink-app-user-behavior",
      "principal_id": "flink-user-behavior-job",
      "job_name": "User Behavior Anomaly Detection Job",
      "module": "flink-user-behavior-job",
      "main_class": "com.traffic.flink.behavior.user.UserBehaviorJob",
      "jar_uri": "local:///opt/flink/usrlib/flink-user-behavior-job.jar",
      "parallelism": 2,
      "max_parallelism": 128,
      "expected_tasks": 10,
      "taskmanager_replicas_ceiling": 1
    },
    {
