{
  "schema_version": 1,
  "contract_id": "t1-m03-n012-online-offline-parity-v1",
  "identity": {
    "route_specific_fields": ["event_id", "run_id", "session_id", "object_id", "window_id"],
    "processing_telemetry_fields": ["ingest_ts", "kafka_ts", "flink_out_ts"],
    "rule": "online and offline use different run_id values; route-specific identities and processing clocks are excluded while stable business keys and lineage cardinality remain compared",
