{
  "schema_version": 1,
  "catalog_id": "traffic-platform-kafka-acls-v1",
  "topic_catalog": "contracts/events/kafka-topic-catalog.v1.json",
  "policy": {
    "resource_pattern_type": "literal",
    "producer_topic_operations": ["Write", "Describe"],
    "consumer_topic_operations": ["Read", "Describe"],
    "consumer_group_operations": ["Read", "Describe"],
    "producer_cluster_operations": ["IdempotentWrite"],
    "forbidden_operations": ["All", "Alter", "ClusterAction", "Create", "Delete"],
    "forbid_wildcards": true,
    "legacy_shared_principal_env": "KAFKA_CLIENT_USERNAME",
    "migration_phases": ["expand", "cutover"]
  },
  "principals": [
    {"id":"ingest-gateway","principal":"User:traffic-ingest-gateway","kind":"service","rollout_state":"expand","credential":{"namespace":"traffic-analysis","secret_name":"kafka-ingest-gateway-credentials","password_env":"KAFKA_INGEST_GATEWAY_PASSWORD","remote_password_property":"KAFKA_INGEST_GATEWAY_PASSWORD","workload":"ingest-gateway"}},
    {"id":"auth-service","principal":"User:traffic-auth-service","kind":"service","rollout_state":"expand","credential":{"namespace":"traffic-analysis","secret_name":"kafka-auth-service-credentials","password_env":"KAFKA_AUTH_SERVICE_PASSWORD","remote_password_property":"KAFKA_AUTH_SERVICE_PASSWORD","workload":"auth-service"}},
    {"id":"alert-service","principal":"User:traffic-alert-service","kind":"service","rollout_state":"expand","credential":{"namespace":"traffic-analysis","secret_name":"kafka-alert-service-credentials","password_env":"KAFKA_ALERT_SERVICE_PASSWORD","remote_password_property":"KAFKA_ALERT_SERVICE_PASSWORD","workload":"alert-service"}},
    {"id":"asset-service","principal":"User:traffic-asset-service","kind":"service","rollout_state":"expand","credential":{"namespace":"traffic-analysis","secret_name":"kafka-asset-service-credentials","password_env":"KAFKA_ASSET_SERVICE_PASSWORD","remote_password_property":"KAFKA_ASSET_SERVICE_PASSWORD","workload":"asset-service"}},
    {"id":"rule-manager","principal":"User:traffic-rule-manager","kind":"service","rollout_state":"expand","credential":{"namespace":"traffic-analysis","secret_name":"kafka-rule-manager-credentials","password_env":"KAFKA_RULE_MANAGER_PASSWORD","remote_password_property":"KAFKA_RULE_MANAGER_PASSWORD","workload":"rule-manager"}},
    {"id":"graph-service","principal":"User:traffic-graph-service","kind":"service","rollout_state":"expand","credential":{"namespace":"traffic-analysis","secret_name":"kafka-graph-service-credentials","password_env":"KAFKA_GRAPH_SERVICE_PASSWORD","remote_password_property":"KAFKA_GRAPH_SERVICE_PASSWORD","workload":"graph-service"}},
    {"id":"forensics-service","principal":"User:traffic-forensics-service","kind":"service","rollout_state":"expand","credential":{"namespace":"traffic-analysis","secret_name":"kafka-forensics-service-credentials","password_env":"KAFKA_FORENSICS_SERVICE_PASSWORD","remote_password_property":"KAFKA_FORENSICS_SERVICE_PASSWORD","workload":"forensics-service"}},
    {"id":"threat-intel-service","principal":"User:traffic-threat-intel-service","kind":"service","rollout_state":"expand","credential":{"namespace":"traffic-analysis","secret_name":"kafka-threat-intel-service-credentials","password_env":"KAFKA_THREAT_INTEL_SERVICE_PASSWORD","remote_password_property":"KAFKA_THREAT_INTEL_SERVICE_PASSWORD","workload":"threat-intel-service"}},
    {"id":"audit-materializer","principal":"User:traffic-audit-materializer","kind":"consumer","rollout_state":"expand","credential":{"namespace":"traffic-analysis","secret_name":"kafka-audit-materializer-credentials","password_env":"KAFKA_AUDIT_MATERIALIZER_PASSWORD","remote_password_property":"KAFKA_AUDIT_MATERIALIZER_PASSWORD","workload":"audit-materializer"}},
    {"id":"flink-session-job","principal":"User:traffic-flink-session","kind":"flink_job","rollout_state":"expand","credential":{"namespace":"flink","secret_name":"kafka-flink-session-job-credentials","password_env":"KAFKA_FLINK_SESSION_JOB_PASSWORD","remote_password_property":"KAFKA_FLINK_SESSION_JOB_PASSWORD","workload":"flink-session-job"}},
    {"id":"flink-feature-job","principal":"User:traffic-flink-feature","kind":"flink_job","rollout_state":"expand","credential":{"namespace":"flink","secret_name":"kafka-flink-feature-job-credentials","password_env":"KAFKA_FLINK_FEATURE_JOB_PASSWORD","remote_password_property":"KAFKA_FLINK_FEATURE_JOB_PASSWORD","workload":"flink-feature-job"}},
    {"id":"flink-rule-job","principal":"User:traffic-flink-rule","kind":"flink_job","rollout_state":"expand","credential":{"namespace":"flink","secret_name":"kafka-flink-rule-job-credentials","password_env":"KAFKA_FLINK_RULE_JOB_PASSWORD","remote_password_property":"KAFKA_FLINK_RULE_JOB_PASSWORD","workload":"flink-rule-job"}},
    {"id":"flink-behavior-job","principal":"User:traffic-flink-behavior","kind":"flink_job","rollout_state":"expand","credential":{"namespace":"flink","secret_name":"kafka-flink-behavior-job-credentials","password_env":"KAFKA_FLINK_BEHAVIOR_JOB_PASSWORD","remote_password_property":"KAFKA_FLINK_BEHAVIOR_JOB_PASSWORD","workload":"flink-behavior-job"}},
    {"id":"flink-alert-generator-job","principal":"User:traffic-flink-alert-generator","kind":"flink_job","rollout_state":"expand","credential":{"namespace":"flink","secret_name":"kafka-flink-alert-generator-job-credentials","password_env":"KAFKA_FLINK_ALERT_GENERATOR_JOB_PASSWORD","remote_password_property":"KAFKA_FLINK_ALERT_GENERATOR_JOB_PASSWORD","workload":"flink-alert-generator-job"}},
    {"id":"flink-cep-job","principal":"User:traffic-flink-cep","kind":"flink_job","rollout_state":"expand","credential":{"namespace":"flink","secret_name":"kafka-flink-cep-job-credentials","password_env":"KAFKA_FLINK_CEP_JOB_PASSWORD","remote_password_property":"KAFKA_FLINK_CEP_JOB_PASSWORD","workload":"flink-cep-job"}},
    {"id":"flink-pcap-index-job","principal":"User:traffic-flink-pcap-index","kind":"flink_job","rollout_state":"expand","credential":{"namespace":"flink","secret_name":"kafka-flink-pcap-index-job-credentials","password_env":"KAFKA_FLINK_PCAP_INDEX_JOB_PASSWORD","remote_password_property":"KAFKA_FLINK_PCAP_INDEX_JOB_PASSWORD","workload":"flink-pcap-index-job"}},
    {"id":"flink-log-job","principal":"User:traffic-flink-log","kind":"flink_job","rollout_state":"expand","credential":{"namespace":"flink","secret_name":"kafka-flink-log-job-credentials","password_env":"KAFKA_FLINK_LOG_JOB_PASSWORD","remote_password_property":"KAFKA_FLINK_LOG_JOB_PASSWORD","workload":"flink-log-job"}},
    {"id":"flink-user-behavior-job","principal":"User:traffic-flink-user-behavior","kind":"flink_job","rollout_state":"expand","credential":{"namespace":"flink","secret_name":"kafka-flink-user-behavior-job-credentials","password_env":"KAFKA_FLINK_USER_BEHAVIOR_JOB_PASSWORD","remote_password_property":"KAFKA_FLINK_USER_BEHAVIOR_JOB_PASSWORD","workload":"flink-user-behavior-job"}},
    {"id":"kafka-replayer","principal":"User:traffic-kafka-replayer","kind":"replayer","rollout_state":"disabled"},
    {"id":"kafka-operator","principal":"User:traffic-kafka-operator","kind":"operator","rollout_state":"planned"}
  ],
  "topic_bindings": [
    {"topic":"flow.events.v1","producers":["ingest-gateway"],"consumers":[{"principal":"flink-session-job","groups":["flink-session-job"]}]},
    {"topic":"flow.projection-replay.v1","producers":["alert-service"],"consumers":[{"principal":"alert-service","groups":["alert-service-flow-replay-projection-v1"]}]},
    {"topic":"session.events.v1","producers":["flink-session-job"],"consumers":[{"principal":"flink-feature-job","groups":["flink-feature-job"]}]},
    {"topic":"feature.stat.v1","producers":["flink-feature-job"],"consumers":[{"principal":"flink-rule-job","groups":["flink-rule-job"]},{"principal":"flink-behavior-job","groups":["flink-behavior-job"]}]},
    {"topic":"detections.v1","producers":["flink-rule-job"],"consumers":[{"principal":"flink-alert-generator-job","groups":["flink-alert-generator-job"]},{"principal":"alert-service","groups":["alert-service"]}]},
    {"topic":"alerts.v1","producers":["flink-alert-generator-job"],"consumers":[{"principal":"flink-cep-job","groups":["flink-cep-job"]}]},
    {"topic":"alert.feedback.v1","producers":["alert-service"],"consumers":[{"principal":"rule-manager","groups":["rule-manager-alert-feedback-projection-v1"]}]},
    {"topic":"alert.response.requested.v1","producers":["alert-service"],"consumers":[{"principal":"alert-service","groups":["alert-service-response-execution-v1"]}]},
    {"topic":"alert.assignment.events.v1","producers":["alert-service"],"consumers":[{"principal":"alert-service","groups":["alert-service-batch-assignment-execution-v1"]}]},
    {"topic":"alert.saved-view.events.v1","producers":["alert-service"],"consumers":[]},
    {"topic":"whitelist.events.v2","producers":["alert-service"],"consumers":[{"principal":"rule-manager","groups":["rule-manager-whitelist-rule-effect-v2"]}]},
    {"topic":"notification.governance.events.v1","producers":["alert-service"],"consumers":[]},
    {"topic":"campaign.events.v2","producers":["alert-service"],"consumers":[{"principal":"alert-service","groups":["alert-service-campaign-event-projection-v2"]}]},
    {"topic":"campaign.membership.events.v2","producers":["alert-service"],"consumers":[{"principal":"alert-service","groups":["alert-service-campaign-membership-projection-v2"]}]},
    {"topic":"playbook.execution.events.v2","producers":["alert-service"],"consumers":[{"principal":"alert-service","groups":["alert-service-playbook-execution-projection-v2"]}]},
    {"topic":"traffic.topic.action.v2","producers":["alert-service"],"consumers":[{"principal":"alert-service","groups":["alert-service-topic-action-projection-v2"]}]},
    {"topic":"dashboard.task.events.v1","producers":["alert-service"],"consumers":[{"principal":"alert-service","groups":["alert-service-dashboard-task-execution-v1"]}]},
    {"topic":"probe.control.v2","producers":["alert-service"],"consumers":[{"principal":"ingest-gateway","groups":["ingest-gateway-probe-control-v2"]}]},
    {"topic":"probe.acks.v2","producers":["ingest-gateway"],"consumers":[{"principal":"alert-service","groups":["alert-service-probe-acks-v2"]}]},
    {"topic":"dlq.probe.acks.v2","producers":["alert-service"],"consumers":[]},
    {"topic":"probe.events.v2","producers":["alert-service"],"consumers":[{"principal":"alert-service","groups":["alert-service-probe-event-projection-v2"]}]},
    {"topic":"pcap.index.v1","producers":["ingest-gateway"],"consumers":[{"principal":"flink-pcap-index-job","groups":["flink-pcap-index-job"]}]},
    {"topic":"rule.updates","producers":["rule-manager"],"consumers":[{"principal":"flink-rule-job","groups":["flink-rule-job-rule"]}]},
    {"topic":"model-updates","producers":["rule-manager"],"consumers":[{"principal":"flink-behavior-job","groups":["flink-behavior-job-model-updates"]}]},
    {"topic":"model-update-applied.v1","producers":["flink-behavior-job"],"consumers":[{"principal":"rule-manager","groups":["rule-manager-model-applied-v1"]}]},
    {"topic":"model-actions.v1","producers":["rule-manager"],"consumers":[{"principal":"rule-manager","groups":["rule-manager-model-action-execution-v1"]}]},
    {"topic":"deployment.events.v1","producers":["rule-manager"],"consumers":[{"principal":"rule-manager","groups":["rule-manager-deployment-projection-v1"]}]},
    {"topic":"audit.logs","producers":["ingest-gateway","auth-service","alert-service","asset-service","rule-manager","graph-service","forensics-service"],"consumers":[{"principal":"audit-materializer","groups":["audit-consumer"]}]},
    {"topic":"asset.bindings.v1","producers":[],"consumers":[{"principal":"asset-service","groups":["asset-service-bindings"]}]},
    {"topic":"asset.events.v2","producers":["asset-service"],"consumers":[{"principal":"asset-service","groups":["asset-projection-v2"]}]},
    {"topic":"asset.discovery.events.v1","producers":["asset-service"],"consumers":[]},
    {"topic":"asset.exports.v1","producers":["asset-service"],"consumers":[]},
    {"topic":"device.logs.v1","producers":[],"consumers":[{"principal":"flink-log-job","groups":["flink-log-job"]}]},
    {"topic":"user.events.v1","producers":["auth-service"],"consumers":[{"principal":"flink-user-behavior-job","groups":["flink-user-behavior-job"]}]},
    {"topic":"threat.intel.v1","producers":["threat-intel-service"],"consumers":[{"principal":"alert-service","groups":["alert-service-threat-intel-projection-v1"]}]},
    {"topic":"dlq.v1","producers":["ingest-gateway","alert-service","asset-service","rule-manager","audit-materializer","flink-session-job","flink-user-behavior-job"],"consumers":[{"principal":"alert-service","groups":["alert-service-dlq-governance-v1"]}]}
  ],
  "additional_topic_bindings": [
    {"topic":"detections.behavior.v1","state":"blocked","reason":"Legacy split stream has no authoritative producer/consumer contract."},
    {"topic":"detections.business.v1","state":"blocked","reason":"Legacy split stream has no authoritative producer/consumer contract."},
    {"topic":"campaigns.v1","state":"blocked","reason":"Legacy campaign stream has no authoritative payload contract."},
    {"topic":"l2.trigger.v1","state":"blocked","reason":"L2 trigger ownership and schema are not versioned."},
    {"topic":"dlq.feature-job","state":"blocked","reason":"Legacy Flink DLQ is pending canonical replay ownership."},
    {"topic":"dlq.rule-job","state":"blocked","reason":"Legacy Flink DLQ is pending canonical replay ownership."},
    {"topic":"dlq.cep-job","state":"blocked","reason":"Legacy Flink DLQ is pending canonical replay ownership."}
  ],
  "replay_policy": {
    "principal":"kafka-replayer",
    "enabled":false,
    "enablement":"Requires an approved, time-bounded change record and a separately generated ACL delta; the baseline generator emits no replay grant."
  }
}
