   "Write",
   "Describe"
  ],
  "consumer_topic_operations": [
   "Read",
   "Describe"
  ],
  "consumer_group_operations": [
   "Read",
   "Describe"
  ],
  "producer_cluster_operations": [
   "IdempotentWrite"
  ],
  "forbidden_operations": [
