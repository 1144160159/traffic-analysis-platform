{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traffic-platform:kafka-json-events:v1",
  "title": "Traffic platform Kafka JSON event contracts v1",
  "type": "object",
  "$defs": {
    "WhitelistLifecycleV2Json": {
      "type": "object",
      "required": ["event_id", "event_type", "schema_version", "tenant_id", "entry_id", "aggregate_version", "action_id", "reason", "trace_id", "desired_rule_state", "occurred_at", "entry"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {"enum": ["traffic.whitelist.v2.EntryDrafted", "traffic.whitelist.v2.ApprovalSubmitted", "traffic.whitelist.v2.EntryApproved", "traffic.whitelist.v2.EntryRejected", "traffic.whitelist.v2.EntryRevoked", "traffic.whitelist.v2.EntryArchived", "traffic.whitelist.v2.EntryExpired", "traffic.whitelist.v2.EntryExtended", "traffic.whitelist.v2.EntryAssigned", "traffic.whitelist.v2.EntryUpdated"]},
        "schema_version": {"const": 2},
        "tenant_id": {"type": "string", "minLength": 1},
        "entry_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "action_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "trace_id": {"type": "string", "minLength": 1},
        "desired_rule_state": {"enum": ["", "effective", "revoked"]},
        "occurred_at": {"type": "string", "format": "date-time"},
        "entry": {
          "type": "object",
          "required": ["id", "tenant_id", "type", "value", "reason", "description", "status", "approval_status", "version", "created_by", "created_at", "updated_at"],
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "tenant_id": {"type": "string", "minLength": 1},
            "type": {"enum": ["ip", "domain", "fingerprint", "subnet", "asset", "account", "rule", "model"]},
            "value": {"type": "string", "minLength": 1},
            "reason": {"type": "string"},
            "description": {"type": "string"},
            "status": {"enum": ["draft", "pending", "active", "disabled"]},
            "approval_status": {"enum": ["draft", "pending", "approved", "rejected"]},
            "source_alert_id": {"type": "string"},
            "feedback_id": {"type": "string"},
            "owner_role": {"type": "string"},
            "scope": {"type": "string"},
            "risk_level": {"enum": ["low", "medium", "high", "critical"]},
            "covered_alerts": {"type": "integer", "minimum": 0},
            "covered_assets": {"type": "integer", "minimum": 0},
            "version": {"type": "integer", "minimum": 1},
            "created_by": {"type": "string"},
            "approved_by": {"type": "string"},
            "approved_at": {"type": "string", "format": "date-time"},
            "disabled_at": {"type": "string", "format": "date-time"},
            "expires_at": {"type": "string", "format": "date-time"},
            "created_at": {"type": "string", "format": "date-time"},
            "updated_at": {"type": "string", "format": "date-time"},
            "archived_at": {"type": "string", "format": "date-time"},
            "last_action_id": {"type": "string"},
            "last_trace_id": {"type": "string"},
            "rule_effect_status": {"type": "string"},
            "rule_desired_state": {"type": "string"},
            "rule_revision": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "AlertFeedbackExtendedV1Json": {
      "type": "object",
      "required": [
        "event_id", "event_type", "schema_version", "aggregate_version",
        "alert_id", "tenant_id", "label", "user_id", "timestamp",
        "add_to_whitelist", "feedback_id"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {"const": "alert.feedback.v1"},
        "schema_version": {"const": 1},
        "aggregate_version": {"const": 1},
        "alert_id": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "label": {"enum": ["TP", "FP"]},
        "reason_code": {"type": "string"},
        "comment": {"type": "string"},
        "user_id": {"type": "string"},
        "timestamp": {"type": "integer"},
        "add_to_whitelist": {"type": "boolean"},
        "feedback_id": {"type": "string", "format": "uuid"},
        "alert_type": {"type": "string"},
        "severity": {"type": "string"},
        "labels": {"type": "array", "items": {"type": "string"}},
        "model_version": {"type": "string"},
        "rule_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AlertResponseRequestedV1Json": {
      "type": "object",
      "required": [
        "event_id", "event_type", "schema_version", "aggregate_version",
        "job_id", "tenant_id", "alert_id", "action_id", "action", "target",
        "reason", "requested_by", "trace_id", "dry_run"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {"const": "alert.response.requested.v1"},
        "schema_version": {"const": 1},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "job_id": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "alert_id": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
		"requested_by": {"type": "string", "minLength": 1},
		"approved_by": {"type": "string", "minLength": 1},
		"approval_reason": {"type": "string", "minLength": 1},
		"trace_id": {"type": "string", "minLength": 1},
        "dry_run": {"type": "boolean"}
      },
	  "allOf": [
		{
		  "if": {"properties": {"dry_run": {"const": false}}, "required": ["dry_run"]},
		  "then": {"required": ["approved_by", "approval_reason"]}
		}
	  ],
      "additionalProperties": false
    },
    "AlertBatchAssignmentLifecycleV1Json": {
      "type": "object",
      "required": [
        "event_id", "event_type", "schema_version", "aggregate_type",
        "aggregate_id", "aggregate_version", "partition_key", "tenant_id",
        "batch_id", "assignee", "requested_by", "reason", "status",
        "total_count", "trace_id", "occurred_at"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {"enum": ["alert.batch-assignment.requested.v1", "alert.assignment.changed.v1", "alert.batch-assignment.compensation-requested.v1", "alert.assignment.compensated.v1"]},
        "schema_version": {"const": 1},
        "aggregate_type": {"enum": ["alert_assignment_batch", "alert_assignment_compensation"]},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"enum": [1, 2]},
        "partition_key": {"type": "string", "minLength": 3},
        "tenant_id": {"type": "string", "minLength": 1},
        "batch_id": {"type": "string", "format": "uuid"},
        "request_id": {"type": "string", "format": "uuid"},
        "action_id": {"const": "alert-batch-assignment-compensate"},
        "expected_batch_revision": {"type": "integer", "minimum": 1},
        "selection_id": {"type": "string", "format": "uuid"},
        "selection_snapshot_id": {"type": "string", "minLength": 8, "maxLength": 256},
        "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "assignee": {"type": "string", "minLength": 1, "maxLength": 128},
        "requested_by": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 4, "maxLength": 1000},
        "status": {"enum": ["accepted", "running"]},
        "total_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "alert_id", "position", "expected_state_version", "resulting_state_version",
              "previous_assignee", "resulting_assignee", "previous_status", "resulting_status"
            ],
            "properties": {
              "alert_id": {"type": "string", "minLength": 1},
              "position": {"type": "integer", "minimum": 0, "maximum": 99},
              "expected_state_version": {"type": "integer", "minimum": 1},
              "resulting_state_version": {"type": "integer", "minimum": 2},
              "previous_assignee": {"type": "string"},
              "resulting_assignee": {"type": "string"},
              "previous_status": {"enum": ["new", "triage", "assigned", "closed"]},
              "resulting_status": {"enum": ["new", "triage", "assigned", "closed"]}
            },
            "additionalProperties": false
          }
        },
        "trace_id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"event_type": {"const": "alert.batch-assignment.requested.v1"}}, "required": ["event_type"]},
          "then": {
            "properties": {"aggregate_type": {"const": "alert_assignment_batch"}, "aggregate_version": {"const": 1}, "status": {"const": "accepted"}},
            "required": ["selection_id", "selection_snapshot_id", "selection_sha256"]
          }
        },
        {
          "if": {"properties": {"event_type": {"const": "alert.assignment.changed.v1"}}, "required": ["event_type"]},
          "then": {
            "properties": {"aggregate_type": {"const": "alert_assignment_batch"}, "aggregate_version": {"const": 2}, "status": {"const": "running"}},
            "required": ["items"]
          }
        },
        {
          "if": {"properties": {"event_type": {"const": "alert.batch-assignment.compensation-requested.v1"}}, "required": ["event_type"]},
          "then": {
            "properties": {"aggregate_type": {"const": "alert_assignment_compensation"}, "aggregate_version": {"const": 1}, "status": {"const": "accepted"}, "expected_batch_revision": {"const": 3}},
            "required": ["request_id", "action_id", "expected_batch_revision"]
          }
        },
        {
          "if": {"properties": {"event_type": {"const": "alert.assignment.compensated.v1"}}, "required": ["event_type"]},
          "then": {
            "properties": {"aggregate_type": {"const": "alert_assignment_compensation"}, "aggregate_version": {"const": 2}, "status": {"const": "running"}, "expected_batch_revision": {"const": 3}},
            "required": ["request_id", "action_id", "expected_batch_revision", "items"]
          }
        }
      ],
      "additionalProperties": false
    },
    "AlertSavedViewSavedV1Json": {
      "type": "object",
      "required": [
        "event_id", "event_type", "schema_version", "aggregate_type",
        "aggregate_id", "aggregate_version", "tenant_id", "view_id",
        "name", "filters", "changed_by", "trace_id"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {"const": "alert.saved-view.saved.v1"},
        "schema_version": {"const": 1},
        "aggregate_type": {"const": "alert_saved_view"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "view_id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1},
        "filters": {"type": "object"},
        "changed_by": {"type": "string"},
        "trace_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "NotificationRuleLifecycleV1Json": {
      "type": "object",
      "required": [
        "event_id", "event_type", "schema_version", "aggregate_type",
        "aggregate_id", "aggregate_version", "tenant_id",
        "action_id", "reason", "changed_by", "trace_id"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {"enum": [
          "traffic.notification.rule.v1.RuleCreated",
          "traffic.notification.rule.v1.RuleUpdated",
          "traffic.notification.template.v1.TemplateCreated",
          "traffic.notification.template.v1.TemplateUpdated",
          "traffic.notification.escalation.v1.PolicyCreated",
          "traffic.notification.escalation.v1.PolicyUpdated",
          "traffic.notification.silence.v1.SilenceCreated",
          "traffic.notification.silence.v1.SilenceUpdated",
          "traffic.notification.settings.v1.SettingsUpdated"
        ]},
        "schema_version": {"const": 1},
        "aggregate_type": {"enum": ["notification_rule", "notification_template", "notification_escalation_policy", "notification_silence_rule", "notification_settings"]},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "rule": {"type": "object"},
        "template": {"type": "object"},
        "escalation_policy": {"type": "object"},
        "silence_rule": {"type": "object"},
        "settings": {"type": "object"},
        "action_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "changed_by": {"type": "string"},
        "trace_id": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["rule"]},
        {"required": ["template"]},
        {"required": ["escalation_policy"]},
        {"required": ["silence_rule"]},
        {"required": ["settings"]}
      ],
      "additionalProperties": false
    },
    "TopicActionLifecycleV2Json": {
      "type": "object",
      "required": ["event_id", "event_type", "tenant_id", "topic", "job_id", "revision", "trace_id"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {
          "enum": ["traffic.topic.v2.ActionRequested", "traffic.topic.v2.ActionResult"]
        },
        "tenant_id": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "job_id": {"type": "string", "format": "uuid"},
        "action_id": {"type": "string"},
        "snapshot_id": {"type": ["string", "null"]},
        "revision": {"type": "integer", "minimum": 1},
        "trace_id": {"type": "string"},
        "status": {"type": "string"},
        "receipt": {"type": "object"},
        "error": {"type": "object"}
      },
      "additionalProperties": true
    },
    "DashboardTaskLifecycleV1Json": {
      "type": "object",
      "required": [
        "event_id", "event_type", "schema_version", "aggregate_type",
        "aggregate_id", "aggregate_version", "partition_key", "tenant_id",
        "task_id", "action_id", "status", "snapshot_id", "trace_id", "occurred_at"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {"enum": [
          "traffic.dashboard.v1.TaskRequested",
          "traffic.dashboard.v1.TaskResult",
          "traffic.dashboard.v1.TaskCompensationRequested",
          "traffic.dashboard.v1.TaskCompensationResult"
        ]},
        "schema_version": {"const": 1},
        "aggregate_type": {"const": "dashboard_task"},
        "aggregate_id": {"type": "string", "format": "uuid"},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "partition_key": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "format": "uuid"},
        "action_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["accepted", "running", "completed", "partial", "failed", "compensating", "compensated", "compensation_partial", "compensation_failed"]},
        "snapshot_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "provider_receipt_id": {"type": "string", "minLength": 1},
        "effect_state": {"enum": ["confirmed", "none", "unknown"]},
        "effect_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "result": {"type": "object"},
        "error_code": {"type": "string"},
        "error_message": {"type": "string"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trace_id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"event_type": {"const": "traffic.dashboard.v1.TaskResult"}}},
          "then": {"required": ["provider", "provider_receipt_id", "effect_state", "effect_ids", "result", "receipt_sha256"]}
        },
        {
          "if": {"properties": {"event_type": {"const": "traffic.dashboard.v1.TaskCompensationResult"}}},
          "then": {"required": ["provider", "provider_receipt_id", "effect_state", "effect_ids", "result", "receipt_sha256"]}
        },
        {
          "if": {"properties": {"status": {"enum": ["completed", "compensated"]}}},
          "then": {
            "properties": {
              "effect_state": {"const": "confirmed"},
              "effect_ids": {"minItems": 1}
            },
            "required": ["effect_state", "effect_ids"]
          }
        }
      ],
      "additionalProperties": false
    },
    "CampaignAggregateLifecycleV2Json": {
      "type": "object",
      "required": [
        "event_id", "event_type", "schema_version", "aggregate_type",
        "aggregate_id", "aggregate_version", "partition_key", "tenant_id",
        "trace_id"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {
          "enum": [
            "traffic.campaign.v2.OwnerAssigned",
            "traffic.campaign.v2.StatusChanged",
            "traffic.campaign.v2.ReportRequested",
            "traffic.campaign.v2.ReportCompleted",
            "traffic.campaign.v2.ReportFailed",
            "traffic.campaign.v2.SoarRequested",
            "traffic.campaign.v2.SoarCompleted",
            "traffic.campaign.v2.SoarPartial",
            "traffic.campaign.v2.SoarFailed",
            "traffic.campaign.v2.SoarCompensated",
            "traffic.campaign.v2.SoarCompensationFailed",
            "traffic.campaign.v2.AlertLinked",
            "traffic.campaign.v2.AlertUnlinked",
            "traffic.campaign.v2.Merged",
            "traffic.campaign.v2.MergeReceived",
            "traffic.campaign.v2.MembershipBackfilled"
          ]
        },
        "schema_version": {"const": 2},
        "aggregate_type": {"const": "campaign"},
        "aggregate_id": {"type": "string", "minLength": 1},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "partition_key": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "campaign_id": {"type": "string"},
        "alert_id": {"type": "string"},
        "relation_id": {"type": "string", "format": "uuid"},
        "relation_revision": {"type": "integer", "minimum": 1},
        "campaign_revision": {"type": "integer", "minimum": 1},
        "status": {"type": "string"},
        "assignee": {"type": "string"},
        "member_count": {"type": "integer", "minimum": 0},
        "job_id": {"type": "string"},
        "report_id": {"type": "string"},
        "report_campaign_revision": {"type": "integer", "minimum": 1},
        "snapshot_id": {"type": "string", "format": "uuid"},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "object_bucket": {"type": "string"},
        "object_key": {"type": "string"},
        "error": {"type": "string"},
        "action_id": {"type": "string"},
        "reason": {"type": "string"},
        "trace_id": {"type": "string", "minLength": 1},
        "report_snapshot": {"type": "object"},
        "merge_id": {"type": "string", "format": "uuid"},
        "source_campaign_id": {"type": "string"},
        "target_campaign_id": {"type": "string"},
        "source_campaign_revision": {"type": "integer", "minimum": 1},
        "target_campaign_revision": {"type": "integer", "minimum": 1},
        "source_member_count": {"type": "integer", "minimum": 0},
        "target_member_count_before": {"type": "integer", "minimum": 0},
        "target_member_count_after": {"type": "integer", "minimum": 0},
        "moved_count": {"type": "integer", "minimum": 0},
        "relinked_count": {"type": "integer", "minimum": 0},
        "deduplicated_count": {"type": "integer", "minimum": 0},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_id": {"type": "string", "format": "uuid"},
        "backfill_run_id": {"type": "string", "format": "uuid"},
        "source_snapshot_id": {"type": "string", "minLength": 1},
        "playbook_id": {"type": "string", "minLength": 1},
        "approval_status": {"enum": ["pending", "approved", "rejected", "cancelled"]},
        "executor_status": {"type": "string", "minLength": 1},
        "workflow_revision": {"type": "integer", "minimum": 1},
        "provider": {"type": "string", "minLength": 1},
        "provider_receipt_id": {"type": "string", "minLength": 1},
        "receipt_status": {"enum": ["succeeded", "partial", "failed"]},
        "receipt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "external_effect": {"type": "boolean"},
        "inserted_count": {"type": "integer", "minimum": 0},
        "bound_count": {"type": "integer", "minimum": 0},
        "unchanged_count": {"type": "integer", "minimum": 0},
        "skipped_unlinked_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "CampaignMembershipLifecycleV2Json": {
      "type": "object",
      "required": [
        "event_id", "event_type", "schema_version", "aggregate_type",
        "aggregate_id", "aggregate_version", "partition_key", "tenant_id",
        "campaign_id", "alert_id", "relation_id", "relation_revision",
        "campaign_revision", "trace_id"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {
          "enum": ["traffic.campaign.v2.AlertLinked", "traffic.campaign.v2.AlertUnlinked"]
        },
        "schema_version": {"const": 2},
        "aggregate_type": {"const": "campaign"},
        "aggregate_id": {"type": "string", "minLength": 1},
        "aggregate_version": {"type": "integer", "minimum": 1},
        "partition_key": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "campaign_id": {"type": "string", "minLength": 1},
        "alert_id": {"type": "string", "minLength": 1},
        "relation_id": {"type": "string", "format": "uuid"},
        "relation_revision": {"type": "integer", "minimum": 1},
        "campaign_revision": {"type": "integer", "minimum": 1},
        "status": {"type": "string"},
        "assignee": {"type": "string"},
        "member_count": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"},
        "trace_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "PlaybookExecutionLifecycleV2Json": {
      "type": "object",
      "required": [
        "event_id", "event_type", "schema_version", "aggregate_type",
        "aggregate_id", "aggregate_version", "partition_key", "tenant_id",
        "execution_id", "playbook_name", "trace_id", "status"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "event_type": {
          "enum": [
            "traffic.playbook.v2.ExecutionRequested",
            "traffic.playbook.v2.ExecutionApproved",
            "traffic.playbook.v2.ExecutionRejected",
            "traffic.playbook.v2.ExecutionCancelled",
