    "default_allowed_lateness_ms": 120000,
    "default_future_skew_ms": 300000
  },
  "barriers": {
    "checkpoint_mode": "EXACTLY_ONCE",
    "dlq": "canonical dlq.v1 JSON in the source checkpoint transaction",
