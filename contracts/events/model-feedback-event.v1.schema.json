{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis.local/contracts/events/model-feedback-event.v1.schema.json",
  "$defs": {
    "ModelFeedbackAdjudicatedV1Json": {
  "title": "Model feedback adjudication event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_version",
    "feedback_id",
    "tenant_id",
    "prediction_id",
    "alert_id",
    "label",
    "label_revision",
    "adjudication_state",
    "reason_code",
    "model_version",
    "rule_version",
    "adjudicated_by",
    "occurred_at_ms",
    "trace_id"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "model.feedback.v1"},
    "schema_version": {"const": 1},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "feedback_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "minLength": 1},
    "prediction_id": {"type": "string", "minLength": 1},
    "alert_id": {"type": "string", "minLength": 1},
    "label": {"enum": ["TP", "FP"]},
    "label_revision": {"type": "integer", "minimum": 1},
    "adjudication_state": {"enum": ["PROPOSED", "ADJUDICATED", "RETRACTED"]},
    "reason_code": {"type": "string"},
    "model_version": {"type": "string", "minLength": 1},
    "rule_version": {"type": "string", "minLength": 1},
    "adjudicated_by": {"type": "string", "minLength": 1},
    "previous_event_id": {"type": "string", "format": "uuid"},
    "occurred_at_ms": {"type": "integer", "minimum": 1},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"label_revision": {"const": 1}}},
      "then": {"not": {"required": ["previous_event_id"]}},
      "else": {"required": ["previous_event_id"]}
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"label": {"const": "FP"}}},
          {"properties": {"adjudication_state": {"const": "RETRACTED"}}}
        ]
      },
      "then": {"properties": {"reason_code": {"minLength": 1}}}
    }
  ]
    }
  }
}
