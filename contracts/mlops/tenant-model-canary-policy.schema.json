{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic.example/contracts/mlops/tenant-model-canary-policy.schema.json",
  "title": "TenantModelCanaryPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canary_id",
    "enabled",
    "tenant_id",
    "deployment_id",
    "rollback_deployment_id",
    "candidate_model_id",
    "candidate_version",
    "candidate_package_sha256",
    "candidate_aggregate_revision",
    "champion_version",
    "rollout_percentage",
    "minimum_samples",
    "maximum_samples",
    "observation_window_seconds",
    "maximum_clock_skew_seconds",
    "stop_thresholds",
    "shadow_evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "canary_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "enabled": {"type": "boolean", "default": false},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "deployment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "rollback_deployment_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "candidate_model_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "candidate_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "candidate_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_aggregate_revision": {"type": "integer", "minimum": 1},
    "champion_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "rollout_percentage": {"type": "integer", "minimum": 1, "maximum": 10},
    "minimum_samples": {"type": "integer", "minimum": 100, "maximum": 1000000},
    "maximum_samples": {"type": "integer", "minimum": 100, "maximum": 1000000},
    "observation_window_seconds": {"type": "integer", "minimum": 300, "maximum": 604800},
    "maximum_clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
    "stop_thresholds": {"$ref": "#/$defs/stopThresholds"},
    "shadow_evidence": {"$ref": "#/$defs/shadowEvidence"}
  },
  "$defs": {
    "stopThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_error_rate",
        "maximum_timeout_rate",
        "maximum_decision_change_rate",
        "maximum_label_change_rate",
        "maximum_absolute_score_delta_p95",
        "maximum_latency_ratio_p95",
        "maximum_challenger_heap_delta_bytes_p95",
        "maximum_consecutive_non_compared"
      ],
      "properties": {
        "maximum_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_timeout_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_decision_change_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_label_change_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_absolute_score_delta_p95": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_latency_ratio_p95": {"type": "number", "minimum": 1, "maximum": 100},
        "maximum_challenger_heap_delta_bytes_p95": {"type": "integer", "minimum": 0, "maximum": 1099511627776},
        "maximum_consecutive_non_compared": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "shadowEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "required_status", "minimum_samples", "minimum_window_seconds"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "required_status": {"const": "PASS"},
        "minimum_samples": {"type": "integer", "minimum": 100, "maximum": 1000000},
        "minimum_window_seconds": {"type": "integer", "minimum": 300, "maximum": 604800}
      }
    }
  }
}
