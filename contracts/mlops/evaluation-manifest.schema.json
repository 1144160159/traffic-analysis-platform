{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic.local/contracts/mlops/evaluation-manifest.schema.json",
  "title": "Traffic MLOps governed evaluation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "state",
    "dataset_id",
    "dataset_sha256",
    "training_run_id",
    "training_run_sha256",
    "graph_training_run",
    "model_artifact_sha256",
    "prediction_artifact_sha256",
    "method_contract_sha256",
    "evaluator_code_sha256",
    "evaluator_image_digest",
    "seed",
    "bootstrap_rounds",
    "thresholds",
    "populations",
    "metrics",
    "confidence_intervals",
    "calibration",
    "graph_ablations",
    "activation_authorized",
    "evaluation_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_id": {"type": "string", "format": "uuid"},
    "state": {"const": "evaluated"},
    "dataset_id": {"type": "string", "format": "uuid"},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "training_run_id": {"type": "string", "format": "uuid"},
    "training_run_sha256": {"$ref": "#/$defs/sha256"},
    "graph_training_run": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["run_id", "run_sha256", "graph_snapshot"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "run_sha256": {"$ref": "#/$defs/sha256"},
        "graph_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshot_id", "manifest_sha256"],
          "properties": {
            "snapshot_id": {"type": "string", "minLength": 1},
            "manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "model_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "prediction_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "method_contract_sha256": {"$ref": "#/$defs/sha256"},
    "evaluator_code_sha256": {"$ref": "#/$defs/sha256"},
    "evaluator_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "seed": {"type": "integer", "minimum": 0},
    "bootstrap_rounds": {"type": "integer", "minimum": 100, "maximum": 10000},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "abstain_confidence", "known_retention_target", "selected_from"],
      "properties": {
        "classification": {"type": "number", "minimum": 0, "maximum": 1},
        "abstain_confidence": {"type": "number", "minimum": 0.5, "maximum": 1},
        "known_retention_target": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "selected_from": {"const": "validation"}
      }
    },
    "populations": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "integer", "minimum": 1}},
    "metrics": {"type": "object", "minProperties": 8},
    "confidence_intervals": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"$ref": "#/$defs/confidenceInterval"}
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brier_score", "expected_calibration_error", "bins"],
      "properties": {
        "brier_score": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_calibration_error": {"type": "number", "minimum": 0, "maximum": 1},
        "bins": {"type": "integer", "minimum": 2, "maximum": 100}
      }
    },
    "graph_ablations": {
      "type": "object",
      "additionalProperties": true,
      "required": ["state", "required_variants", "missing_variants"]
    },
    "activation_authorized": {"const": false},
    "evaluation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "lower", "upper", "confidence"],
      "properties": {
        "point": {"type": "number"},
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "confidence": {"const": 0.95}
      }
    }
  }
}
