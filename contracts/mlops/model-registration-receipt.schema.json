{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic.local/contracts/mlops/model-registration-receipt.schema.json",
  "title": "Traffic governed model metadata registration receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "state", "tenant_id", "package_model_id",
    "registry_model_id", "model_version", "package_id", "package_sha256",
    "registration_request_sha256", "revision", "status",
    "activation_event_created", "activation_authorized"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "format": "uuid"},
    "state": {"const": "metadata_registered"},
    "tenant_id": {"type": "string", "minLength": 1},
    "package_model_id": {"type": "string", "minLength": 1},
    "registry_model_id": {"type": "string", "format": "uuid"},
    "model_version": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "format": "uuid"},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "registration_request_sha256": {"$ref": "#/$defs/sha256"},
    "revision": {"const": 1},
    "status": {"const": "registered"},
    "activation_event_created": {"const": false},
    "activation_authorized": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
