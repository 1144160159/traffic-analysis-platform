{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis.local/contracts/mlops/model-inference-parity-profile.schema.json",
  "title": "Internal model inference parity and G4 profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "claim_scope",
    "cnas_claim_authorized",
    "production_promotion_authorized",
    "feature_columns",
    "sample_count",
    "random_seed",
    "warmup_iterations",
    "measured_iterations",
    "flink_parallelism",
    "decision_threshold",
    "score_tolerances",
    "performance_budgets"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "claim_scope": {"const": "INTERNAL_ENGINEERING_ONLY"},
    "cnas_claim_authorized": {"const": false},
    "production_promotion_authorized": {"const": false},
    "feature_columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "enum": [
          "pps",
          "bps",
          "up_down_ratio",
          "pktlen_mean",
          "pktlen_std",
          "iat_mean_ms",
          "iat_std_ms",
          "active_mean_ms",
          "idle_mean_ms",
          "duration_ms",
          "tcp_flag_syn_cnt",
          "tcp_flag_ack_cnt",
          "tcp_init_win_bytes_fwd",
          "tcp_init_win_bytes_bwd",
          "protocol"
        ]
      }
    },
    "sample_count": {"type": "integer", "minimum": 32, "maximum": 4096},
    "random_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "warmup_iterations": {"type": "integer", "minimum": 1, "maximum": 100},
    "measured_iterations": {"type": "integer", "minimum": 3, "maximum": 1000},
    "flink_parallelism": {"type": "integer", "minimum": 1, "maximum": 16},
    "decision_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "score_tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_to_onnx", "onnx_to_flink", "python_to_flink", "max_decision_mismatches"],
      "properties": {
        "python_to_onnx": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.001},
        "onnx_to_flink": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.001},
        "python_to_flink": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.001},
        "max_decision_mismatches": {"const": 0}
      }
    },
    "performance_budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "onnx", "flink"],
      "properties": {
        "python": {"$ref": "#/$defs/runtimeBudget"},
        "onnx": {"$ref": "#/$defs/runtimeBudget"},
        "flink": {"$ref": "#/$defs/runtimeBudget"}
      }
    }
  },
  "$defs": {
    "runtimeBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_p99_inference_latency_ms", "min_throughput_per_second", "max_peak_rss_bytes"],
      "properties": {
        "max_p99_inference_latency_ms": {"type": "number", "exclusiveMinimum": 0},
        "min_throughput_per_second": {"type": "number", "exclusiveMinimum": 0},
        "max_peak_rss_bytes": {"type": "integer", "minimum": 1048576}
      }
    }
  }
}
