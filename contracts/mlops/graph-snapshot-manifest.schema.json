{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic.local/contracts/mlops/graph-snapshot-manifest.schema.json",
  "title": "Traffic MLOps graph snapshot manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "tenant_id",
    "as_of",
    "source_watermarks",
    "node_schema",
    "edge_schema",
    "node_schema_sha256",
    "edge_schema_sha256",
    "node_count",
    "edge_count",
    "nodes_sha256",
    "edges_sha256",
    "source_evidence_sha256",
    "artifacts",
    "graph_snapshot_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1, "not": {"pattern": "^(?i:unknown)$"}},
    "as_of": {"type": "string", "format": "date-time"},
    "source_watermarks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "format": "date-time"}
    },
    "node_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_column", "event_id_column", "feature_columns"],
      "properties": {
        "id_column": {"const": "node_id"},
        "event_id_column": {"const": "event_id"},
        "feature_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "edge_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id_column", "source_column", "target_column", "observed_at_column", "source_kind_column", "evidence_id_column"],
      "properties": {
        "id_column": {"const": "edge_id"},
        "source_column": {"const": "source_node_id"},
        "target_column": {"const": "target_node_id"},
        "observed_at_column": {"const": "observed_at"},
        "source_kind_column": {"const": "source_kind"},
        "evidence_id_column": {"const": "evidence_id"}
      }
    },
    "node_schema_sha256": {"$ref": "#/$defs/sha256"},
    "edge_schema_sha256": {"$ref": "#/$defs/sha256"},
    "node_count": {"type": "integer", "minimum": 0},
    "edge_count": {"type": "integer", "minimum": 0},
    "nodes_sha256": {"$ref": "#/$defs/sha256"},
    "edges_sha256": {"$ref": "#/$defs/sha256"},
    "source_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"$ref": "#/$defs/sha256"},
        "edges": {"$ref": "#/$defs/sha256"}
      }
    },
    "graph_snapshot_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
