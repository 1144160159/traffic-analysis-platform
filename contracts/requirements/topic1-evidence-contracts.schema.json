{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic-analysis-platform.local/contracts/requirements/topic1-evidence-contracts.schema.json",
  "title": "Signed evidence input and output contracts for Topic One requirements",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "subject_requirements_sha256", "approval_intake", "contracts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["DRAFT_PENDING_SIGNATURE", "SIGNED"]},
    "subject_requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_intake": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["receipt_path", "receipt_sha256"],
          "properties": {
            "receipt_path": {"type": "string", "minLength": 1},
            "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "contracts": {"type": "array", "minItems": 17, "maxItems": 17, "items": {"$ref": "#/$defs/contract"}, "uniqueItems": true}
  },
  "$defs": {
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "required_gates", "required_inputs", "required_outputs", "failure_semantics"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^REQ-T1-[A-Z0-9-]+$"},
        "required_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^G[0-8]$"}, "uniqueItems": true},
        "required_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}, "uniqueItems": true},
        "required_outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}, "uniqueItems": true},
        "failure_semantics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "schema_ref", "semantic_role"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "schema_ref": {"type": "string", "minLength": 1},
        "semantic_role": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "SIGNED"}}}, "then": {"properties": {"approval_intake": {"type": "object"}}}, "else": {"properties": {"approval_intake": {"type": "null"}}}}
  ]
}
