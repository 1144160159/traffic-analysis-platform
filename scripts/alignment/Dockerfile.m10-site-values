FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp

RUN pip install --no-cache-dir PyYAML==6.0.3
WORKDIR /opt/site-values
COPY scripts/alignment/validate_m10_site_values.py ./validate_m10_site_values.py

USER 65532:65532
ENTRYPOINT ["python3", "/opt/site-values/validate_m10_site_values.py"]
