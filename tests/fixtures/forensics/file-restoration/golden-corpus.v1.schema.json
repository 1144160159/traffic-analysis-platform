{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traffic.local/schemas/m03-file-restoration-golden.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "contract_id", "claim_boundary", "limits", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "corpus_id": {"const": "m03-file-restoration-golden-v1"},
    "contract_id": {"const": "traffic.file-restoration.v1"},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "string", "minLength": 1},
        "forbidden": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_stream_bytes", "max_object_bytes", "max_part_count", "max_mime_depth", "max_expansion_ratio"],
      "properties": {
        "max_stream_bytes": {"type": "integer", "minimum": 1},
        "max_object_bytes": {"type": "integer", "minimum": 1},
        "max_part_count": {"type": "integer", "minimum": 1},
        "max_mime_depth": {"type": "integer", "minimum": 1},
        "max_expansion_ratio": {"type": "number", "minimum": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "stage", "categories", "input", "expected"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "stage": {"enum": ["reassembly", "extractor"]},
          "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
          "input": {"type": "object"},
          "expected": {"type": "object"}
        }
      }
    }
  }
}
